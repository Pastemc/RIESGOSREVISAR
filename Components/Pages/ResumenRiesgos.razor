@page "/resumen-riesgos"
@layout MainLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject RiesgoService RiesgoSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ExcelService ExcelSvc
@inject NavigationManager Nav

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-chart-bar mr-2"></i>Resumen de Riesgos</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/matriz">Registro de Matriz</a></li>
                    <li class="breadcrumb-item active">Resumen de Riesgos</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-12">
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/matriz")'>
                <i class="fas fa-arrow-left mr-2"></i>Volver a Registro de Matriz
            </button>
        </div>
    </div>

    @if (Cargando)
    {
        <div class="text-center p-5">
            <i class="fas fa-spinner fa-spin fa-3x text-danger"></i>
            <p class="mt-2">Cargando datos...</p>
        </div>
    }
    else
    {
        <!-- TOTALES -->
        <div class="row mb-3">
            <div class="col-md-2">
                <div class="small-box bg-danger shadow-sm" style="cursor:pointer;"
                     @onclick='() => SeleccionarFiltroNivel("Extremo")'>
                    <div class="inner">
                        <h3>@TotalExtremo</h3>
                        <p class="font-weight-bold mb-0">Extremo @(NivelFiltro=="Extremo"?"✓":"")</p>
                    </div>
                    <div class="icon"><i class="fas fa-exclamation-circle"></i></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="small-box shadow-sm" style="background:#fd7e14;cursor:pointer;"
                     @onclick='() => SeleccionarFiltroNivel("Alto")'>
                    <div class="inner text-white">
                        <h3>@TotalAlto</h3>
                        <p class="font-weight-bold mb-0">Alto @(NivelFiltro=="Alto"?"✓":"")</p>
                    </div>
                    <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="small-box bg-warning shadow-sm" style="cursor:pointer;"
                     @onclick='() => SeleccionarFiltroNivel("Moderado")'>
                    <div class="inner">
                        <h3>@TotalModerado</h3>
                        <p class="font-weight-bold mb-0">Moderado @(NivelFiltro=="Moderado"?"✓":"")</p>
                    </div>
                    <div class="icon"><i class="fas fa-minus-circle"></i></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="small-box bg-success shadow-sm" style="cursor:pointer;"
                     @onclick='() => SeleccionarFiltroNivel("Bajo")'>
                    <div class="inner">
                        <h3>@TotalBajo</h3>
                        <p class="font-weight-bold mb-0">Bajo @(NivelFiltro=="Bajo"?"✓":"")</p>
                    </div>
                    <div class="icon"><i class="fas fa-check-circle"></i></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="small-box bg-primary shadow-sm" style="cursor:pointer;"
                     @onclick='() => SeleccionarFiltroNivel("Todos")'>
                    <div class="inner">
                        <h3>@TotalRiesgos</h3>
                        <p class="font-weight-bold mb-0">Total @(NivelFiltro=="Todos"?"✓":"")</p>
                    </div>
                    <div class="icon"><i class="fas fa-list"></i></div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="small-box bg-info shadow-sm">
                    <div class="inner">
                        <h3>@TotalIndicadores</h3>
                        <p class="font-weight-bold mb-0">Total Indicadores</p>
                    </div>
                    <div class="icon"><i class="fas fa-tachometer-alt"></i></div>
                </div>
            </div>
        </div>

        <!-- TABLA -->
        <div class="card card-outline card-primary">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h3 class="card-title text-white font-weight-bold mb-0">
                    <i class="fas fa-table mr-2"></i>
                    Nivel de Criticidad de Riesgo Residual — @FechaCorte
                    @if (NivelFiltro != "Todos")
                    {
                        <span class="badge badge-warning ml-2">
                            <i class="fas fa-filter mr-1"></i>Filtrando: @NivelFiltro (@FilasVisibles.Count procesos)
                        </span>
                    }
                </h3>
                <div>
                    @if (NivelFiltro != "Todos")
                    {
                        <button class="btn btn-sm btn-outline-light mr-2 font-weight-bold"
                                @onclick='() => SeleccionarFiltroNivel("Todos")'>
                            <i class="fas fa-undo mr-1"></i>Mostrar Todos
                        </button>
                    }
                    <button class="btn btn-warning btn-sm font-weight-bold" @onclick="DescargarExcelResumen">
                        <i class="fas fa-file-excel mr-1"></i>Descargar Excel
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-bordered table-hover table-sm" style="font-size:.85rem;">
                    <thead>
                        <tr>
                            <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;min-width:180px;">Macro Proceso</th>
                            <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;min-width:250px;">Proceso</th>
                            <th colspan="4" style="background:#FFDD00;color:#002D58;text-align:center;">
                                Nivel de Criticidad de Riesgo Residual al @FechaCorte
                            </th>
                            <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;">Total</th>
                            <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;">Total Indicadores</th>
                        </tr>
                        <tr>
                            <th style="background:#dc3545;color:white;text-align:center;">Extremo</th>
                            <th style="background:#fd7e14;color:white;text-align:center;">Alto</th>
                            <th style="background:#ffc107;color:#000;text-align:center;">Moderado</th>
                            <th style="background:#28a745;color:white;text-align:center;">Bajo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!MacroProcesosFiltrados.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <em>No hay procesos con riesgo nivel <strong>@NivelFiltro</strong>.</em>
                                </td>
                            </tr>
                        }
                        @foreach (var macro in MacroProcesosFiltrados)
                        {
                            var filas = FilasPorMacroFiltradas[macro];
                            bool primero = true;
                            @foreach (var fila in filas)
                            {
                                <tr>
                                    @if (primero)
                                    {
                                        <td rowspan="@filas.Count"
                                            style="vertical-align:middle;font-weight:bold;background:#fffde7;border-right:2px solid #FFDD00;">
                                            @macro
                                        </td>
                                        primero = false;
                                    }
                                    <td>@fila.NombreProceso</td>
                                    <td class="text-center font-weight-bold"
                                        style="@(fila.Extremo>0?"background:#ffcdd2;":"")">@fila.Extremo</td>
                                    <td class="text-center font-weight-bold"
                                        style="@(fila.Alto>0?"background:#ffe0b2;":"")">@fila.Alto</td>
                                    <td class="text-center"
                                        style="@(fila.Moderado>0?"background:#fff9c4;":"")">@fila.Moderado</td>
                                    <td class="text-center"
                                        style="@(fila.Bajo>0?"background:#c8e6c9;":"")">@fila.Bajo</td>
                                    <td class="text-center font-weight-bold">
                                        @(fila.Extremo+fila.Alto+fila.Moderado+fila.Bajo)
                                    </td>
                                    <td class="text-center"
                                        style="@(fila.Indicadores>0?"background:#e3f2fd;":"")">@fila.Indicadores</td>
                                </tr>
                            }
                        }
                        <!-- FILA TOTAL -->
                        <tr style="background:#343a40;color:white;font-weight:bold;">
                            <td colspan="2" class="text-center">Total Riesgos</td>
                            <td class="text-center">@TotalExtremo</td>
                            <td class="text-center">@TotalAlto</td>
                            <td class="text-center">@TotalModerado</td>
                            <td class="text-center">@TotalBajo</td>
                            <td class="text-center">@TotalRiesgos</td>
                            <td class="text-center">@TotalIndicadores</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? Nivel { get; set; }

    bool   Cargando    = true;
    string FechaCorte  = DateTime.Now.ToString("dd/MM/yyyy");
    string NivelFiltro = "Todos";

    // ── Totales calculados desde FilasTodas (sin duplicados) ────────────
    int TotalExtremo    => FilasTodas.Sum(f => f.Extremo);
    int TotalAlto       => FilasTodas.Sum(f => f.Alto);
    int TotalModerado   => FilasTodas.Sum(f => f.Moderado);
    int TotalBajo       => FilasTodas.Sum(f => f.Bajo);
    int TotalRiesgos    => TotalExtremo + TotalAlto + TotalModerado + TotalBajo;
    int TotalIndicadores => FilasTodas.Sum(f => f.Indicadores);

    List<FilaResumen> FilasTodas = new();

    List<FilaResumen> FilasVisibles => NivelFiltro switch
    {
        "Extremo"  => FilasTodas.Where(f => f.Extremo  > 0).ToList(),
        "Alto"     => FilasTodas.Where(f => f.Alto     > 0).ToList(),
        "Moderado" => FilasTodas.Where(f => f.Moderado > 0).ToList(),
        "Bajo"     => FilasTodas.Where(f => f.Bajo     > 0).ToList(),
        _          => FilasTodas
    };

    List<string> MacroProcesosFiltrados
    {
        get
        {
            var list = new List<string>();
            foreach (var f in FilasVisibles)
                if (!list.Contains(f.MacroProceso))
                    list.Add(f.MacroProceso);
            return list;
        }
    }

    Dictionary<string, List<FilaResumen>> FilasPorMacroFiltradas
    {
        get
        {
            var dict = new Dictionary<string, List<FilaResumen>>();
            foreach (var f in FilasVisibles)
            {
                if (!dict.ContainsKey(f.MacroProceso))
                    dict[f.MacroProceso] = new List<FilaResumen>();
                dict[f.MacroProceso].Add(f);
            }
            return dict;
        }
    }

    // Mapa CodigoProceso → MacroProceso
    static readonly Dictionary<string, string> MapaMacro = new()
    {
        {"E1.1","E1. Gestión de la Excelencia Operacional"},
        {"E1.2","E1. Gestión de la Excelencia Operacional"},
        {"E2.1","E2. Gobernanza"},{"E2.2","E2. Gobernanza"},
        {"E2.3","E2. Gobernanza"},{"E2.4","E2. Gobernanza"},
        {"E3.1","E3. Planeamiento"},{"E3.2","E3. Planeamiento"},{"E3.3","E3. Planeamiento"},
        {"E4.1","E4. Regulación"},{"E4.2","E4. Regulación"},
        {"E5.1","E5. Imagen Institucional"},{"E5.2","E5. Imagen Institucional"},
        {"O1.1","O1. Comercialización de Energía Eléctrica"},
        {"O1.2","O1. Comercialización de Energía Eléctrica"},
        {"O1.3","O1. Comercialización de Energía Eléctrica"},
        {"O2.1","O2. Gestión de Operación y Mantenimiento del Sistema Eléctrico"},
        {"O2.2","O2. Gestión de Operación y Mantenimiento del Sistema Eléctrico"},
        {"O3.1","O3. Gestión de la Calidad"},{"O3.2","O3. Gestión de la Calidad"},
        {"O4.1","O4. Gestión de Proyectos"},{"O4.2","O4. Gestión de Proyectos"},
        {"S1.1","S1. Soporte Legal"},{"S1.2","S1. Soporte Legal"},{"S1.3","S1. Soporte Legal"},
        {"S2.1","S2. Gestión Financiera y Contable"},
        {"S2.2","S2. Gestión Financiera y Contable"},
        {"S2.3","S2. Gestión Financiera y Contable"},
        {"S3.1","S3. TIC"},{"S3.2","S3. TIC"},
        {"S4.1","S4. Gestión de Logística"},{"S4.2","S4. Gestión de Logística"},
        {"S5.1","S5. Gestión Humana"},{"S5.2","S5. Gestión Humana"},
        {"S5.3","S5. Gestión Humana"},{"S5.4","S5. Gestión Humana"},
        {"S6.1","S6. Gestión Documental"},{"S6.2","S6. Gestión Documental"}
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Nivel))
            NivelFiltro = Nivel;

        await CargarResumen();
        Cargando = false;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Nivel))
            NivelFiltro = Nivel;
    }

    async Task CargarResumen()
    {
        FilasTodas.Clear();

        var state   = await AuthState.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst("UserId")?.Value;
        var userId  = int.TryParse(idClaim, out var id) ? id : 0;
        var rol     = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Personal";

        // ── PASO 1: Obtener todos los riesgos únicos de la BD ───────────
        // GetResumenRiesgosAsync devuelve riesgos agrupados por CodigoRiesgo
        // (sin duplicados por controles múltiples), filtrados por usuario/rol.
        var resumenData = await RiesgoSvc.GetResumenRiesgosAsync(userId, rol);

        // ── PASO 2: Construir FilasTodas agrupando por CodigoProceso ────
        // Cada entrada en resumenData es (CodigoProceso, NombreProceso, NivelResidual, CantIndicadores)
        // Un CodigoProceso puede tener múltiples riesgos → los agrupamos en una sola fila.
        var agrupado = resumenData
            .GroupBy(x => x.CodigoProceso)
            .OrderBy(g => g.Key);

        foreach (var grupo in agrupado)
        {
            var cod    = grupo.Key;
            var macro  = MapaMacro.TryGetValue(cod, out var mp) ? mp : cod;
            var nombre = grupo.First().NombreProceso;

            int ext = 0, alt = 0, mod = 0, baj = 0, ind = 0;
            foreach (var item in grupo)
            {
                // Cada item representa UN riesgo único (ya sin duplicados por controles)
                switch (item.NivelResidual)
                {
                    case "Extremo":  ext++; break;
                    case "Alto":     alt++; break;
                    case "Moderado": mod++; break;
                    case "Bajo":     baj++; break;
                    // Niveles inválidos o vacíos se ignoran (no se cuentan)
                }
                ind += item.CantIndicadores;
            }

            // Solo agregar procesos que tengan al menos 1 riesgo válido
            if (ext + alt + mod + baj > 0)
            {
                FilasTodas.Add(new FilaResumen
                {
                    MacroProceso  = macro,
                    CodigoProceso = cod,
                    NombreProceso = $"{cod} {nombre}",
                    Extremo       = ext,
                    Alto          = alt,
                    Moderado      = mod,
                    Bajo          = baj,
                    Indicadores   = ind
                });
            }
        }
    }

    void SeleccionarFiltroNivel(string nivel)
    {
        NivelFiltro = nivel;
        StateHasChanged();
    }

    async Task DescargarExcelResumen()
    {
        var bytes = ExcelSvc.GenerarExcelResumen(FilasVisibles, FechaCorte);
        var b64   = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", b64,
            $"Resumen_Riesgos_{NivelFiltro}_{DateTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
