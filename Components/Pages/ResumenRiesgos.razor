@page "/resumen-riesgos"
@layout MainLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject RiesgoService RiesgoSvc
@inject SnapshotService SnapSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ExcelService ExcelSvc
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory

@using MPeriodo = RiesgosElor.Models.PeriodoRiesgo

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-chart-bar mr-2"></i>Resumen de Riesgos</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="/matriz">Registro de Matriz</a></li>
                    <li class="breadcrumb-item active">Resumen de Riesgos</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<style>
    .periodo-bar { background:#003B70; border-bottom:3px solid #FFDD00; padding:8px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; border-radius:6px; margin-bottom:1rem; }
    .periodo-bar label { color:#FFDD00; font-weight:700; font-size:.85rem; margin:0; white-space:nowrap; }
    .badge-periodo-activo  { background:#28a745; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
    .badge-periodo-cerrado { background:#6c757d; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
    .badge-periodo-sin     { background:#dc3545; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
</style>

<div class="container-fluid">

    <div class="periodo-bar">
        <i class="fas fa-calendar-alt" style="color:#FFDD00;font-size:1.1rem;"></i>
        <label>Periodo:</label>
        @if (!Periodos.Any())
        {
            <span class="badge-periodo-sin">Sin periodos registrados</span>
        }
        else
        {
            <select class="form-control form-control-sm" style="max-width:360px;" @onchange="OnPeriodoChange">
                <option value="">— Sin periodo seleccionado —</option>
                @foreach (var p in Periodos)
                {
                    <option value="@p.Id" selected="@(p.Id == PeriodoSelId)">
                        @p.NombrePeriodo (@p.FechaInicio.ToString("dd/MM/yy") — @p.FechaCierre.ToString("dd/MM/yy"))
                    </option>
                }
            </select>
        }
        @if (PeriodoSel != null)
        {
            @if (PeriodoSel?.Estado == "Activo")
            {
                <span class="badge-periodo-activo"><i class="fas fa-circle mr-1" style="font-size:.5rem;vertical-align:middle;"></i>ACTIVO</span>
            }
            else
            {
                <span class="badge-periodo-cerrado"><i class="fas fa-lock mr-1"></i>CERRADO</span>
            }
        }
        else
        {
            <span class="badge" style="background:#856404;color:#fff;font-size:.75rem;padding:4px 10px;border-radius:20px;">
                <i class="fas fa-database mr-1"></i>Vista carga base
            </span>
        }
    </div>

    @* Banner informativo sin periodo *@
    @if (PeriodoSel == null)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3">
            <i class="fas fa-info-circle fa-lg mr-3 text-warning"></i>
            <div>
                <strong>Mostrando resumen de la carga base (solo lectura).</strong>
                Selecciona un periodo para ver el resumen de ese periodo específico.
            </div>
        </div>
    }
    else if (Cargando)
    {
        <div class="text-center p-4">
            <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
            <p class="mt-3 text-muted">Cargando resumen del periodo <strong>@(PeriodoSel?.NombrePeriodo ?? "...")</strong>...</p>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/matriz")'>
                <i class="fas fa-arrow-left mr-2"></i>Volver a Registro de Matriz
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <div class="small-box bg-danger shadow-sm" style="cursor:pointer;" @onclick='() => SeleccionarFiltroNivel("Extremo")'>
                <div class="inner"><h3>@TotalExtremo</h3><p class="font-weight-bold mb-0">Extremo @(NivelFiltro=="Extremo"?"✓":"")</p></div>
                <div class="icon"><i class="fas fa-exclamation-circle"></i></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="small-box shadow-sm" style="background:#fd7e14;cursor:pointer;" @onclick='() => SeleccionarFiltroNivel("Alto")'>
                <div class="inner text-white"><h3>@TotalAlto</h3><p class="font-weight-bold mb-0">Alto @(NivelFiltro=="Alto"?"✓":"")</p></div>
                <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="small-box bg-warning shadow-sm" style="cursor:pointer;" @onclick='() => SeleccionarFiltroNivel("Moderado")'>
                <div class="inner"><h3>@TotalModerado</h3><p class="font-weight-bold mb-0">Moderado @(NivelFiltro=="Moderado"?"✓":"")</p></div>
                <div class="icon"><i class="fas fa-minus-circle"></i></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="small-box bg-success shadow-sm" style="cursor:pointer;" @onclick='() => SeleccionarFiltroNivel("Bajo")'>
                <div class="inner"><h3>@TotalBajo</h3><p class="font-weight-bold mb-0">Bajo @(NivelFiltro=="Bajo"?"✓":"")</p></div>
                <div class="icon"><i class="fas fa-check-circle"></i></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="small-box bg-primary shadow-sm" style="cursor:pointer;" @onclick='() => SeleccionarFiltroNivel("Todos")'>
                <div class="inner"><h3>@TotalRiesgos</h3><p class="font-weight-bold mb-0">Total @(NivelFiltro=="Todos"?"✓":"")</p></div>
                <div class="icon"><i class="fas fa-list"></i></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="small-box bg-info shadow-sm">
                <div class="inner"><h3>@TotalIndicadores</h3><p class="font-weight-bold mb-0">Total Indicadores</p></div>
                <div class="icon"><i class="fas fa-tachometer-alt"></i></div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-primary">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#0062B8;border-bottom:2px solid #FFDD00;">
            <h3 class="card-title text-white font-weight-bold mb-0">
                <i class="fas fa-table mr-2"></i>
                Nivel de Criticidad de Riesgo Residual — @FechaCorte
                @if (PeriodoSel == null)
                {
                    <span class="badge badge-warning ml-2"><i class="fas fa-database mr-1"></i>Carga base</span>
                }
                @if (NivelFiltro != "Todos")
                {
                    <span class="badge badge-warning ml-2">
                        <i class="fas fa-filter mr-1"></i>Filtrando: @NivelFiltro (@FilasVisibles.Count procesos)
                    </span>
                }
            </h3>
            <div>
                @if (NivelFiltro != "Todos")
                {
                    <button class="btn btn-sm btn-outline-light mr-2 font-weight-bold"
                            @onclick='() => SeleccionarFiltroNivel("Todos")'>
                        <i class="fas fa-undo mr-1"></i>Mostrar Todos
                    </button>
                }
                <button class="btn btn-warning btn-sm font-weight-bold"
                        @onclick="DescargarExcelResumen"
                        disabled="@(!FilasTodas.Any())">
                    <i class="fas fa-file-excel mr-1"></i>Descargar Excel
                </button>
            </div>
        </div>
        <div class="card-body table-responsive p-0">
            <table class="table table-bordered table-hover table-sm" style="font-size:.85rem;">
                <thead>
                    <tr>
                        <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;min-width:180px;">Macro Proceso</th>
                        <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;min-width:250px;">Proceso</th>
                        <th colspan="4" style="background:#FFDD00;color:#002D58;text-align:center;">
                            Nivel de Criticidad de Riesgo Residual al @FechaCorte
                        </th>
                        <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;">Total</th>
                        <th rowspan="2" style="background:#FFDD00;color:#002D58;vertical-align:middle;text-align:center;">Total Indicadores</th>
                    </tr>
                    <tr>
                        <th style="background:#dc3545;color:white;text-align:center;">Extremo</th>
                        <th style="background:#fd7e14;color:white;text-align:center;">Alto</th>
                        <th style="background:#ffc107;color:#000;text-align:center;">Moderado</th>
                        <th style="background:#28a745;color:white;text-align:center;">Bajo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!MacroProcesosFiltrados.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x mb-2 d-block" style="opacity:.25;"></i>
                                @(NivelFiltro == "Todos" ? "No hay riesgos registrados." : $"No hay procesos con riesgo nivel {NivelFiltro}.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var macro in MacroProcesosFiltrados)
                        {
                            var filas = FilasPorMacroFiltradas[macro];
                            bool primero = true;
                            @foreach (var fila in filas)
                            {
                                <tr>
                                    @if (primero)
                                    {
                                        <td rowspan="@filas.Count"
                                            style="vertical-align:middle;font-weight:bold;background:#fffde7;border-right:2px solid #FFDD00;">
                                            @macro
                                        </td>
                                        primero = false;
                                    }
                                    <td>@fila.NombreProceso</td>
                                    <td class="text-center font-weight-bold" style="@(fila.Extremo>0?"background:#ffcdd2;":"")">@fila.Extremo</td>
                                    <td class="text-center font-weight-bold" style="@(fila.Alto>0?"background:#ffe0b2;":"")">@fila.Alto</td>
                                    <td class="text-center" style="@(fila.Moderado>0?"background:#fff9c4;":"")">@fila.Moderado</td>
                                    <td class="text-center" style="@(fila.Bajo>0?"background:#c8e6c9;":"")">@fila.Bajo</td>
                                    <td class="text-center font-weight-bold">@(fila.Extremo+fila.Alto+fila.Moderado+fila.Bajo)</td>
                                    <td class="text-center" style="@(fila.Indicadores>0?"background:#e3f2fd;":"")">@fila.Indicadores</td>
                                </tr>
                            }
                        }
                        <tr style="background:#343a40;color:white;font-weight:bold;">
                            <td colspan="2" class="text-center">Total Riesgos</td>
                            <td class="text-center">@TotalExtremo</td>
                            <td class="text-center">@TotalAlto</td>
                            <td class="text-center">@TotalModerado</td>
                            <td class="text-center">@TotalBajo</td>
                            <td class="text-center">@TotalRiesgos</td>
                            <td class="text-center">@TotalIndicadores</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    [SupplyParameterFromQuery] public string? Nivel { get; set; }

    List<MPeriodo> Periodos     = new();
    MPeriodo?      PeriodoSel   = null;
    int            PeriodoSelId = 0;

    bool   Cargando    = false;
    string FechaCorte  = DateTime.Now.ToString("dd/MM/yyyy");
    string NivelFiltro = "Todos";

    int TotalExtremo     => FilasTodas.Sum(f => f.Extremo);
    int TotalAlto        => FilasTodas.Sum(f => f.Alto);
    int TotalModerado    => FilasTodas.Sum(f => f.Moderado);
    int TotalBajo        => FilasTodas.Sum(f => f.Bajo);
    int TotalRiesgos     => TotalExtremo + TotalAlto + TotalModerado + TotalBajo;
    int TotalIndicadores => FilasTodas.Sum(f => f.Indicadores);

    List<FilaResumen> FilasTodas = new();

    List<FilaResumen> FilasVisibles => NivelFiltro switch
    {
        "Extremo"  => FilasTodas.Where(f => f.Extremo  > 0).ToList(),
        "Alto"     => FilasTodas.Where(f => f.Alto     > 0).ToList(),
        "Moderado" => FilasTodas.Where(f => f.Moderado > 0).ToList(),
        "Bajo"     => FilasTodas.Where(f => f.Bajo     > 0).ToList(),
        _          => FilasTodas
    };

    List<string> MacroProcesosFiltrados
    {
        get
        {
            var list = new List<string>();
            foreach (var f in FilasVisibles)
                if (!list.Contains(f.MacroProceso))
                    list.Add(f.MacroProceso);
            return list;
        }
    }

    Dictionary<string, List<FilaResumen>> FilasPorMacroFiltradas
    {
        get
        {
            var dict = new Dictionary<string, List<FilaResumen>>();
            foreach (var f in FilasVisibles)
            {
                if (!dict.ContainsKey(f.MacroProceso))
                    dict[f.MacroProceso] = new List<FilaResumen>();
                dict[f.MacroProceso].Add(f);
            }
            return dict;
        }
    }

    static readonly Dictionary<string, string> MapaMacro = new()
    {
        {"E1.1","E1. Gestión de la Excelencia Operacional"},
        {"E1.2","E1. Gestión de la Excelencia Operacional"},
        {"E2.1","E2. Gobernanza"},{"E2.2","E2. Gobernanza"},
        {"E2.3","E2. Gobernanza"},{"E2.4","E2. Gobernanza"},
        {"E3.1","E3. Planeamiento"},{"E3.2","E3. Planeamiento"},{"E3.3","E3. Planeamiento"},
        {"E4.1","E4. Regulación"},{"E4.2","E4. Regulación"},
        {"E5.1","E5. Imagen Institucional"},{"E5.2","E5. Imagen Institucional"},
        {"O1.1","O1. Comercialización de Energía Eléctrica"},
        {"O1.2","O1. Comercialización de Energía Eléctrica"},
        {"O1.3","O1. Comercialización de Energía Eléctrica"},
        {"O2.1","O2. Gestión de Operación y Mantenimiento del Sistema Eléctrico"},
        {"O2.2","O2. Gestión de Operación y Mantenimiento del Sistema Eléctrico"},
        {"O3.1","O3. Gestión de la Calidad"},{"O3.2","O3. Gestión de la Calidad"},
        {"O4.1","O4. Gestión de Proyectos"},{"O4.2","O4. Gestión de Proyectos"},
        {"S1.1","S1. Soporte Legal"},{"S1.2","S1. Soporte Legal"},{"S1.3","S1. Soporte Legal"},
        {"S2.1","S2. Gestión Financiera y Contable"},
        {"S2.2","S2. Gestión Financiera y Contable"},
        {"S2.3","S2. Gestión Financiera y Contable"},
        {"S3.1","S3. TIC"},{"S3.2","S3. TIC"},
        {"S4.1","S4. Gestión de Logística"},{"S4.2","S4. Gestión de Logística"},
        {"S5.1","S5. Gestión Humana"},{"S5.2","S5. Gestión Humana"},
        {"S5.3","S5. Gestión Humana"},{"S5.4","S5. Gestión Humana"},
        {"S6.1","S6. Gestión Documental"},{"S6.2","S6. Gestión Documental"}
    };

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Nivel))
            NivelFiltro = Nivel;

        Periodos = await SnapSvc.GetPeriodosOrdenadosAsync();

        // Cargar resumen de carga base automáticamente
        await CargarResumenBase();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Nivel))
            NivelFiltro = Nivel;
    }

    // ── Carga resumen desde tabla Riesgos base ──────────────────────────
    async Task CargarResumenBase()
    {
        var riesgos = await RiesgoSvc.GetTodosAsync();
        FilasTodas  = new();

        var porProceso = riesgos
            .GroupBy(r => r.CodigoProceso?.Trim() ?? "")
            .Where(g => !string.IsNullOrWhiteSpace(g.Key));

        foreach (var grp in porProceso.OrderBy(g => g.Key))
        {
            var cod    = grp.Key;
            var nombre = grp.First().NombreProceso ?? cod;
            var macro  = MapaMacro.TryGetValue(cod, out var mp) ? mp : cod;

            int ext = 0, alt = 0, mod = 0, baj = 0, ind = 0;
            foreach (var r in grp)
            {
                var sev   = r.ProbabilidadResidual * r.ImpactoResidual;
                var nivel = Riesgo.GetNivel(sev);
                switch (nivel)
                {
                    case "Extremo":  ext++; break;
                    case "Alto":     alt++; break;
                    case "Moderado": mod++; break;
                    case "Bajo":     baj++; break;
                }
                ind += r.Indicadores?.Count(i => !string.IsNullOrWhiteSpace(i.CodigoKRI)) ?? 0;
            }

            if (ext + alt + mod + baj > 0)
                FilasTodas.Add(new FilaResumen
                {
                    MacroProceso  = macro,
                    CodigoProceso = cod,
                    NombreProceso = $"{cod} {nombre}",
                    Extremo       = ext,
                    Alto          = alt,
                    Moderado      = mod,
                    Bajo          = baj,
                    Indicadores   = ind
                });
        }
    }

    async Task OnPeriodoChange(ChangeEventArgs e)
    {
        FilasTodas  = new();
        NivelFiltro = "Todos";

        if (!int.TryParse(e.Value?.ToString(), out var pid) || pid == 0)
        {
            PeriodoSel   = null;
            PeriodoSelId = 0;
            // Volver a mostrar resumen de carga base
            await CargarResumenBase();
            return;
        }

        PeriodoSelId = pid;
        PeriodoSel   = Periodos.FirstOrDefault(p => p.Id == pid);
        await CargarResumen(pid);
    }

    async Task CargarResumen(int periodoId)
    {
        Cargando   = true;
        FilasTodas = new();
        FechaCorte = DateTime.Now.ToString("dd/MM/yyyy");
        StateHasChanged();

        using var db = DbFactory.CreateDbContext();
        var snapshots = await db.SnapshotMatriz
            .Include(sm => sm.Riesgos)
                .ThenInclude(sr => sr.Indicadores)
            .Include(sm => sm.MatrizGrupo)
            .Where(sm => sm.PeriodoId == periodoId)
            .ToListAsync();

        var riesgosPorProceso = new Dictionary<string, (string NombreProceso, List<SnapshotRiesgo> Riesgos)>();

        foreach (var sm in snapshots)
        {
            var cod    = sm.MatrizGrupo?.CodigoProceso ?? "";
            var nombre = sm.MatrizGrupo?.NombreProceso ?? "";
            if (string.IsNullOrWhiteSpace(cod)) continue;

            if (!riesgosPorProceso.ContainsKey(cod))
                riesgosPorProceso[cod] = (nombre, new List<SnapshotRiesgo>());

            riesgosPorProceso[cod].Riesgos.AddRange(sm.Riesgos.ToList());
        }

        foreach (var (cod, (nombre, riesgos)) in riesgosPorProceso.OrderBy(kv => kv.Key))
        {
            var macro = MapaMacro.TryGetValue(cod, out var mp) ? mp : cod;

            var riesgosUnicos = riesgos
                .GroupBy(r => r.CodigoRiesgo)
                .Select(g => g.First())
                .ToList();

            int ext = 0, alt = 0, mod = 0, baj = 0, ind = 0;
            foreach (var r in riesgosUnicos)
            {
                var sev   = r.ProbabilidadResidual * r.ImpactoResidual;
                var nivel = Riesgo.GetNivel(sev);
                switch (nivel)
                {
                    case "Extremo":  ext++; break;
                    case "Alto":     alt++; break;
                    case "Moderado": mod++; break;
                    case "Bajo":     baj++; break;
                }
                ind += riesgos
                    .Where(r2 => r2.CodigoRiesgo == r.CodigoRiesgo)
                    .SelectMany(r2 => r2.Indicadores)
                    .Count(i => !string.IsNullOrWhiteSpace(i.CodigoKRI));
            }

            if (ext + alt + mod + baj > 0)
                FilasTodas.Add(new FilaResumen
                {
                    MacroProceso  = macro,
                    CodigoProceso = cod,
                    NombreProceso = $"{cod} {nombre}",
                    Extremo       = ext,
                    Alto          = alt,
                    Moderado      = mod,
                    Bajo          = baj,
                    Indicadores   = ind
                });
        }

        Cargando = false;
    }

    void SeleccionarFiltroNivel(string nivel) { NivelFiltro = nivel; StateHasChanged(); }

    async Task DescargarExcelResumen()
    {
        var filasExcel = FilasVisibles.Select(f => new RiesgosElor.Services.FilaResumen
        {
            MacroProceso  = f.MacroProceso,
            CodigoProceso = f.CodigoProceso,
            NombreProceso = f.NombreProceso,
            Extremo       = f.Extremo,
            Alto          = f.Alto,
            Moderado      = f.Moderado,
            Bajo          = f.Bajo,
            Indicadores   = f.Indicadores
        }).ToList();

        var bytes  = ExcelSvc.GenerarExcelResumen(filasExcel, FechaCorte);
        var b64    = Convert.ToBase64String(bytes);
        var nombre = $"Resumen_Riesgos_{NivelFiltro}_{PeriodoSel?.NombrePeriodo?.Replace(" ","_") ?? "CargaBase"}_{DateTime.Now:yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", b64, nombre,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    class FilaResumen
    {
        public string MacroProceso  { get; set; } = "";
        public string CodigoProceso { get; set; } = "";
        public string NombreProceso { get; set; } = "";
        public int    Extremo       { get; set; }
        public int    Alto          { get; set; }
        public int    Moderado      { get; set; }
        public int    Bajo          { get; set; }
        public int    Indicadores   { get; set; }
    }
}
