                                                    </div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Inicio</strong></label><input type="date" class="form-control" value="@(plan.InicioPlan?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => plan.InicioPlan = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : (DateTime?)null" /></div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Fin</strong></label><input type="date" class="form-control" value="@(plan.FinPlan?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => plan.FinPlan = DateTime.TryParse(e.Value?.ToString(), out var d2) ? d2 : (DateTime?)null" /></div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Fecha Prevista</strong></label><input type="date" class="form-control" value="@(plan.FechaPrevista?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => plan.FechaPrevista = DateTime.TryParse(e.Value?.ToString(), out var d3) ? d3 : (DateTime?)null" /></div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>¿Eficaz?</strong></label>
                                                        <select class="form-control" @onchange="e => plan.PlanEficaz = e.Value?.ToString() ?? string.Empty">
                                                            <option value="">-- Selecciona --</option>
                                                            <option value="Sí"           selected="@(plan.PlanEficaz=="Sí")">Sí</option>
                                                            <option value="No"           selected="@(plan.PlanEficaz=="No")">No</option>
                                                            <option value="Parcialmente" selected="@(plan.PlanEficaz=="Parcialmente")">Parcialmente</option>
                                                        </select>
                                                    </div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Fecha Verificación</strong></label><input type="date" class="form-control" value="@(plan.FechaVerificacion?.ToString("yyyy-MM-dd") ?? "")" @onchange="e => plan.FechaVerificacion = DateTime.TryParse(e.Value?.ToString(), out var d4) ? d4 : (DateTime?)null" /></div></div>
                                                    <div class="col-md-5"><div class="form-group"><label><strong>Verificado por</strong></label><input class="form-control" value="@plan.VerificadoPor" @oninput="e => plan.VerificadoPor = e.Value?.ToString() ?? string.Empty" /></div></div>
                                                    <div class="col-md-4"><div class="form-group"><label><strong>Evidencia del Plan</strong></label><textarea class="form-control" rows="2" @oninput="e => plan.EvidenciaPlan = e.Value?.ToString() ?? string.Empty">@plan.EvidenciaPlan</textarea></div></div>
                                                    <div class="col-md-8"><div class="form-group"><label><strong>Observaciones</strong></label><textarea class="form-control" rows="2" @oninput="e => plan.ObservacionesPlan = e.Value?.ToString() ?? string.Empty">@plan.ObservacionesPlan</textarea></div></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-secondary" @onclick="() => TabActivo=4"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                @if (PuedeVerPlanIndicadores) { <button class="btn btn-primary" @onclick="() => TabActivo=6">Continuar <i class="fas fa-arrow-right ml-1"></i></button> }
                            </div>
                        </div>
                    }

                    @if (TabActivo == 6)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#0d6efd;"><h5 class="mb-0">INDICADORES (KRI)</h5></div>
                            <div class="card-body">
                                @if (!PuedeVerPlanIndicadores) { <div class="alert alert-info">Indicadores no aplican para nivel <strong>@NivRes</strong>.</div> }
                                else
                                {
                                    <div class="mb-3"><button class="btn btn-success" @onclick="AgregarIndicador"><i class="fas fa-plus mr-1"></i> Agregar KRI</button></div>
                                    @for (int ii=0; ii<Indicadores.Count; ii++)
                                    {
                                        var iidx=ii; var ind=Indicadores[iidx];
                                        <div class="card mb-3" style="border:1px solid #0d6efd;">
                                            <div class="card-header d-flex justify-content-between align-items-center" style="background:#cfe2ff;">
                                                <strong style="color:#0d6efd;">KRI #@(iidx+1) — @ind.CodigoKRI</strong>
                                                <button class="btn btn-sm btn-danger" @onclick="() => Indicadores.RemoveAt(iidx)"><i class="fas fa-trash"></i></button>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-6"><div class="form-group"><label><strong>Definición del KRI</strong></label><textarea class="form-control" rows="2" @oninput="e => ind.DefinicionKRI = e.Value?.ToString() ?? string.Empty">@ind.DefinicionKRI</textarea></div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Frecuencia</strong></label>
                                                        <select class="form-control" @onchange="e => ind.Frecuencia = e.Value?.ToString() ?? string.Empty">
                                                            @foreach (var op in OpcionesParametro("FrecuenciaControl")) { <option value="@op" selected="@(ind.Frecuencia==op)">@op</option> }
                                                        </select>
                                                    </div></div>
                                                    <div class="col-md-3"><div class="form-group"><label><strong>Meta KRI</strong></label><input class="form-control" value="@ind.MetaKRI" @oninput="e => ind.MetaKRI = e.Value?.ToString() ?? string.Empty" /></div></div>
                                                    <div class="col-md-4"><div class="form-group"><label><strong>KRI Actual</strong></label><input class="form-control" value="@ind.KRIActual" @oninput="e => ind.KRIActual = e.Value?.ToString() ?? string.Empty" /></div></div>
                                                    <div class="col-md-4"><div class="form-group"><label><strong>Responsable</strong></label><input class="form-control" value="@ind.ResponsableKRI" @oninput="e => ind.ResponsableKRI = e.Value?.ToString() ?? string.Empty" /></div></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-secondary" @onclick="() => TabActivo=5"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                <button class="btn btn-success btn-lg" @onclick="GuardarTodoSnapshot"><i class="fas fa-check-circle mr-1"></i> FINALIZAR Y GUARDAR</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    List<MatrizGrupo>       Matrices           = new();
    List<MPeriodo>          Periodos           = new();
    List<MaestroArea>       AreasMaestras      = new();
    List<MaestroProceso>    ProcesosMaestros   = new();
    List<MaestroParametro>  ParametrosMaestros = new();
    Dictionary<int,int>     ConteoSnap         = new();

    MatrizGrupo?    MatrizActual   = null;
    SnapshotMatriz? SnapshotActual = null;
    MPeriodo?       PeriodoSel     = null;
    int             PeriodoSelId   = 0;

    bool   MostrarFormulario = false;
    bool   MostrarHeatmap    = false;
    int    TabActivo         = 1;
    bool   GuardarOk         = false;
    string MsgGuardar        = string.Empty;
    int    UsuarioId         = 0;
    string UsuarioActual     = "Sistema";

    SnapshotRiesgo           RiesgoSnap  = new();
    List<SnapshotControl>    Controles   = new();
    List<SnapshotPlanAccion> Planes      = new();
    List<SnapshotIndicador>  Indicadores = new();

    int    SevInh   => RiesgoSnap.ProbabilidadInherente * RiesgoSnap.ImpactoInherente;
    string NivInh   => Riesgo.GetNivel(SevInh);
    string ColorInh => RiesgoService.GetColorNivel(NivInh);
    int    SevRes   => RiesgoSnap.ProbabilidadResidual  * RiesgoSnap.ImpactoResidual;
    string NivRes   => Riesgo.GetNivel(SevRes);
    string ColorRes => RiesgoService.GetColorNivel(NivRes);
    bool   PuedeVerPlanIndicadores => NivRes == "Alto" || NivRes == "Extremo";

    // ── Modo Validacion: solo lectura, sin edicion ─────────────────────
    bool EsModoValidacion  => PeriodoSel?.TipoPeriodo == "Validación" || PeriodoSel?.TipoPeriodo == "Validacion";
    bool EsModoSoloLectura => EsModoValidacion || PeriodoSel?.TipoPeriodo == "Evidencia" || PeriodoSel?.Estado == "Cerrado" || PeriodoSel == null;

    IEnumerable<MaestroArea> AreasActivas => AreasMaestras
        .Where(a => a.Activo).OrderBy(a => a.Categoria).ThenBy(a => a.Orden).ThenBy(a => a.Nombre);

    IEnumerable<MaestroProceso> SubprocesosDisponibles => ProcesosMaestros
        .Where(p => p.Activo && p.Nivel == "Subproceso"
            && (MatrizActual == null || p.Codigo.StartsWith(MatrizActual.CodigoProceso + ".", StringComparison.OrdinalIgnoreCase)))
        .OrderBy(p => p.Orden).ThenBy(p => p.Codigo);

    List<MPeriodo> PeriodosUnicos => Periodos
        .GroupBy(p => p.NombrePeriodo)
        .Select(g => g.OrderByDescending(x => x.NumeroPeriodo).First())
        .OrderByDescending(p => p.AnioRef).ThenByDescending(p => p.NumeroPeriodo)
        .ToList();

    List<MPeriodo> VersionesDelPeriodo => PeriodoSel == null
        ? new()
        : Periodos.Where(p => p.NombrePeriodo == PeriodoSel.NombrePeriodo).OrderBy(p => p.Version).ToList();

    async Task OnVersionChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var pid) || pid == 0) return;
        MatrizActual = null; SnapshotActual = null; MostrarFormulario = false; MostrarHeatmap = false;
        PeriodoSelId = pid;
        PeriodoSel   = Periodos.FirstOrDefault(p => p.Id == pid);
        // Validacion: conteo desde el Apertura referenciado
        if (EsModoValidacion && PeriodoSel?.PeriodoAperturaRefId != null)
            ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(PeriodoSel.PeriodoAperturaRefId.Value);
        else
            ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(pid);
    }

    string TipoChipClass(string tipo) => tipo switch { "Validación" => "tipo-chip-validacion", "Evidencia" => "tipo-chip-evidencia", _ => "tipo-chip-apertura" };
    string TipoIcono(string tipo)     => tipo switch { "Validación" => "fa-check-double",      "Evidencia" => "fa-file-signature",  _ => "fa-unlock" };

    protected override async Task OnInitializedAsync()
    {
        var state   = await AuthState.GetAuthenticationStateAsync();
        var idClaim = state.User.FindFirst("UserId")?.Value;
        UsuarioId     = int.TryParse(idClaim, out var id) ? id : 0;
        UsuarioActual = state.User.Identity?.Name ?? "Sistema";
        var rol = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Personal";

        Matrices = await RiesgoSvc.GetMatricesPorUsuarioAsync(UsuarioId, rol);
        Periodos = await SnapSvc.GetPeriodosOrdenadosAsync();
        await CargarMaestros();

        // Auto-seleccionar el periodo activo (cualquier tipo)
        var activo = Periodos.FirstOrDefault(p => p.Estado == "Activo");
        if (activo != null)
        {
            PeriodoSel   = activo;
            PeriodoSelId = activo.Id;
            // Validacion usa conteo del Apertura referenciado
            if ((activo.TipoPeriodo == "Validación" || activo.TipoPeriodo == "Validacion") && activo.PeriodoAperturaRefId.HasValue)
                ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(activo.PeriodoAperturaRefId.Value);
            else
                ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(activo.Id);
        }
        else
        {
            ConteoSnap = await SnapSvc.GetConteoBaseAsync();
        }
    }

    async Task CargarMaestros()
    {
        AreasMaestras      = await RiesgoSvc.GetMaestroAreasAsync(true);
        ProcesosMaestros   = await RiesgoSvc.GetMaestroProcesosAsync(true);
        ParametrosMaestros = await RiesgoSvc.GetMaestroParametrosAsync(soloActivos: true);
    }

    async Task OnPeriodoChange(ChangeEventArgs e)
    {
        MatrizActual = null; SnapshotActual = null; MostrarFormulario = false; MostrarHeatmap = false;
        if (!int.TryParse(e.Value?.ToString(), out var pid) || pid == 0)
        {
            PeriodoSel = null; PeriodoSelId = 0;
            ConteoSnap = await SnapSvc.GetConteoBaseAsync();
            return;
        }
        var seleccionado = Periodos.FirstOrDefault(p => p.Id == pid);
        if (seleccionado != null)
        {
            var mejor = Periodos.Where(p => p.NombrePeriodo == seleccionado.NombrePeriodo)
                .OrderByDescending(p => p.Estado == "Activo" ? 1 : 0)
                .ThenByDescending(p => p.Version).FirstOrDefault() ?? seleccionado;
            PeriodoSelId = mejor.Id; PeriodoSel = mejor;
        }
        else { PeriodoSelId = pid; PeriodoSel = seleccionado; }

        if (EsModoValidacion && PeriodoSel?.PeriodoAperturaRefId.HasValue == true)
            ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(PeriodoSel.PeriodoAperturaRefId.Value);
        else
            ConteoSnap = await SnapSvc.GetConteoSnapshotAsync(PeriodoSelId);
    }

    bool TieneMacro(string p) => Matrices.Any(m => !string.IsNullOrWhiteSpace(m.CodigoProceso) && m.CodigoProceso.TrimStart().StartsWith(p, StringComparison.OrdinalIgnoreCase));
    bool TieneGrupo(string g) => Matrices.Any(m => !string.IsNullOrWhiteSpace(m.CodigoProceso) && (m.CodigoProceso.StartsWith(g + ".", StringComparison.OrdinalIgnoreCase) || m.CodigoProceso.Equals(g, StringComparison.OrdinalIgnoreCase)));

    RenderFragment RenderSubs(string grupo) => builder =>
    {
        var subs = Matrices
            .Where(m => m.CodigoProceso.StartsWith(grupo + ".", StringComparison.OrdinalIgnoreCase) || m.CodigoProceso.Equals(grupo, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.CodigoProceso).ToList();
        int sq = 10;
        foreach (var m in subs)
        {
            ConteoSnap.TryGetValue(m.Id, out var cnt);
            string nom = (m.NombreProceso ?? m.Nombre ?? "");
            if (nom.Length > 32) nom = nom[..32] + "...";
            builder.OpenElement(sq++, "button"); builder.AddAttribute(sq++, "class", "sub-btn");
            builder.AddAttribute(sq++, "title", m.NombreProceso ?? m.Nombre ?? "");
            builder.AddAttribute(sq++, "onclick", EventCallback.Factory.Create(this, () => AbrirMatriz(m)));
            builder.OpenElement(sq++, "span"); builder.AddAttribute(sq++, "class", "scod"); builder.AddContent(sq++, m.CodigoProceso); builder.CloseElement();
            builder.OpenElement(sq++, "span"); builder.AddAttribute(sq++, "class", "snom"); builder.AddContent(sq++, nom); builder.CloseElement();
            builder.OpenElement(sq++, "span"); builder.AddAttribute(sq++, "class", cnt > 0 ? "sbadge con" : "sbadge sin"); builder.AddContent(sq++, cnt > 0 ? $"{cnt} riesgo{(cnt==1?"":"s")}" : "Sin riesgos"); builder.CloseElement();
            builder.CloseElement();
        }
    };

    async Task AbrirMatriz(MatrizGrupo m)
    {
        MatrizActual = m; MostrarFormulario = false; MostrarHeatmap = false;
        if (PeriodoSel != null)
        {
            // VALIDACION: leer snapshot del Apertura referenciado (no tiene snapshot propio)
            if (EsModoValidacion && PeriodoSel.PeriodoAperturaRefId.HasValue)
                SnapshotActual = await SnapSvc.GetSnapshotMatrizAsync(PeriodoSel.PeriodoAperturaRefId.Value, m.Id);
            else
                SnapshotActual = await SnapSvc.GetSnapshotMatrizAsync(PeriodoSel.Id, m.Id);
        }
        else
        {
            var riesgosBase = await RiesgoSvc.GetRiesgosPorMatrizAsync(m.Id);
            SnapshotActual = new SnapshotMatriz
            {
                MatrizGrupoId = m.Id, Estado = "SoloLectura",
                Riesgos = riesgosBase.Select(r => new SnapshotRiesgo
                {
                    Id = r.Id, RiesgoOrigenId = r.Id, SnapshotMatrizId = 0,
                    CodigoProceso = r.CodigoProceso ?? "", NombreProceso = r.NombreProceso ?? "",
                    GerenciaResponsable = r.GerenciaResponsable ?? "", Subproceso = r.Subproceso ?? "",
                    CodigoRiesgo = r.CodigoRiesgo ?? "", DescripcionRiesgo = r.DescripcionRiesgo ?? "",
                    OrigenRiesgo = r.OrigenRiesgo ?? "", FrecuenciaRiesgo = r.FrecuenciaRiesgo ?? "",
                    TipoRiesgo = r.TipoRiesgo ?? "",
                    ProbabilidadInherente = r.ProbabilidadInherente, ImpactoInherente = r.ImpactoInherente,
                    ProbabilidadResidual  = r.ProbabilidadResidual,  ImpactoResidual  = r.ImpactoResidual,
                    EstrategiaResidual = r.EstrategiaResidual ?? "",
                    Controles = r.Controles.Select(c => new SnapshotControl
                    {
                        CodigoControl = c.CodigoControl ?? "", DescripcionControl = c.DescripcionControl ?? "",
                        AreaResponsable = c.AreaResponsable ?? "", ResponsablesControl = c.ResponsablesControl ?? "",
                        FrecuenciaControl = c.FrecuenciaControl ?? "", OportunidadControl = c.OportunidadControl ?? "",
                        AutomatizacionControl = c.AutomatizacionControl ?? "", EvidenciaControl = c.EvidenciaControl ?? ""
                    }).ToList(),
                    Planes = r.PlanesAccion.Select(p => new SnapshotPlanAccion
                    {
                        CodigoPlan = p.CodigoPlan ?? "", DescripcionPlan = p.DescripcionPlan ?? "",
                        AreaResponsable = p.AreaResponsable ?? "", ResponsablePlan = p.ResponsablePlan ?? "",
                        InicioPlan = p.InicioPlan, EstadoPlan = p.EstadoPlan ?? "", FinPlan = p.FinPlan,
                        FechaPrevista = p.FechaPrevista, PlanEficaz = p.PlanEficaz ?? "",
                        FechaVerificacion = p.FechaVerificacion, VerificadoPor = p.VerificadoPor ?? "",
                        EvidenciaPlan = p.EvidenciaPlan ?? "", ObservacionesPlan = p.ObservacionesPlan ?? ""
                    }).ToList(),
                    Indicadores = r.Indicadores.Select(i => new SnapshotIndicador
                    {
                        CodigoKRI = i.CodigoKRI ?? "", DefinicionKRI = i.DefinicionKRI ?? "",
                        Frecuencia = i.Frecuencia ?? "", MetaKRI = i.MetaKRI ?? "",
                        KRIActual = i.KRIActual ?? "", ResponsableKRI = i.ResponsableKRI ?? ""
                    }).ToList()
                }).ToList()
            };
        }
    }

    void VolverALista() { MatrizActual = null; SnapshotActual = null; MostrarFormulario = false; MostrarHeatmap = false; }
    void MostrarMapasCalor() { MostrarHeatmap = true; MostrarFormulario = false; }

    async Task NuevoRiesgo()
    {
        if (MatrizActual == null || PeriodoSel == null) return;
        RiesgoSnap = await SnapSvc.NuevoSnapshotRiesgoAsync(PeriodoSel.Id, MatrizActual.Id, MatrizActual, UsuarioActual);
        Controles = new(); Planes = new(); Indicadores = new();
        TabActivo = 1; MsgGuardar = string.Empty; MostrarFormulario = true;
    }

    void EditarSnapshotRiesgo(SnapshotRiesgo r)
    {
        RiesgoSnap = r; Controles = r.Controles.ToList(); Planes = r.Planes.ToList(); Indicadores = r.Indicadores.ToList();
        TabActivo = 1; MsgGuardar = string.Empty; MostrarFormulario = true;
    }

    async Task EliminarSnapshotRiesgo(int id)
    {
        await SnapSvc.EliminarSnapshotRiesgoAsync(id);
        if (MatrizActual != null && PeriodoSel != null)
            SnapshotActual = await SnapSvc.GetSnapshotMatrizAsync(PeriodoSel.Id, MatrizActual.Id);
    }

    void Cancelar() { MostrarFormulario = false; MsgGuardar = string.Empty; }

    void AgregarControl()
    {
        var n = Controles.Count + 1;
        Controles.Add(new SnapshotControl { CodigoControl = $"{RiesgoSnap.CodigoProceso}.C{n:D2}" });
    }

    void AgregarPlan()
    {
        var n = Planes.Count + 1;
        Planes.Add(new SnapshotPlanAccion { CodigoPlan = $"{RiesgoSnap.CodigoRiesgo}.PA{n:D2}", EstrategiaRespuesta = RiesgoSnap.EstrategiaResidual });
    }

    void AgregarIndicador()
    {
        var n = Indicadores.Count + 1;
        Indicadores.Add(new SnapshotIndicador { CodigoKRI = $"{RiesgoSnap.CodigoRiesgo}.KRI{n:D2}" });
    }

    async Task GuardarTodoSnapshot()
    {
        foreach (var p in Planes) p.EstrategiaRespuesta = RiesgoSnap.EstrategiaResidual;
        await SnapSvc.GuardarSnapshotRiesgoAsync(RiesgoSnap, Controles, Planes, Indicadores, UsuarioActual);
        MsgGuardar = "Registro guardado correctamente en el periodo activo."; GuardarOk = true;
        if (MatrizActual != null && PeriodoSel != null)
        {
            SnapshotActual = await SnapSvc.GetSnapshotMatrizAsync(PeriodoSel.Id, MatrizActual.Id);
            ConteoSnap     = await SnapSvc.GetConteoSnapshotAsync(PeriodoSel.Id);
        }
        await Task.Delay(1200);
        MostrarFormulario = false;
    }

    void OnProbInhChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) RiesgoSnap.ProbabilidadInherente=v; StateHasChanged(); }
    void OnImpInhChange (ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) RiesgoSnap.ImpactoInherente=v;     StateHasChanged(); }
    void OnProbResChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) RiesgoSnap.ProbabilidadResidual=v;  StateHasChanged(); }
    void OnImpResChange (ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) RiesgoSnap.ImpactoResidual=v;       StateHasChanged(); }

    void IrTab6() { if (PuedeVerPlanIndicadores) TabActivo = 6; }

    IEnumerable<string> OpcionesParametro(string grupo)
    {
        var ops = ParametrosMaestros.Where(p => p.Grupo == grupo && p.Activo)
            .OrderBy(p => p.Orden).ThenBy(p => p.Valor).Select(p => p.Valor).Distinct().ToList();
        if (ops.Any()) return ops;
        return grupo switch
        {
            "OrigenRiesgo"          => new[]{"Interno","Externo","Ambos"},
            "FrecuenciaRiesgo"      => new[]{"No Recurrente","Recurrente"},
            "TipoRiesgo"            => new[]{"Estratégicos","Operacionales","Tecnologías de la información","Reporte","Cumplimiento"},
            "FrecuenciaControl"     => new[]{"Diaria","Semanal","Mensual","Trimestral","Semestral","Anual","Cada vez que suceda"},
            "OportunidadControl"    => new[]{"Correctivo","Preventivo","Detectivo"},
            "AutomatizacionControl" => new[]{"Manual","Semiautomático","Automático"},
            "EstadoPlan"            => new[]{"Concluido","En proceso","No iniciado"},
            "EstrategiaTratamiento" => new[]{"Evitar","Reducir o mitigar","Transferir","Retener o Aceptar","Eliminar"},
            _ => Array.Empty<string>()
        };
    }

    RenderFragment RenderHeatmapSnapshot(bool esI) => builder =>
    {
        if (SnapshotActual == null) return;
        int size = 380; int margin = 45; double cs = (size - margin) / 4.0;
        builder.OpenElement(0, "svg"); builder.AddAttribute(1, "width", size + 40); builder.AddAttribute(2, "height", size + 60); builder.AddAttribute(3, "style", "font-family:Arial;font-size:11px;");
        string[,] col = { {"#28a745","#ffc107","#ffc107","#fd7e14"}, {"#28a745","#ffc107","#fd7e14","#dc3545"}, {"#ffc107","#fd7e14","#dc3545","#dc3545"}, {"#fd7e14","#dc3545","#dc3545","#dc3545"} };
        int sq = 10;
        for (int row=0;row<4;row++) for (int c2=0;c2<4;c2++)
        {
            double x=margin+c2*cs; double y=margin+(3-row)*cs;
            builder.OpenElement(sq++,"rect"); builder.AddAttribute(sq++,"x",x.ToString("F0")); builder.AddAttribute(sq++,"y",y.ToString("F0"));
            builder.AddAttribute(sq++,"width",cs.ToString("F0")); builder.AddAttribute(sq++,"height",cs.ToString("F0"));
            builder.AddAttribute(sq++,"fill",col[row,c2]); builder.AddAttribute(sq++,"stroke","white"); builder.AddAttribute(sq++,"stroke-width","2"); builder.CloseElement();
        }
        foreach (var r in SnapshotActual.Riesgos)
        {
            int prob = esI ? r.ProbabilidadInherente : r.ProbabilidadResidual;
            int imp  = esI ? r.ImpactoInherente      : r.ImpactoResidual;
            double px = margin+(prob-1+0.5)*cs; double py = margin+(4-imp+0.5)*cs;
            builder.OpenElement(sq++,"circle"); builder.AddAttribute(sq++,"cx",px.ToString("F0")); builder.AddAttribute(sq++,"cy",py.ToString("F0"));
            builder.AddAttribute(sq++,"r","8"); builder.AddAttribute(sq++,"fill","#1a1a2e"); builder.AddAttribute(sq++,"stroke","white"); builder.AddAttribute(sq++,"stroke-width","1.5"); builder.CloseElement();
            builder.OpenElement(sq++,"text"); builder.AddAttribute(sq++,"x",(px+10).ToString("F0")); builder.AddAttribute(sq++,"y",(py+4).ToString("F0"));
            builder.AddAttribute(sq++,"font-size","9"); builder.AddAttribute(sq++,"fill","#1a1a2e"); builder.AddAttribute(sq++,"font-weight","bold"); builder.AddContent(sq++,r.CodigoRiesgo); builder.CloseElement();
        }
        builder.CloseElement();
    };
}
