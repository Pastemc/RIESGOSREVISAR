            <div class="col-md-6">
                <div class="card">
                    <div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                        <h5 class="mb-0"><i class="fas fa-chart-bar mr-2"></i>Riesgo Inherente</h5>
                    </div>
                    <div class="card-body p-2">@RenderHeatmapSnapshot(true)</div>
                </div>
            </div>
            <div class="col-md-6">
