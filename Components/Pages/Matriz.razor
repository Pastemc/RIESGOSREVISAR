                    <div class="card-header text-white" style="background:#003B70;border-bottom:2px solid #FFDD00;">
                        <h5 class="mb-0"><i class="fas fa-chart-bar mr-2"></i>Riesgo Residual</h5>
                    </div>
                    <div class="card-body p-2">@RenderHeatmapSnapshot(false)</div>
                </div>
            </div>
        </div>
