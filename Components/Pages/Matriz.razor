                    <li class="nav-item"><a class="nav-link @(TabActivo==2?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=2" @onclick:preventDefault><i class="fas fa-chart-bar mr-1"></i>RIESGO INHERENTE</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==3?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=3" @onclick:preventDefault><i class="fas fa-shield-alt mr-1"></i>CONTROL</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==4?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=4" @onclick:preventDefault><i class="fas fa-chart-line mr-1"></i>RIESGO RESIDUAL</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==5?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=5" @onclick:preventDefault><i class="fas fa-tasks mr-1"></i>PLAN DE ACCION</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==6?"active font-weight-bold":"")" href="#" @onclick="IrTab6" @onclick:preventDefault><i class="fas fa-tachometer-alt mr-1"></i>INDICADORES</a></li>
                </ul>
                <div class="p-4">
                    @if (!string.IsNullOrEmpty(MsgGuardar))
                    {
                        <div class="alert alert-@(GuardarOk?"success":"danger")">
                            <i class="fas fa-@(GuardarOk?"check":"exclamation")-circle mr-2"></i>@MsgGuardar
                        </div>
                    }

                    @if (TabActivo == 1)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                                <h5 class="mb-0"><i class="fas fa-info-circle mr-2"></i>DATOS GENERALES DEL RIESGO</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3"><div class="form-group"><label><strong>COD</strong></label><input class="form-control bg-light font-weight-bold" value="@RiesgoSnap.CodigoProceso" readonly /></div></div>
                                    <div class="col-md-2"><div class="form-group"><label><strong>Nivel</strong></label><input class="form-control bg-light" value="Proceso" readonly /></div></div>
                                    <div class="col-md-4"><div class="form-group"><label><strong>Gerencia Responsable</strong></label>
                                        <select class="form-control" @onchange="e => RiesgoSnap.GerenciaResponsable = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var area in AreasActivas)
                                            {
                                                <option value="@area.Nombre" selected="@(RiesgoSnap.GerenciaResponsable == area.Nombre)">@area.Categoria - @area.Nombre</option>
                                            }
                                        </select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group"><label><strong>Código del Riesgo</strong></label><input class="form-control bg-light" value="@RiesgoSnap.CodigoRiesgo" readonly /></div></div>
                                    <div class="col-md-6"><div class="form-group"><label><strong>Nombre del Proceso</strong></label><input class="form-control bg-light" value="@RiesgoSnap.NombreProceso" readonly /></div></div>
                                    <div class="col-md-6"><div class="form-group"><label><strong>Subproceso</strong></label>
                                        <input class="form-control" list="subprocesos-snap"
                                               value="@RiesgoSnap.Subproceso"
                                               @oninput="e => RiesgoSnap.Subproceso = e.Value?.ToString() ?? string.Empty" />
