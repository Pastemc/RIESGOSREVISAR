@page "/matriz"
@layout MainLayout
@attribute [Authorize]
@inject RiesgoService      RiesgoSvc
@inject ExcelService       ExcelSvc
@inject SnapshotService    SnapSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory

@* ── Alias para evitar conflicto entre la página Matriz y el modelo PeriodoRiesgo ── *@
@using MPeriodo = RiesgosElor.Models.PeriodoRiesgo

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1 class="m-0"><i class="fas fa-table mr-2"></i>Registro de Matriz</h1>
            </div>
            <div class="col-sm-4 text-right">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active">Registro de Matriz</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── estilos del mapa (sin cambios) ── */
    .mapa-card { border:2px solid #FFDD00; border-radius:10px; overflow:hidden; background:#f0f4f8; }
    .mapa-header { background:#003B70; border-bottom:3px solid #FFDD00; padding:10px 16px; display:flex; align-items:center; justify-content:space-between; }
    .mapa-body { display:flex; align-items:stretch; }
    .mapa-lateral { width:28px; min-width:28px; background:#1a3a5c; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .mapa-lateral span { color:#fff; font-size:0.55rem; font-weight:700; letter-spacing:2.5px; writing-mode:vertical-rl; text-orientation:mixed; white-space:nowrap; }
    .mapa-lateral.izq span { transform:rotate(180deg); }
    .mapa-centro { flex:1; padding:10px; display:flex; flex-direction:column; gap:8px; }
    .macro-bloque { border-radius:8px; padding:10px 12px 12px; }
    .macro-e,.macro-o { background:#0d1b2e; border:1px solid rgba(255,221,0,0.2); }
    .macro-s { background:#0d2318; border:1px solid rgba(40,167,69,0.3); }
    .macro-titulo { text-align:center; margin-bottom:10px; }
    .macro-titulo .badge-titulo { font-weight:800; font-size:0.78rem; padding:4px 20px; border-radius:20px; letter-spacing:0.5px; display:inline-block; }
    .badge-am { background:#FFDD00; color:#1a1a2e; }
    .badge-vd { background:#28a745; color:#fff; }
    .macro-grupos { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; align-items:flex-start; }
    .grupo-box { background:#112244; border:1.5px solid #FFDD00; border-radius:7px; padding:7px; min-width:150px; max-width:200px; }
    .grupo-head { background:#003B70; border:1px solid rgba(255,221,0,0.6); border-radius:4px; padding:4px 6px; text-align:center; margin-bottom:5px; }
    .grupo-head .gcod { color:#FFDD00; font-weight:800; font-size:0.7rem; display:block; line-height:1.1; }
    .grupo-head .gnom { color:#ddd; font-size:0.55rem; font-weight:600; line-height:1.2; display:block; margin-top:1px; }
    .sub-btn { display:block; width:100%; background:#EBF3FA; border:1px solid #0062B8; border-radius:4px; padding:5px 7px; margin-bottom:4px; text-align:center; cursor:pointer; transition:all 0.15s; }
    .sub-btn:last-child { margin-bottom:0; }
    .sub-btn:hover { background:#0062B8; transform:translateY(-1px); box-shadow:0 3px 8px rgba(0,98,184,0.4); }
    .sub-btn:hover .scod,.sub-btn:hover .snom { color:#fff !important; }
    .sub-btn:hover .sbadge { background:#FFDD00 !important; color:#003B70 !important; }
    .scod { color:#0062B8; font-weight:800; font-size:0.65rem; display:block; line-height:1.1; }
    .snom { color:#333; font-size:0.57rem; font-weight:500; line-height:1.2; display:block; margin-top:1px; }
    .sbadge { display:inline-block; margin-top:3px; border-radius:10px; font-size:0.52rem; padding:1px 7px; font-weight:700; }
    .sbadge.con { background:#0062B8; color:#fff; }
    .sbadge.sin { background:rgba(0,98,184,0.12); color:#888; }
    /* ── Selector de periodo ── */
    .periodo-bar { background:#003B70; border-bottom:3px solid #FFDD00; padding:8px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    .periodo-bar label { color:#FFDD00; font-weight:700; font-size:.85rem; margin:0; white-space:nowrap; }
    .periodo-bar select { max-width:280px; border-radius:6px; font-weight:600; }
    .badge-periodo-activo  { background:#28a745; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; }
    .badge-periodo-cerrado { background:#6c757d; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; }
    .badge-periodo-sin     { background:#dc3545; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; }
</style>

<div class="container-fluid">

    <!-- ══════════════════════════════════════════════════
         SELECTOR DE PERIODO
    ══════════════════════════════════════════════════ -->
    <div class="periodo-bar mb-3" style="border-radius:8px 8px 0 0;">
        <i class="fas fa-calendar-alt" style="color:#FFDD00;font-size:1.1rem;"></i>
        <label>Periodo:</label>

        @if (!Periodos.Any())
        {
            <span class="badge-periodo-sin">Sin periodos registrados</span>
        }
        else
        {
            <select class="form-control form-control-sm" @onchange="OnPeriodoChange">
                <option value="">— Sin periodo seleccionado —</option>
                @foreach (var p in Periodos)
                {
                    <option value="@p.Id" selected="@(p.Id == PeriodoSelId)">
                        @p.NombrePeriodo (@p.FechaInicio.ToString("dd/MM/yy") — @p.FechaCierre.ToString("dd/MM/yy"))
                    </option>
                }
            </select>
        }

        @if (PeriodoSel != null)
        {
            @if (PeriodoSel.Estado == "Activo")
            {
                <span class="badge-periodo-activo"><i class="fas fa-circle mr-1" style="font-size:.5rem;"></i>ACTIVO</span>
            }
            else
            {
                <span class="badge-periodo-cerrado"><i class="fas fa-lock mr-1"></i>CERRADO — Solo lectura</span>
            }
        }
        else if (!Periodos.Any())
        {
            <small class="text-warning ml-2">
                <i class="fas fa-info-circle mr-1"></i>
                Ve a <a href="/periodo-riesgo" class="text-warning font-weight-bold">Gestión de Periodos</a>
                para aperturar un periodo.
            </small>
        }
    </div>

    @* ── El mapa de procesos se muestra SIEMPRE (con o sin periodo seleccionado) ── *@
    @if (!MostrarFormulario && !MostrarHeatmap && MatrizActual == null)
    {
        @* Aviso solo lectura cuando periodo está seleccionado y cerrado *@
        @if (PeriodoSel == null && Periodos.Any())
        {
            <div class="alert alert-info mb-3">
                <i class="fas fa-hand-point-up mr-2"></i>
                Selecciona un periodo en el selector para ver o editar la matriz.
                Puedes navegar por el mapa y abrir cualquier proceso de todas formas.
            </div>
        }

        <AuthorizeView Roles="SuperAdmin,Admin">
            <Authorized>
                <div class="row mb-3">
                    <div class="col-12">
                        <a href="/vista-detallada" class="btn btn-secondary mr-2">
                            <i class="fas fa-file-alt mr-1"></i> Vista Detallada
                        </a>
                        <a href="/resumen-riesgos" class="btn btn-dark mr-2">
                            <i class="fas fa-chart-bar mr-1"></i> Resumen de Riesgos
                        </a>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Mapa de procesos — siempre visible -->
        <div class="mapa-card mb-4">
            <div class="mapa-header">
                <h3 class="text-white mb-0" style="font-size:1rem;">
                    <i class="fas fa-sitemap mr-2" style="color:#FFDD00;"></i>Mapa de Procesos
                    @if (PeriodoSel != null)
                    {
                        <small style="font-size:.75rem;opacity:.75;margin-left:8px;">
                            — @PeriodoSel.NombrePeriodo
                        </small>
                    }
                    else
                    {
                        <small style="font-size:.7rem;opacity:.65;margin-left:8px;">
                            (sin periodo seleccionado — los contadores muestran el total histórico)
                        </small>
                    }
                </h3>
            </div>
            <div class="mapa-body">
                <div class="mapa-lateral izq">
                    <span>R E Q U E R I M I E N T O S &nbsp; D E &nbsp; U S U A R I O S</span>
                </div>
                <div class="mapa-centro">
                    @if (TieneMacro("E"))
                    {
                        <div class="macro-bloque macro-e">
                            <div class="macro-titulo"><span class="badge-titulo badge-am">PROCESOS ESTRATEGICOS</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("E1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E1</span><span class="gnom">GESTION DE EXCELENCIA OPERACIONAL</span></div>@RenderSubs("E1")</div> }
                                @if (TieneGrupo("E2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E2</span><span class="gnom">GOBERNANZA</span></div>@RenderSubs("E2")</div> }
                                @if (TieneGrupo("E3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E3</span><span class="gnom">PLANEAMIENTO</span></div>@RenderSubs("E3")</div> }
                                @if (TieneGrupo("E4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E4</span><span class="gnom">REGULACION</span></div>@RenderSubs("E4")</div> }
                                @if (TieneGrupo("E5")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E5</span><span class="gnom">IMAGEN INSTITUCIONAL</span></div>@RenderSubs("E5")</div> }
                            </div>
                        </div>
                    }
                    @if (TieneMacro("O"))
                    {
                        <div class="macro-bloque macro-o">
                            <div class="macro-titulo"><span class="badge-titulo badge-am">PROCESOS OPERATIVOS</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("O1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O1</span><span class="gnom">COMERCIALIZACION DE ENERGIA ELECTRICA</span></div>@RenderSubs("O1")</div> }
                                @if (TieneGrupo("O2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O2</span><span class="gnom">GESTION OPERACION Y MANTENIMIENTO</span></div>@RenderSubs("O2")</div> }
                                @if (TieneGrupo("O3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O3</span><span class="gnom">GESTION DE CALIDAD OPERACIONAL</span></div>@RenderSubs("O3")</div> }
                                @if (TieneGrupo("O4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O4</span><span class="gnom">GESTION DE PROYECTOS</span></div>@RenderSubs("O4")</div> }
                            </div>
                        </div>
                    }
                    @if (TieneMacro("S"))
                    {
                        <div class="macro-bloque macro-s">
                            <div class="macro-titulo"><span class="badge-titulo badge-vd">PROCESOS DE SOPORTE</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("S1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S1</span><span class="gnom">GESTION LEGAL</span></div>@RenderSubs("S1")</div> }
                                @if (TieneGrupo("S2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S2</span><span class="gnom">GESTION FINANCIERA Y CONTABLE</span></div>@RenderSubs("S2")</div> }
                                @if (TieneGrupo("S3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S3</span><span class="gnom">TIC</span></div>@RenderSubs("S3")</div> }
                                @if (TieneGrupo("S4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S4</span><span class="gnom">GESTION LOGISTICA</span></div>@RenderSubs("S4")</div> }
                                @if (TieneGrupo("S5")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S5</span><span class="gnom">GESTION HUMANA</span></div>@RenderSubs("S5")</div> }
                                @if (TieneGrupo("S6")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S6</span><span class="gnom">GESTION DOCUMENTAL</span></div>@RenderSubs("S6")</div> }
                            </div>
                        </div>
                    }
                </div>
                <div class="mapa-lateral">
                    <span>S A T I S F A C C I O N &nbsp; C L I E N T E S</span>
                </div>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════════
         DETALLE DE MATRIZ (SNAPSHOT)
    ══════════════════════════════════════════════════ -->
    @if (MatrizActual != null && !MostrarFormulario && !MostrarHeatmap)
    {
        <!-- Banner según estado del periodo -->
        @if (PeriodoSel == null)
        {
            <div class="alert alert-warning d-flex align-items-center mb-3">
                <i class="fas fa-calendar-times fa-lg mr-3 text-warning"></i>
                <div>
                    <strong>Sin periodo seleccionado.</strong>
                    Selecciona un periodo en el selector superior para ver o editar los datos de esta matriz.
                    <a href="/periodo-riesgo" class="alert-link ml-2">
                        <i class="fas fa-plus-circle mr-1"></i>Abrir nuevo periodo
                    </a>
                </div>
            </div>
        }
        else if (PeriodoSel.Estado == "Cerrado")
        {
            <div class="alert alert-secondary d-flex align-items-center mb-3">
                <i class="fas fa-lock fa-lg mr-3 text-secondary"></i>
                <div>
                    <strong>Periodo cerrado.</strong> Los datos de este periodo son de solo lectura.
                    Para editar, selecciona el periodo activo.
                </div>
            </div>
        }

        <div class="card mb-3" style="border:2px solid #0062B8;">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h5 class="text-white mb-0">
                    <i class="fas fa-heading mr-2"></i>@MatrizActual.Nombre
                    <small class="ml-2" style="font-size:.75rem;opacity:.8;">
                        Periodo: @(PeriodoSel?.NombrePeriodo ?? "—")
                    </small>
                </h5>
                <button class="btn btn-secondary btn-sm" @onclick="VolverALista">
                    <i class="fas fa-arrow-left mr-1"></i> Volver al Mapa
                </button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                @if (PeriodoSel?.Estado == "Activo")
                {
                    <button class="btn btn-success mr-2" @onclick="NuevoRiesgo">
                        <i class="fas fa-plus mr-1"></i> Agregar Registro
                    </button>
                }
                @if (SnapshotActual?.Riesgos.Any() == true)
                {
                    <button class="btn btn-info mr-2" @onclick="MostrarMapasCalor">
                        <i class="fas fa-chart-bar mr-1"></i> Ver Mapa de Calor
                    </button>
                }
                @if (PeriodoSel == null)
                {
                    <span class="text-muted small">
                        <i class="fas fa-info-circle mr-1"></i>
                        Selecciona un periodo para habilitar la edición.
                    </span>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h3 class="card-title text-white">
                    <i class="fas fa-list mr-2"></i>@MatrizActual.CodigoProceso - @MatrizActual.NombreProceso
                </h3>
            </div>
            <div class="card-body table-responsive p-0">
                @if (SnapshotActual == null || !SnapshotActual.Riesgos.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                        <p>
                            @if (PeriodoSel == null)
                            {
                                <span>Selecciona un periodo en el selector para ver los datos de esta matriz.</span>
                            }
                            else if (PeriodoSel.Estado == "Activo")
                            {
                                <span>No hay riesgos en este periodo. Haz clic en <strong>Agregar Registro</strong>.</span>
                            }
                            else
                            {
                                <span>No se registraron riesgos en este periodo.</span>
                            }
                        </p>
                    </div>
                }
                else
                {
                    <table class="table table-bordered table-hover table-sm" style="font-size:0.82rem;">
                        <thead>
                            <tr style="text-align:center;">
                                <th colspan="10" style="background:#0062B8;color:white;">DATOS GENERALES DEL RIESGO</th>
                                <th colspan="3"  style="background:#6c757d;color:white;">RIESGO INHERENTE</th>
                                <th colspan="8"  style="background:#003B70;color:white;">CONTROL</th>
                                <th colspan="3"  style="background:#004F94;color:white;">RIESGO RESIDUAL</th>
                                <th colspan="9"  style="background:#856404;color:white;">PLAN DE ACCION</th>
                                <th colspan="6"  style="background:#0062B8;color:white;">INDICADORES</th>
                                <th style="background:#198754;color:white;">ACC.</th>
                            </tr>
                            <tr style="background:#EBF3FA;color:#003B70;font-size:0.75rem;text-align:center;">
                                <th>COD</th><th>Nivel</th><th>Gerencia Resp.</th><th>Nombre Proceso</th>
                                <th>Subproceso</th><th>Cod. Riesgo</th><th>Descripción Riesgo</th>
                                <th>Origen</th><th>Frecuencia</th><th>Tipo</th>
                                <th>Prob.</th><th>Impacto</th><th>Severidad</th>
                                <th>Cod. Control</th><th>Desc. Control</th><th>Área Control</th>
                                <th>Resp. Control</th><th>Frec.</th><th>Oportunidad</th>
                                <th>Automatiz.</th><th>Evidencia</th>
                                <th>Prob.</th><th>Impacto</th><th>Severidad</th>
                                <th>Estrategia</th><th>Cód. Plan</th><th>Desc. Plan</th>
                                <th>Área Plan</th><th>Resp. Plan</th><th>Inicio</th>
                                <th>Estado</th><th>Fin</th>
                                <th>Cód. KRI</th><th>Def. KRI</th><th>Frecuencia</th>
                                <th>Meta KRI</th><th>KRI Actual</th><th>Resp. KRI</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in SnapshotActual.Riesgos)
                            {
                                var sevI   = r.SeveridadInherente;
                                var sevR   = r.SeveridadResidual;
                                var nivI   = r.NivelInherente;
                                var nivR   = r.NivelResidual;
                                var colI   = RiesgoService.GetColorNivel(nivI);
                                var colR   = RiesgoService.GetColorNivel(nivR);
                                var plan1  = r.Planes.FirstOrDefault();
                                var kri1   = r.Indicadores.FirstOrDefault();
                                var esAE   = nivR == "Alto" || nivR == "Extremo";
                                var ctrls  = r.Controles.ToList();
                                int totalF = ctrls.Count > 0 ? ctrls.Count : 1;

                                for (int ci = 0; ci < totalF; ci++)
                                {
                                    var ctrl = ctrls.Count > 0 ? ctrls[ci] : null;
                                    bool esPF = ci == 0;
                                    <tr style="font-size:0.75rem;vertical-align:middle;">
                                        @if (esPF)
                                        {
                                            <td rowspan="@totalF">@r.CodigoProceso</td>
                                            <td rowspan="@totalF">Proceso</td>
                                            <td rowspan="@totalF">@r.GerenciaResponsable</td>
                                            <td rowspan="@totalF" style="white-space:normal;min-width:90px;">@r.NombreProceso</td>
                                            <td rowspan="@totalF" style="white-space:normal;">@r.Subproceso</td>
                                            <td rowspan="@totalF"><strong>@r.CodigoRiesgo</strong></td>
                                            <td rowspan="@totalF" style="max-width:130px;white-space:normal;">@r.DescripcionRiesgo</td>
                                            <td rowspan="@totalF">@r.OrigenRiesgo</td>
                                            <td rowspan="@totalF">@r.FrecuenciaRiesgo</td>
                                            <td rowspan="@totalF">@r.TipoRiesgo</td>
                                            <td rowspan="@totalF" class="text-center">@r.ProbabilidadInherente</td>
                                            <td rowspan="@totalF" class="text-center">@r.ImpactoInherente</td>
                                            <td rowspan="@totalF" class="text-center">
                                                <span class="badge" style="background:@colI;color:white">@sevI - @nivI</span>
                                            </td>
                                        }
                                        @if (ctrl != null)
                                        {
                                            <td style="white-space:normal;min-width:70px;"><strong>@ctrl.CodigoControl</strong></td>
                                            <td style="max-width:180px;white-space:normal;">@ctrl.DescripcionControl</td>
                                            <td>@ctrl.AreaResponsable</td>
                                            <td>@ctrl.ResponsablesControl</td>
                                            <td>@ctrl.FrecuenciaControl</td>
                                            <td>@ctrl.OportunidadControl</td>
                                            <td>@ctrl.AutomatizacionControl</td>
                                            <td style="max-width:150px;white-space:normal;">@ctrl.EvidenciaControl</td>
                                        }
                                        else
                                        {
                                            <td colspan="8" class="text-center text-muted"><small>Sin control registrado</small></td>
                                        }
                                        @if (esPF)
                                        {
                                            <td rowspan="@totalF" class="text-center">@r.ProbabilidadResidual</td>
                                            <td rowspan="@totalF" class="text-center">@r.ImpactoResidual</td>
                                            <td rowspan="@totalF" class="text-center">
                                                <span class="badge" style="background:@colR;color:white">@sevR - @nivR</span>
                                            </td>
                                            <td rowspan="@totalF">@(r.EstrategiaResidual == "" ? "-" : r.EstrategiaResidual)</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.CodigoPlan          ?? "-") : "-")</td>
                                            <td rowspan="@totalF" style="max-width:100px;white-space:normal;">@(esAE ? (plan1?.DescripcionPlan ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.AreaResponsable      ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.ResponsablePlan      ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.InicioPlan?.ToString("dd/MM/yyyy") ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.EstadoPlan           ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (plan1?.FinPlan?.ToString("dd/MM/yyyy")   ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (kri1?.CodigoKRI             ?? "-") : "-")</td>
                                            <td rowspan="@totalF" style="max-width:100px;white-space:normal;">@(esAE ? (kri1?.DefinicionKRI ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (kri1?.Frecuencia            ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (kri1?.MetaKRI               ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (kri1?.KRIActual             ?? "-") : "-")</td>
                                            <td rowspan="@totalF">@(esAE ? (kri1?.ResponsableKRI        ?? "-") : "-")</td>
                                            <td rowspan="@totalF">
                                                @if (PeriodoSel?.Estado == "Activo")
                                                {
                                                    <button class="btn btn-xs btn-info mr-1"
                                                            @onclick="() => EditarSnapshotRiesgo(r)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-xs btn-danger"
                                                            @onclick="() => EliminarSnapshotRiesgo(r.Id)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted"><i class="fas fa-lock"></i></span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (MostrarHeatmap && MatrizActual != null && SnapshotActual != null)
    {
        <div class="row mb-3">
            <div class="col-12">
                <button class="btn btn-secondary" @onclick="() => MostrarHeatmap = false">
