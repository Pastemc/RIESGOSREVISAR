                                {
                                    <div class="alert alert-info">Para nivel <strong>@NivRes</strong>, solo aplica la estrategia.</div>
                                }
                                else
                                {
                                    <div class="mb-3"><button class="btn btn-success" @onclick="AgregarPlan"><i class="fas fa-plus mr-1"></i> Agregar Plan</button></div>
                                    @for (int pi=0; pi<Planes.Count; pi++)
                                    {
                                        var pidx=pi; var plan=Planes[pidx];
                                        <div class="card mb-3" style="border:1px solid #ffc107;">
                                            <div class="card-header d-flex justify-content-between align-items-center" style="background:#fff3cd;">
                                                <strong style="color:#856404;">Plan #@(pidx+1) — @plan.CodigoPlan</strong>
                                                <button class="btn btn-sm btn-danger" @onclick="() => Planes.RemoveAt(pidx)"><i class="fas fa-trash"></i></button>
