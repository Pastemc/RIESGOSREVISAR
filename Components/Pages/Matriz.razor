                                @for (int ci=0; ci<Controles.Count; ci++)
                                {
                                    var idx=ci; var ctrl=Controles[idx];
                                    <div class="card mb-3" style="border:1px solid #0062B8;">
                                        <div class="card-header d-flex justify-content-between align-items-center" style="background:#EBF3FA;">
                                            <strong style="color:#0062B8;">Control #@(idx+1) — @ctrl.CodigoControl</strong>
                                            <button class="btn btn-sm btn-danger" @onclick="() => Controles.RemoveAt(idx)">
                                                <i class="fas fa-trash mr-1"></i>Eliminar
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-2"><div class="form-group"><label><strong>Código</strong></label><input class="form-control bg-light" value="@ctrl.CodigoControl" readonly /></div></div>
                                                <div class="col-md-10"><div class="form-group"><label><strong>Descripción</strong></label><textarea class="form-control" rows="3" @oninput="e => ctrl.DescripcionControl = e.Value?.ToString() ?? string.Empty">@ctrl.DescripcionControl</textarea></div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Área Responsable</strong></label>
                                                    <select class="form-control" @onchange="e => ctrl.AreaResponsable = e.Value?.ToString() ?? string.Empty">
                                                        <option value="">-- Selecciona --</option>
                                                        @foreach (var area in AreasActivas) { <option value="@area.Nombre" selected="@(ctrl.AreaResponsable==area.Nombre)">@area.Categoria - @area.Nombre</option> }
                                                    </select>
                                                </div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Responsable</strong></label><textarea class="form-control" rows="2" @oninput="e => ctrl.ResponsablesControl = e.Value?.ToString() ?? string.Empty">@ctrl.ResponsablesControl</textarea></div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Frecuencia</strong></label>
                                                    <select class="form-control" @onchange="e => ctrl.FrecuenciaControl = e.Value?.ToString() ?? string.Empty">
                                                        <option value="">-- Selecciona --</option>
                                                        @foreach (var op in OpcionesParametro("FrecuenciaControl")) { <option value="@op" selected="@(ctrl.FrecuenciaControl==op)">@op</option> }
                                                    </select>
                                                </div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Oportunidad</strong></label>
                                                    <select class="form-control" @onchange="e => ctrl.OportunidadControl = e.Value?.ToString() ?? string.Empty">
                                                        <option value="">-- Selecciona --</option>
                                                        @foreach (var op in OpcionesParametro("OportunidadControl")) { <option value="@op" selected="@(ctrl.OportunidadControl==op)">@op</option> }
                                                    </select>
                                                </div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Automatización</strong></label>
                                                    <select class="form-control" @onchange="e => ctrl.AutomatizacionControl = e.Value?.ToString() ?? string.Empty">
                                                        <option value="">-- Selecciona --</option>
                                                        @foreach (var op in OpcionesParametro("AutomatizacionControl")) { <option value="@op" selected="@(ctrl.AutomatizacionControl==op)">@op</option> }
                                                    </select>
                                                </div></div>
                                                <div class="col-md-4"><div class="form-group"><label><strong>Evidencia</strong></label><textarea class="form-control" rows="2" @oninput="e => ctrl.EvidenciaControl = e.Value?.ToString() ?? string.Empty">@ctrl.EvidenciaControl</textarea></div></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-secondary" @onclick="() => TabActivo=2"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                <button class="btn btn-primary"   @onclick="() => TabActivo=4">Continuar <i class="fas fa-arrow-right ml-1"></i></button>
                            </div>
                        </div>
                    }

                    @if (TabActivo == 4)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#6c757d;">
                                <h5 class="mb-0">EVALUACION DE RIESGO RESIDUAL</h5>
                            </div>
                            <div class="card-body">
                                <div class="row justify-content-center">
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Probabilidad (1-4)</strong></label>
                                        <select class="form-control form-control-lg text-center" @onchange="OnProbResChange">
                                            @for (int i=1;i<=4;i++) { <option value="@i" selected="@(RiesgoSnap.ProbabilidadResidual==i)">@i</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Impacto (1-4)</strong></label>
                                        <select class="form-control form-control-lg text-center" @onchange="OnImpResChange">
                                            @for (int i=1;i<=4;i++) { <option value="@i" selected="@(RiesgoSnap.ImpactoResidual==i)">@i</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Severidad</strong></label>
                                        <div class="p-3 rounded text-white text-center" style="background:@ColorRes;font-size:2rem;font-weight:bold;">
                                            @SevRes<br/><small style="font-size:1rem;">@NivRes</small>
                                        </div>
                                    </div></div>
                                </div>
                                <div class="row justify-content-center mt-3">
                                    <div class="col-md-5">
                                        <label><strong>Estrategia de Respuesta</strong></label>
                                        <select class="form-control form-control-lg" @onchange="e => RiesgoSnap.EstrategiaResidual = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var op in OpcionesParametro("EstrategiaTratamiento")) { <option value="@op" selected="@(RiesgoSnap.EstrategiaResidual==op)">@op</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        @if (!PuedeVerPlanIndicadores)
                                        {
                                            <div class="alert alert-success mt-2"><i class="fas fa-check-circle mr-2"></i>Nivel <strong>@NivRes</strong>: Plan e Indicadores no aplican.</div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mt-2"><i class="fas fa-exclamation-triangle mr-2"></i>Nivel <strong>@NivRes</strong>: Completa Plan e Indicadores.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-secondary" @onclick="() => TabActivo=3"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                <div>
                                    <button class="btn btn-primary mr-2" @onclick="() => TabActivo=5">Continuar <i class="fas fa-arrow-right ml-1"></i></button>
                                    @if (!PuedeVerPlanIndicadores)
                                    {
                                        <button class="btn btn-success" @onclick="GuardarTodoSnapshot">
                                            <i class="fas fa-check-circle mr-1"></i> Finalizar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (TabActivo == 5)
                    {
