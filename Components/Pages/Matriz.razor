@page "/matriz"
@layout MainLayout
@attribute [Authorize]
@inject RiesgoService      RiesgoSvc
@inject ExcelService       ExcelSvc
@inject SnapshotService    SnapSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory

@using MPeriodo = RiesgosElor.Models.PeriodoRiesgo

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1 class="m-0"><i class="fas fa-table mr-2"></i>Registro de Matriz</h1>
            </div>
            <div class="col-sm-4 text-right">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active">Registro de Matriz</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<style>
    .mapa-card { border:2px solid #FFDD00; border-radius:10px; overflow:hidden; background:#f0f4f8; }
    .mapa-header { background:#003B70; border-bottom:3px solid #FFDD00; padding:10px 16px; display:flex; align-items:center; justify-content:space-between; }
    .mapa-body { display:flex; align-items:stretch; }
    .mapa-lateral { width:28px; min-width:28px; background:#1a3a5c; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .mapa-lateral span { color:#fff; font-size:0.55rem; font-weight:700; letter-spacing:2.5px; writing-mode:vertical-rl; text-orientation:mixed; white-space:nowrap; }
    .mapa-lateral.izq span { transform:rotate(180deg); }
    .mapa-centro { flex:1; padding:10px; display:flex; flex-direction:column; gap:8px; }
    .macro-bloque { border-radius:8px; padding:10px 12px 12px; }
    .macro-e,.macro-o { background:#0d1b2e; border:1px solid rgba(255,221,0,0.2); }
    .macro-s { background:#0d2318; border:1px solid rgba(40,167,69,0.3); }
    .macro-titulo { text-align:center; margin-bottom:10px; }
    .macro-titulo .badge-titulo { font-weight:800; font-size:0.78rem; padding:4px 20px; border-radius:20px; letter-spacing:0.5px; display:inline-block; }
    .badge-am { background:#FFDD00; color:#1a1a2e; }
    .badge-vd { background:#28a745; color:#fff; }
    .macro-grupos { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; align-items:flex-start; }
    .grupo-box { background:#112244; border:1.5px solid #FFDD00; border-radius:7px; padding:7px; min-width:150px; max-width:200px; }
    .grupo-head { background:#003B70; border:1px solid rgba(255,221,0,0.6); border-radius:4px; padding:4px 6px; text-align:center; margin-bottom:5px; }
    .grupo-head .gcod { color:#FFDD00; font-weight:800; font-size:0.7rem; display:block; line-height:1.1; }
    .grupo-head .gnom { color:#ddd; font-size:0.55rem; font-weight:600; line-height:1.2; display:block; margin-top:1px; }
    .sub-btn { display:block; width:100%; background:#EBF3FA; border:1px solid #0062B8; border-radius:4px; padding:5px 7px; margin-bottom:4px; text-align:center; cursor:pointer; transition:all 0.15s; }
    .sub-btn:last-child { margin-bottom:0; }
    .sub-btn:hover { background:#0062B8; transform:translateY(-1px); box-shadow:0 3px 8px rgba(0,98,184,0.4); }
    .sub-btn:hover .scod,.sub-btn:hover .snom { color:#fff !important; }
    .sub-btn:hover .sbadge { background:#FFDD00 !important; color:#003B70 !important; }
    .scod { color:#0062B8; font-weight:800; font-size:0.65rem; display:block; line-height:1.1; }
    .snom { color:#333; font-size:0.57rem; font-weight:500; line-height:1.2; display:block; margin-top:1px; }
    .sbadge { display:inline-block; margin-top:3px; border-radius:10px; font-size:0.52rem; padding:1px 7px; font-weight:700; }
    .sbadge.con { background:#0062B8; color:#fff; }
    .sbadge.sin { background:rgba(0,98,184,0.12); color:#888; }
    .periodo-bar { background:#003B70; border-bottom:3px solid #FFDD00; padding:8px 16px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .periodo-bar label { color:#FFDD00; font-weight:700; font-size:.85rem; margin:0; white-space:nowrap; }
    .periodo-bar select { max-width:340px; border-radius:6px; font-weight:600; }
    .badge-periodo-activo  { background:#28a745; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
    .badge-periodo-cerrado { background:#6c757d; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
    .badge-periodo-sin     { background:#dc3545; color:#fff; font-size:.75rem; padding:4px 10px; border-radius:20px; white-space:nowrap; }
    .version-chip { display:inline-block; background:#FFDD00; color:#003B70; font-weight:800; font-size:.72rem; padding:2px 8px; border-radius:20px; vertical-align:middle; letter-spacing:.4px; }
    .tipo-chip-apertura   { background:#0062B8; color:#fff; font-size:.7rem; padding:2px 8px; border-radius:20px; font-weight:700; white-space:nowrap; }
    .tipo-chip-validacion { background:#28a745; color:#fff; font-size:.7rem; padding:2px 8px; border-radius:20px; font-weight:700; white-space:nowrap; }
    .tipo-chip-evidencia  { background:#fd7e14; color:#fff; font-size:.7rem; padding:2px 8px; border-radius:20px; font-weight:700; white-space:nowrap; }
    .badge-estado-concluido  { background:#28a745; color:#fff; font-size:.65rem; padding:2px 8px; border-radius:20px; font-weight:700; }
    .badge-estado-proceso    { background:#ffc107; color:#000; font-size:.65rem; padding:2px 8px; border-radius:20px; font-weight:700; }
    .badge-estado-noiniciado { background:#6c757d; color:#fff; font-size:.65rem; padding:2px 8px; border-radius:20px; font-weight:700; }

    /* ══ TABLA MATRIZ — FIX BORDES ══ */
    .tabla-mrc {
        font-size: 0.74rem;
        border-collapse: collapse !important;
        width: 100%;
        table-layout: auto;
    }
    /* TODOS los th y td tienen borde siempre visible */
    .tabla-mrc th,
    .tabla-mrc td {
        border: 1px solid #9aafc4 !important;
        padding: 5px 6px !important;
        vertical-align: top !important;
    }
    .tabla-mrc thead th {
        vertical-align: middle !important;
    }
    /* Texto largo con word-wrap */
    .tabla-mrc .cs {
        white-space: pre-line;
        word-break: break-word;
        max-height: 90px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 5;
    }
    /* Separador entre ítems apilados dentro de una celda */
    .tabla-mrc .item-sep {
        padding-bottom: 3px;
        margin-bottom: 3px;
    }
    .tabla-mrc .item-sep:not(:last-child) {
        border-bottom: 1px dashed #c0cfe0;
        margin-bottom: 4px;
    }
    .tabla-mrc .nw { white-space: nowrap; }
    .tabla-mrc .tc { text-align: center; }
    /* Anchos */
    .tabla-mrc .w-cod      { min-width:55px; }
    .tabla-mrc .w-nivel    { min-width:55px; }
    .tabla-mrc .w-gerencia { min-width:160px; max-width:200px; }
    .tabla-mrc .w-proceso  { min-width:160px; max-width:200px; }
    .tabla-mrc .w-sub      { min-width:130px; max-width:180px; }
    .tabla-mrc .w-codr     { min-width:85px; }
    .tabla-mrc .w-descr    { min-width:190px; max-width:260px; }
    .tabla-mrc .w-origen   { min-width:70px; }
    .tabla-mrc .w-frec     { min-width:80px; }
    .tabla-mrc .w-tipo     { min-width:90px; }
    .tabla-mrc .w-prob     { min-width:42px; max-width:58px; }
    .tabla-mrc .w-sev      { min-width:100px; }
    .tabla-mrc .w-codc     { min-width:90px; }
    .tabla-mrc .w-descc    { min-width:210px; max-width:290px; }
    .tabla-mrc .w-areac    { min-width:130px; max-width:180px; }
    .tabla-mrc .w-respc    { min-width:140px; max-width:200px; }
    .tabla-mrc .w-frecuenc { min-width:75px; }
    .tabla-mrc .w-opor     { min-width:80px; }
    .tabla-mrc .w-autom    { min-width:80px; }
    .tabla-mrc .w-evid     { min-width:140px; max-width:200px; }
    .tabla-mrc .w-estrat   { min-width:100px; max-width:140px; }
    .tabla-mrc .w-codp     { min-width:85px; }
    .tabla-mrc .w-descp    { min-width:180px; max-width:250px; }
    .tabla-mrc .w-areap    { min-width:130px; max-width:180px; }
    .tabla-mrc .w-respp    { min-width:130px; max-width:185px; }
    .tabla-mrc .w-fecha    { min-width:85px; max-width:105px; }
    .tabla-mrc .w-estado   { min-width:85px; }
    .tabla-mrc .w-eficaz   { min-width:68px; }
    .tabla-mrc .w-verif    { min-width:130px; max-width:185px; }
    .tabla-mrc .w-codk     { min-width:80px; }
    .tabla-mrc .w-defk     { min-width:210px; max-width:300px; }
    .tabla-mrc .w-frecuenk { min-width:72px; }
    .tabla-mrc .w-meta     { min-width:130px; max-width:180px; }
    .tabla-mrc .w-actual   { min-width:75px; }
    .tabla-mrc .w-respk    { min-width:140px; max-width:200px; }
    .tabla-mrc .w-acc      { min-width:62px; text-align:center; }
    /* Fila de datos — altura mínima visible */
    .tabla-mrc tbody tr {
        min-height: 40px;
    }
    /* Celda vacía de relleno */
    .tabla-mrc td.celda-vacia {
        background: #f8fafd;
    }
</style>

<div class="container-fluid">

    <!-- ══ SELECTOR DE PERIODO ══ -->
    <div class="periodo-bar mb-3" style="border-radius:8px 8px 0 0;">
        <i class="fas fa-calendar-alt" style="color:#FFDD00;font-size:1.1rem;"></i>
        <label>Periodo:</label>
        @if (!Periodos.Any())
        {
            <span class="badge-periodo-sin">Sin periodos registrados</span>
            <small class="text-warning ml-2">
                <i class="fas fa-info-circle mr-1"></i>
                Ve a <a href="/periodo-riesgo" class="text-warning font-weight-bold">Gestión de Periodos</a> para aperturar un periodo.
            </small>
        }
        else
        {
            <select class="form-control form-control-sm" style="max-width:260px;" @onchange="OnPeriodoChange">
                <option value="">— Sin periodo seleccionado —</option>
                @foreach (var p in PeriodosUnicos)
                {
                    <option value="@p.Id" selected="@(p.Id == PeriodoSelId)">
                        @p.NombrePeriodo (@p.FechaInicio.ToString("dd/MM/yy") — @p.FechaCierre.ToString("dd/MM/yy"))
                    </option>
                }
            </select>
            @if (PeriodoSel != null)
            {
                <label class="ml-2" style="color:#FFDD00;font-weight:700;font-size:.85rem;margin:0;white-space:nowrap;">Versión:</label>
                <select class="form-control form-control-sm" style="max-width:120px;" @onchange="OnVersionChange">
                    @foreach (var p in VersionesDelPeriodo)
                    {
                        <option value="@p.Id" selected="@(p.Id == PeriodoSelId)">V@(p.Version) — @p.TipoPeriodo</option>
                    }
                </select>
            }
        }
        @if (PeriodoSel != null)
        {
            <span class="@TipoChipClass(PeriodoSel.TipoPeriodo)">
                <i class="fas @TipoIcono(PeriodoSel.TipoPeriodo) mr-1"></i>@PeriodoSel.TipoPeriodo
            </span>
            @if (PeriodoSel.Estado == "Activo")
            {
                <span class="badge-periodo-activo"><i class="fas fa-circle mr-1" style="font-size:.5rem;vertical-align:middle;"></i>ACTIVO</span>
            }
            else
            {
                <span class="badge-periodo-cerrado"><i class="fas fa-lock mr-1"></i>CERRADO</span>
            }
        }
    </div>

    <!-- ══ MAPA DE PROCESOS ══ -->
    @if (!MostrarFormulario && !MostrarHeatmap && MatrizActual == null)
    {
        @if (PeriodoSel == null && Periodos.Any())
        {
            <div class="alert alert-info mb-3"><i class="fas fa-hand-point-up mr-2"></i>Selecciona un periodo para ver o editar la matriz.</div>
        }
        @if (!Periodos.Any())
        {
            <div class="alert alert-warning mb-3">
                <i class="fas fa-info-circle mr-2"></i>
                <strong>Vista previa de carga masiva.</strong>
                Crea un periodo en <a href="/periodo-riesgo" class="alert-link font-weight-bold">Gestión de Periodos</a> para comenzar.
            </div>
        }
        <AuthorizeView Roles="SuperAdmin,Admin">
            <Authorized>
                <div class="row mb-3"><div class="col-12">
                    <a href="/vista-detallada" class="btn btn-secondary mr-2"><i class="fas fa-file-alt mr-1"></i> Vista Detallada</a>
                    <a href="/resumen-riesgos" class="btn btn-dark mr-2"><i class="fas fa-chart-bar mr-1"></i> Resumen de Riesgos</a>
                </div></div>
            </Authorized>
        </AuthorizeView>
        <div class="mapa-card mb-4">
            <div class="mapa-header">
                <h3 class="text-white mb-0" style="font-size:1rem;">
                    <i class="fas fa-sitemap mr-2" style="color:#FFDD00;"></i>Mapa de Procesos
                    @if (PeriodoSel != null)
                    {
                        <small style="font-size:.75rem;opacity:.85;margin-left:8px;">— @PeriodoSel.NombrePeriodo <span class="version-chip ml-1">P-@(PeriodoSel.NumeroPeriodo) V@(PeriodoSel.Version)</span></small>
                    }
                    else { <small style="font-size:.7rem;opacity:.65;margin-left:8px;">(sin periodo — contadores históricos)</small> }
                </h3>
            </div>
            <div class="mapa-body">
                <div class="mapa-lateral izq"><span>R E Q U E R I M I E N T O S &nbsp; D E &nbsp; U S U A R I O S</span></div>
                <div class="mapa-centro">
                    @if (TieneMacro("E"))
                    {
                        <div class="macro-bloque macro-e">
                            <div class="macro-titulo"><span class="badge-titulo badge-am">PROCESOS ESTRATEGICOS</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("E1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E1</span><span class="gnom">GESTION DE EXCELENCIA OPERACIONAL</span></div>@RenderSubs("E1")</div> }
                                @if (TieneGrupo("E2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E2</span><span class="gnom">GOBERNANZA</span></div>@RenderSubs("E2")</div> }
                                @if (TieneGrupo("E3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E3</span><span class="gnom">PLANEAMIENTO</span></div>@RenderSubs("E3")</div> }
                                @if (TieneGrupo("E4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E4</span><span class="gnom">REGULACION</span></div>@RenderSubs("E4")</div> }
                                @if (TieneGrupo("E5")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">E5</span><span class="gnom">IMAGEN INSTITUCIONAL</span></div>@RenderSubs("E5")</div> }
                            </div>
                        </div>
                    }
                    @if (TieneMacro("O"))
                    {
                        <div class="macro-bloque macro-o">
                            <div class="macro-titulo"><span class="badge-titulo badge-am">PROCESOS OPERATIVOS</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("O1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O1</span><span class="gnom">COMERCIALIZACION DE ENERGIA ELECTRICA</span></div>@RenderSubs("O1")</div> }
                                @if (TieneGrupo("O2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O2</span><span class="gnom">GESTION OPERACION Y MANTENIMIENTO</span></div>@RenderSubs("O2")</div> }
                                @if (TieneGrupo("O3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O3</span><span class="gnom">GESTION DE CALIDAD OPERACIONAL</span></div>@RenderSubs("O3")</div> }
                                @if (TieneGrupo("O4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">O4</span><span class="gnom">GESTION DE PROYECTOS</span></div>@RenderSubs("O4")</div> }
                            </div>
                        </div>
                    }
                    @if (TieneMacro("S"))
                    {
                        <div class="macro-bloque macro-s">
                            <div class="macro-titulo"><span class="badge-titulo badge-vd">PROCESOS DE SOPORTE</span></div>
                            <div class="macro-grupos">
                                @if (TieneGrupo("S1")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S1</span><span class="gnom">GESTION LEGAL</span></div>@RenderSubs("S1")</div> }
                                @if (TieneGrupo("S2")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S2</span><span class="gnom">GESTION FINANCIERA Y CONTABLE</span></div>@RenderSubs("S2")</div> }
                                @if (TieneGrupo("S3")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S3</span><span class="gnom">TIC</span></div>@RenderSubs("S3")</div> }
                                @if (TieneGrupo("S4")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S4</span><span class="gnom">GESTION LOGISTICA</span></div>@RenderSubs("S4")</div> }
                                @if (TieneGrupo("S5")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S5</span><span class="gnom">GESTION HUMANA</span></div>@RenderSubs("S5")</div> }
                                @if (TieneGrupo("S6")) { <div class="grupo-box"><div class="grupo-head"><span class="gcod">S6</span><span class="gnom">GESTION DOCUMENTAL</span></div>@RenderSubs("S6")</div> }
                            </div>
                        </div>
                    }
                </div>
                <div class="mapa-lateral"><span>S A T I S F A C C I O N &nbsp; C L I E N T E S</span></div>
            </div>
        </div>
    }

    <!-- ══ DETALLE DE MATRIZ ══ -->
    @if (MatrizActual != null && !MostrarFormulario && !MostrarHeatmap)
    {
        @* Alertas de modo *@
        @if (PeriodoSel == null)
        {
            <div class="alert alert-warning d-flex align-items-center mb-3">
                <i class="fas fa-calendar-times fa-lg mr-3 text-warning"></i>
                <div><strong>Sin periodo seleccionado.</strong> Vista previa (solo lectura).
                    <a href="/periodo-riesgo" class="alert-link ml-2"><i class="fas fa-plus-circle mr-1"></i>Abrir nuevo periodo</a>
                </div>
            </div>
        }
        else if (EsModoValidacion)
        {
            <div class="alert d-flex align-items-center mb-3"
                 style="background:#e8f5e9;border-left:5px solid #28a745;border-radius:8px;">
                <i class="fas fa-eye fa-lg mr-3" style="color:#28a745;"></i>
                <div>
                    <strong style="color:#1a5f1a;">Periodo de Validación — Solo Lectura.</strong>
                    Datos del periodo de Apertura cerrado
                    <strong>P-@(PeriodoSel.NumeroPeriodo) V@(PeriodoSel.Version)</strong>.
                    No se pueden editar, agregar ni eliminar riesgos.
                </div>
            </div>
        }
        else if (PeriodoSel.Estado == "Cerrado")
        {
            <div class="alert alert-secondary d-flex align-items-center mb-3">
                <i class="fas fa-lock fa-lg mr-3 text-secondary"></i>
                <div><strong>Periodo cerrado.</strong> Solo lectura.</div>
            </div>
        }

        <div class="card mb-3" style="border:2px solid #0062B8;">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h5 class="text-white mb-0">
                    <i class="fas fa-heading mr-2"></i>@MatrizActual.Nombre
                    @if (PeriodoSel != null)
                    {
                        <small class="ml-2" style="font-size:.75rem;opacity:.85;">
                            — @PeriodoSel.NombrePeriodo
                            <span class="version-chip ml-1">P-@(PeriodoSel.NumeroPeriodo) V@(PeriodoSel.Version)</span>
                            <span class="@TipoChipClass(PeriodoSel.TipoPeriodo) ml-1" style="font-size:.65rem;padding:1px 7px;">@PeriodoSel.TipoPeriodo</span>
                        </small>
                    }
                    else { <small class="ml-2" style="font-size:.75rem;opacity:.7;">— Vista carga base</small> }
                </h5>
                <button class="btn btn-secondary btn-sm" @onclick="VolverALista"><i class="fas fa-arrow-left mr-1"></i> Volver al Mapa</button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                @* Solo Apertura activo permite agregar riesgos *@
                @if (PeriodoSel?.Estado == "Activo" && !EsModoSoloLectura)
                {
                    <button class="btn btn-success mr-2" @onclick="NuevoRiesgo"><i class="fas fa-plus mr-1"></i> Agregar Registro</button>
                }
                @if (SnapshotActual?.Riesgos.Any() == true)
                {
                    <button class="btn btn-info mr-2" @onclick="MostrarMapasCalor"><i class="fas fa-chart-bar mr-1"></i> Ver Mapa de Calor</button>
                }
                @if (EsModoValidacion)
                {
                    <span class="badge" style="background:#28a745;color:#fff;font-size:.8rem;padding:6px 12px;border-radius:20px;">
                        <i class="fas fa-eye mr-1"></i>Modo Validación — Solo lectura
                    </span>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h3 class="card-title text-white"><i class="fas fa-list mr-2"></i>@MatrizActual.CodigoProceso - @MatrizActual.NombreProceso</h3>
            </div>
            <div class="card-body table-responsive p-0">
                @if (SnapshotActual == null || !SnapshotActual.Riesgos.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                        <p>
                            @if (PeriodoSel == null)            { <span>Selecciona un periodo para ver los datos.</span> }
                            else if (PeriodoSel.Estado == "Activo" && !EsModoSoloLectura) { <span>No hay riesgos. Haz clic en <strong>Agregar Registro</strong>.</span> }
                            else                                { <span>No se registraron riesgos en este periodo.</span> }
                        </p>
                    </div>
                }
                else
                {
                    <table class="tabla-mrc">
                        <thead>
                            <tr>
                                <th colspan="10" style="background:#0062B8;color:white;text-align:center;">DATOS GENERALES DEL RIESGO</th>
                                <th colspan="3"  style="background:#6c757d;color:white;text-align:center;">RIESGO INHERENTE</th>
                                <th colspan="8"  style="background:#003B70;color:white;text-align:center;">CONTROL</th>
                                <th colspan="4"  style="background:#004F94;color:white;text-align:center;">RIESGO RESIDUAL</th>
                                <th colspan="11" style="background:#856404;color:white;text-align:center;">PLAN DE ACCION</th>
                                <th colspan="6"  style="background:#0062B8;color:white;text-align:center;">INDICADORES</th>
                                <th style="background:#198754;color:white;text-align:center;">ACC.</th>
                            </tr>
                            <tr style="background:#EBF3FA;color:#003B70;font-size:0.7rem;text-align:center;">
                                <th class="w-cod">COD</th>
                                <th class="w-nivel">Nivel</th>
                                <th class="w-gerencia">Gerencia Resp.</th>
                                <th class="w-proceso">Nombre Proceso</th>
                                <th class="w-sub">Subproceso</th>
                                <th class="w-codr">Cod. Riesgo</th>
                                <th class="w-descr">Descripción Riesgo</th>
                                <th class="w-origen">Origen</th>
                                <th class="w-frec">Frecuencia</th>
                                <th class="w-tipo">Tipo</th>
                                <th class="w-prob">Prob.</th>
                                <th class="w-prob">Impacto</th>
                                <th class="w-sev">Severidad</th>
                                <th class="w-codc">Cod. Control</th>
                                <th class="w-descc">Desc. Control</th>
                                <th class="w-areac">Área Control</th>
                                <th class="w-respc">Resp. Control</th>
                                <th class="w-frecuenc">Frec.</th>
                                <th class="w-opor">Oportunidad</th>
                                <th class="w-autom">Automatiz.</th>
                                <th class="w-evid">Evidencia</th>
                                <th class="w-prob">Prob.</th>
                                <th class="w-prob">Impacto</th>
                                <th class="w-sev">Severidad</th>
                                <th class="w-estrat">Estrategia</th>
                                <th class="w-codp">Cód. Plan</th>
                                <th class="w-descp">Desc. Plan</th>
                                <th class="w-areap">Área Plan</th>
                                <th class="w-respp">Resp. Plan</th>
                                <th class="w-fecha">Inicio</th>
                                <th class="w-estado">Estado</th>
                                <th class="w-fecha">Fin</th>
                                <th class="w-fecha">F. Prevista</th>
                                <th class="w-eficaz">¿Eficaz?</th>
                                <th class="w-fecha">F. Verif.</th>
                                <th class="w-verif">Verificado por</th>
                                <th class="w-codk">Cód. KRI</th>
                                <th class="w-defk">Def. KRI</th>
                                <th class="w-frecuenk">Frecuencia</th>
                                <th class="w-meta">Meta KRI</th>
                                <th class="w-actual">KRI Actual</th>
                                <th class="w-respk">Resp. KRI</th>
                                <th class="w-acc"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in SnapshotActual.Riesgos)
                            {
                                var sevI  = r.SeveridadInherente;
                                var sevR  = r.SeveridadResidual;
                                var nivI  = r.NivelInherente;
                                var nivR  = r.NivelResidual;
                                var colI  = RiesgoService.GetColorNivel(nivI);
                                var colR  = RiesgoService.GetColorNivel(nivR);
                                var esAE  = nivR == "Alto" || nivR == "Extremo";
                                var ctrls = r.Controles.ToList();
                                var plans = r.Planes.ToList();
                                var kris  = r.Indicadores.ToList();
                                <tr>
                                    @* ── DATOS GENERALES ── *@
                                    <td class="w-cod">@r.CodigoProceso</td>
                                    <td class="w-nivel">Proceso</td>
                                    <td class="w-gerencia"><div class="cs">@r.GerenciaResponsable</div></td>
                                    <td class="w-proceso"><div class="cs">@r.NombreProceso</div></td>
                                    <td class="w-sub"><div class="cs">@r.Subproceso</div></td>
                                    <td class="w-codr"><strong>@r.CodigoRiesgo</strong></td>
                                    <td class="w-descr"><div class="cs">@r.DescripcionRiesgo</div></td>
                                    <td class="w-origen">@r.OrigenRiesgo</td>
                                    <td class="w-frec">@r.FrecuenciaRiesgo</td>
                                    <td class="w-tipo">@r.TipoRiesgo</td>
                                    @* ── RIESGO INHERENTE ── *@
                                    <td class="w-prob tc">@r.ProbabilidadInherente</td>
                                    <td class="w-prob tc">@r.ImpactoInherente</td>
                                    <td class="w-sev tc"><span class="badge" style="background:@colI;color:white;white-space:nowrap;">@sevI - @nivI</span></td>
                                    @* ── CONTROLES apilados en divs — SIN rowspan ── *@
                                    @if (ctrls.Count > 0)
                                    {
                                        <td class="w-codc">@foreach (var c in ctrls) { <div class="item-sep"><strong>@c.CodigoControl</strong></div> }</td>
                                        <td class="w-descc">@foreach (var c in ctrls) { <div class="cs item-sep">@c.DescripcionControl</div> }</td>
                                        <td class="w-areac">@foreach (var c in ctrls) { <div class="cs item-sep">@c.AreaResponsable</div> }</td>
                                        <td class="w-respc">@foreach (var c in ctrls) { <div class="cs item-sep">@c.ResponsablesControl</div> }</td>
                                        <td class="w-frecuenc">@foreach (var c in ctrls) { <div class="item-sep">@c.FrecuenciaControl</div> }</td>
                                        <td class="w-opor">@foreach (var c in ctrls) { <div class="item-sep">@c.OportunidadControl</div> }</td>
                                        <td class="w-autom">@foreach (var c in ctrls) { <div class="item-sep">@c.AutomatizacionControl</div> }</td>
                                        <td class="w-evid">@foreach (var c in ctrls) { <div class="cs item-sep">@c.EvidenciaControl</div> }</td>
                                    }
                                    else
                                    {
                                        <td class="w-codc celda-vacia"></td>
                                        <td class="w-descc celda-vacia"></td>
                                        <td class="w-areac celda-vacia"></td>
                                        <td class="w-respc celda-vacia"></td>
                                        <td class="w-frecuenc celda-vacia"></td>
                                        <td class="w-opor celda-vacia"></td>
                                        <td class="w-autom celda-vacia"></td>
                                        <td class="w-evid celda-vacia"></td>
                                    }
                                    @* ── RIESGO RESIDUAL ── *@
                                    <td class="w-prob tc">@r.ProbabilidadResidual</td>
                                    <td class="w-prob tc">@r.ImpactoResidual</td>
                                    <td class="w-sev tc"><span class="badge" style="background:@colR;color:white;white-space:nowrap;">@sevR - @nivR</span></td>
                                    <td class="w-estrat">@(string.IsNullOrEmpty(r.EstrategiaResidual) ? "" : r.EstrategiaResidual)</td>
                                    @* ── PLAN DE ACCION — apilados en divs ── *@
                                    @if (!esAE)
                                    {
                                        <td class="w-codp celda-vacia"></td>
                                        <td class="w-descp celda-vacia"></td>
                                        <td class="w-areap celda-vacia"></td>
                                        <td class="w-respp celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-estado celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-eficaz celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-verif celda-vacia"></td>
                                    }
                                    else if (plans.Count > 0)
                                    {
                                        <td class="w-codp">@foreach (var p in plans) { <div class="item-sep">@p.CodigoPlan</div> }</td>
                                        <td class="w-descp">@foreach (var p in plans) { <div class="cs item-sep">@p.DescripcionPlan</div> }</td>
                                        <td class="w-areap">@foreach (var p in plans) { <div class="cs item-sep">@p.AreaResponsable</div> }</td>
                                        <td class="w-respp">@foreach (var p in plans) { <div class="cs item-sep">@p.ResponsablePlan</div> }</td>
                                        <td class="w-fecha nw">@foreach (var p in plans) { <div class="item-sep">@(p.InicioPlan?.ToString("dd/MM/yyyy") ?? "")</div> }</td>
                                        <td class="w-estado">
                                            @foreach (var p in plans)
                                            {
                                                var ec = p.EstadoPlan switch { "Concluido" => "badge-estado-concluido", "En proceso" => "badge-estado-proceso", _ => "badge-estado-noiniciado" };
                                                <div class="item-sep"><span class="@ec">@p.EstadoPlan</span></div>
                                            }
                                        </td>
                                        <td class="w-fecha nw">@foreach (var p in plans) { <div class="item-sep">@(p.FinPlan?.ToString("dd/MM/yyyy") ?? "")</div> }</td>
                                        <td class="w-fecha nw">@foreach (var p in plans) { <div class="item-sep">@(p.FechaPrevista?.ToString("dd/MM/yyyy") ?? "")</div> }</td>
                                        <td class="w-eficaz">@foreach (var p in plans) { <div class="item-sep">@p.PlanEficaz</div> }</td>
                                        <td class="w-fecha nw">@foreach (var p in plans) { <div class="item-sep">@(p.FechaVerificacion?.ToString("dd/MM/yyyy") ?? "")</div> }</td>
                                        <td class="w-verif">@foreach (var p in plans) { <div class="cs item-sep">@p.VerificadoPor</div> }</td>
                                    }
                                    else
                                    {
                                        <td class="w-codp celda-vacia"></td>
                                        <td class="w-descp celda-vacia"></td>
                                        <td class="w-areap celda-vacia"></td>
                                        <td class="w-respp celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-estado celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-eficaz celda-vacia"></td>
                                        <td class="w-fecha celda-vacia"></td>
                                        <td class="w-verif celda-vacia"></td>
                                    }
                                    @* ── INDICADORES KRI — apilados en divs ── *@
                                    @if (kris.Count > 0)
                                    {
                                        <td class="w-codk">@foreach (var k in kris) { <div class="item-sep"><strong>@k.CodigoKRI</strong></div> }</td>
                                        <td class="w-defk">@foreach (var k in kris) { <div class="cs item-sep">@k.DefinicionKRI</div> }</td>
                                        <td class="w-frecuenk">@foreach (var k in kris) { <div class="item-sep">@k.Frecuencia</div> }</td>
                                        <td class="w-meta">@foreach (var k in kris) { <div class="item-sep" style="white-space:pre-line;">@k.MetaKRI</div> }</td>
                                        <td class="w-actual">@foreach (var k in kris) { <div class="item-sep">@k.KRIActual</div> }</td>
                                        <td class="w-respk">@foreach (var k in kris) { <div class="cs item-sep">@k.ResponsableKRI</div> }</td>
                                    }
                                    else
                                    {
                                        <td class="w-codk celda-vacia"></td>
                                        <td class="w-defk celda-vacia"></td>
                                        <td class="w-frecuenk celda-vacia"></td>
                                        <td class="w-meta celda-vacia"></td>
                                        <td class="w-actual celda-vacia"></td>
                                        <td class="w-respk celda-vacia"></td>
                                    }
                                    @* ── ACCIONES ── *@
                                    <td class="w-acc tc">
                                        @if (PeriodoSel?.Estado == "Activo" && !EsModoSoloLectura)
                                        {
                                            <button class="btn btn-xs btn-info mr-1" title="Editar" @onclick="() => EditarSnapshotRiesgo(r)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger"    title="Eliminar" @onclick="() => EliminarSnapshotRiesgo(r.Id)"><i class="fas fa-trash"></i></button>
                                        }
                                        else if (EsModoValidacion)
                                        {
                                            <span title="Solo lectura — Validación" style="color:#28a745;"><i class="fas fa-eye"></i></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" title="Periodo cerrado"><i class="fas fa-lock"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    <!-- ══ MAPA DE CALOR ══ -->
    @if (MostrarHeatmap && MatrizActual != null && SnapshotActual != null)
    {
        <div class="row mb-3"><div class="col-12"><button class="btn btn-secondary" @onclick="() => MostrarHeatmap = false"><i class="fas fa-arrow-left mr-1"></i> Regresar</button></div></div>
        <div class="row">
            <div class="col-md-6">
                <div class="card"><div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;"><h5 class="mb-0"><i class="fas fa-chart-bar mr-2"></i>Riesgo Inherente</h5></div><div class="card-body p-2">@RenderHeatmapSnapshot(true)</div></div>
            </div>
            <div class="col-md-6">
                <div class="card"><div class="card-header text-white" style="background:#003B70;border-bottom:2px solid #FFDD00;"><h5 class="mb-0"><i class="fas fa-chart-bar mr-2"></i>Riesgo Residual</h5></div><div class="card-body p-2">@RenderHeatmapSnapshot(false)</div></div>
            </div>
        </div>
    }

    <!-- ══ FORMULARIO EDICIÓN ══ -->
    @if (MostrarFormulario && PeriodoSel?.Estado == "Activo" && !EsModoSoloLectura)
    {
        <div class="card card-outline" style="border-top:3px solid #0062B8;">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-edit mr-2"></i>
                    @(RiesgoSnap.Id == 0 ? "Nuevo Registro" : "Editando: " + RiesgoSnap.CodigoRiesgo)
                    @if (MatrizActual != null) { <small class="ml-2 text-muted">— @MatrizActual.CodigoProceso @MatrizActual.NombreProceso</small> }
                    @if (PeriodoSel != null)  { <span class="version-chip ml-2">P-@(PeriodoSel.NumeroPeriodo) V@(PeriodoSel.Version)</span> }
                </h3>
                <div class="card-tools"><button class="btn btn-secondary btn-sm" @onclick="Cancelar"><i class="fas fa-times mr-1"></i> Cancelar</button></div>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-tabs nav-fill" style="background:#f8f9fa;border-bottom:2px solid #0062B8;">
                    <li class="nav-item"><a class="nav-link @(TabActivo==1?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=1" @onclick:preventDefault><i class="fas fa-info-circle mr-1"></i>DATOS GENERALES</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==2?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=2" @onclick:preventDefault><i class="fas fa-chart-bar mr-1"></i>RIESGO INHERENTE</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==3?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=3" @onclick:preventDefault><i class="fas fa-shield-alt mr-1"></i>CONTROL</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==4?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=4" @onclick:preventDefault><i class="fas fa-chart-line mr-1"></i>RIESGO RESIDUAL</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==5?"active font-weight-bold":"")" href="#" @onclick="()=>TabActivo=5" @onclick:preventDefault><i class="fas fa-tasks mr-1"></i>PLAN DE ACCION</a></li>
                    <li class="nav-item"><a class="nav-link @(TabActivo==6?"active font-weight-bold":"")" href="#" @onclick="IrTab6" @onclick:preventDefault><i class="fas fa-tachometer-alt mr-1"></i>INDICADORES</a></li>
                </ul>
                <div class="p-4">
                    @if (!string.IsNullOrEmpty(MsgGuardar))
                    {
                        <div class="alert alert-@(GuardarOk?"success":"danger")"><i class="fas fa-@(GuardarOk?"check":"exclamation")-circle mr-2"></i>@MsgGuardar</div>
                    }

                    @if (TabActivo == 1)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;"><h5 class="mb-0"><i class="fas fa-info-circle mr-2"></i>DATOS GENERALES DEL RIESGO</h5></div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3"><div class="form-group"><label><strong>COD</strong></label><input class="form-control bg-light font-weight-bold" value="@RiesgoSnap.CodigoProceso" readonly /></div></div>
                                    <div class="col-md-2"><div class="form-group"><label><strong>Nivel</strong></label><input class="form-control bg-light" value="Proceso" readonly /></div></div>
                                    <div class="col-md-4"><div class="form-group"><label><strong>Gerencia Responsable</strong></label>
                                        <select class="form-control" @onchange="e => RiesgoSnap.GerenciaResponsable = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var area in AreasActivas) { <option value="@area.Nombre" selected="@(RiesgoSnap.GerenciaResponsable == area.Nombre)">@area.Categoria - @area.Nombre</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group"><label><strong>Código del Riesgo</strong></label><input class="form-control bg-light" value="@RiesgoSnap.CodigoRiesgo" readonly /></div></div>
                                    <div class="col-md-6"><div class="form-group"><label><strong>Nombre del Proceso</strong></label><input class="form-control bg-light" value="@RiesgoSnap.NombreProceso" readonly /></div></div>
                                    <div class="col-md-6"><div class="form-group"><label><strong>Subproceso</strong></label>
                                        <input class="form-control" list="subprocesos-snap" value="@RiesgoSnap.Subproceso" @oninput="e => RiesgoSnap.Subproceso = e.Value?.ToString() ?? string.Empty" />
                                        <datalist id="subprocesos-snap">@foreach (var sub in SubprocesosDisponibles) { <option value="@sub.Nombre">@sub.Codigo - @sub.Nombre</option> }</datalist>
                                    </div></div>
                                    <div class="col-md-4"><div class="form-group"><label><strong>Origen del Riesgo</strong></label>
                                        <select class="form-control" @onchange="e => RiesgoSnap.OrigenRiesgo = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var op in OpcionesParametro("OrigenRiesgo")) { <option value="@op" selected="@(RiesgoSnap.OrigenRiesgo==op)">@op</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-md-4"><div class="form-group"><label><strong>Frecuencia del Riesgo</strong></label>
                                        <select class="form-control" @onchange="e => RiesgoSnap.FrecuenciaRiesgo = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var op in OpcionesParametro("FrecuenciaRiesgo")) { <option value="@op" selected="@(RiesgoSnap.FrecuenciaRiesgo==op)">@op</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-md-4"><div class="form-group"><label><strong>Tipo de Riesgo</strong></label>
                                        <select class="form-control" @onchange="e => RiesgoSnap.TipoRiesgo = e.Value?.ToString() ?? string.Empty">
                                            <option value="">-- Selecciona --</option>
                                            @foreach (var op in OpcionesParametro("TipoRiesgo")) { <option value="@op" selected="@(RiesgoSnap.TipoRiesgo==op)">@op</option> }
                                        </select>
                                    </div></div>
                                    <div class="col-12"><div class="form-group"><label><strong>Descripción del Riesgo</strong></label>
                                        <textarea class="form-control" rows="3" @oninput="e => RiesgoSnap.DescripcionRiesgo = e.Value?.ToString() ?? string.Empty">@RiesgoSnap.DescripcionRiesgo</textarea>
                                    </div></div>
                                </div>
                            </div>
                            <div class="card-footer text-right"><button class="btn btn-primary" @onclick="() => TabActivo = 2"><i class="fas fa-arrow-right mr-1"></i> Continuar</button></div>
                        </div>
                    }

                    @if (TabActivo == 2)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;"><h5 class="mb-0">EVALUACION DE RIESGO INHERENTE</h5></div>
                            <div class="card-body">
                                <div class="row justify-content-center">
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Probabilidad (1-4)</strong></label>
                                        <select class="form-control form-control-lg text-center" @onchange="OnProbInhChange">@for (int i=1;i<=4;i++) { <option value="@i" selected="@(RiesgoSnap.ProbabilidadInherente==i)">@i</option> }</select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Impacto (1-4)</strong></label>
                                        <select class="form-control form-control-lg text-center" @onchange="OnImpInhChange">@for (int i=1;i<=4;i++) { <option value="@i" selected="@(RiesgoSnap.ImpactoInherente==i)">@i</option> }</select>
                                    </div></div>
                                    <div class="col-md-3"><div class="form-group text-center"><label><strong>Severidad</strong></label>
                                        <div class="p-3 rounded text-white text-center" style="background:@ColorInh;font-size:2rem;font-weight:bold;">@SevInh<br/><small style="font-size:1rem;">@NivInh</small></div>
                                    </div></div>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-secondary" @onclick="() => TabActivo=1"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                <button class="btn btn-primary"   @onclick="() => TabActivo=3">Continuar <i class="fas fa-arrow-right ml-1"></i></button>
                            </div>
                        </div>
                    }

                    @if (TabActivo == 3)
                    {
                        <div class="card">
                            <div class="card-header text-white" style="background:#0062B8;border-bottom:2px solid #FFDD00;"><h5 class="mb-0">CONTROL</h5></div>
                            <div class="card-body">
                                <div class="mb-3"><button class="btn btn-success" @onclick="AgregarControl"><i class="fas fa-plus mr-1"></i> Agregar Control</button></div>
