                                                    <div class="col-md-4"><div class="form-group"><label><strong>Área Responsable</strong></label>
                                                        <select class="form-control" @onchange="e => plan.AreaResponsable = e.Value?.ToString() ?? string.Empty">
                                                            <option value="">-- Selecciona --</option>
                                                            @foreach (var area in AreasActivas) { <option value="@area.Nombre" selected="@(plan.AreaResponsable==area.Nombre)">@area.Categoria - @area.Nombre</option> }
                                                        </select>
                                                    </div></div>
                                                    <div class="col-md-4"><div class="form-group"><label><strong>Responsable</strong></label><input class="form-control" value="@plan.ResponsablePlan" @oninput="e => plan.ResponsablePlan = e.Value?.ToString() ?? string.Empty" /></div></div>
                                                    <div class="col-md-4"><div class="form-group"><label><strong>Estado</strong></label>
                                                        <select class="form-control" @onchange="e => plan.EstadoPlan = e.Value?.ToString() ?? string.Empty">
                                                            @foreach (var op in OpcionesParametro("EstadoPlan")) { <option value="@op" selected="@(plan.EstadoPlan==op)">@op</option> }
                                                        </select>
                                                    </div></div>
                                                    <div class="col-md-6"><div class="form-group"><label><strong>Inicio</strong></label><input type="date" class="form-control" value="@(plan.InicioPlan?.ToString("yyyy-MM-dd")??"" )" @onchange="e => plan.InicioPlan = DateTime.TryParse(e.Value?.ToString(),out var d)?d:(DateTime?)null" /></div></div>
                                                    <div class="col-md-6"><div class="form-group"><label><strong>Fin</strong></label><input type="date" class="form-control" value="@(plan.FinPlan?.ToString("yyyy-MM-dd")??"" )" @onchange="e => plan.FinPlan = DateTime.TryParse(e.Value?.ToString(),out var d2)?d2:(DateTime?)null" /></div></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
