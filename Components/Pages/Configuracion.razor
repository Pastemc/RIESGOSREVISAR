                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" @onclick="CerrarModalAprobar">Cancelar</button>
                    <button class="btn btn-success font-weight-bold px-4" @onclick="ConfirmarAprobacionUsuario">
                        <i class="fas fa-check-circle mr-2"></i>Aprobar y Notificar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<Usuario> Todos = new();
    List<Usuario> Pendientes = new();
    List<Usuario> Personal = new();
    List<MatrizGrupo> TodasMatrices = new();
    List<int> MatricesAsignadas = new();
    List<UsuarioMatriz> AsignacionesGlobales = new();
    List<CambioPassword> Cambios = new();

    bool MostrarModalAprobar = false;
    Usuario? UsuarioAprobar;
    string RolAprobar = "Personal";
    string MotivoAprobar = "";
    List<MatrizGrupo> MatricesProcesosAprobar = new();
    List<int> MatricesSeleccionadasAprobar = new();

    int SubTabMaestra = 1;
    string MsgMaestras = "";
    List<MaestroProceso> MaestroProcesos = new();
    List<MaestroArea> MaestroAreas = new();
    List<MaestroTipoRiesgo> MaestroTiposRiesgo = new();
    List<MaestroParametro> MaestroParametros = new();
    List<BitacoraDepartamentoGerencia> BitacoraAreas = new();

    MaestroProceso FormProceso = new();
    MaestroArea FormArea = new();
    MaestroTipoRiesgo FormTipoRiesgo = new();
    MaestroParametro FormParametro = new();
    string MotivoCambioArea = "";
    bool MostrarModalBitacoraAreas = false;

    int TabActivo = 1;
    int PersonalSeleccionadoId = 0;
    int UsuarioSeleccionadoHistorialId = 0;
    string MsgAsignacion = "";
    bool AsignOk = false;

    protected override async Task OnInitializedAsync() => await Cargar();

    async Task Cargar()
    {
        Todos     = await UsuarioSvc.GetTodosAsync();
        Pendientes= Todos.Where(u => !u.Activo && u.Rol != "SuperAdmin").ToList();
        Personal  = await UsuarioSvc.GetPersonalAsync();
        TodasMatrices = await RiesgoSvc.GetMatricesAsync();
        AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
        await CargarMaestras();
    }

    async Task SeleccionarTab(int tab)
    {
        TabActivo = tab;
        if (tab == 1) await Cargar();
        else if (tab == 2)
        {
            Personal = await UsuarioSvc.GetPersonalAsync();
            TodasMatrices = await RiesgoSvc.GetMatricesAsync();
            AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
            if (PersonalSeleccionadoId == 0 && Personal.Any())
                await SeleccionarPersonal(Personal.First().Id);
        }
        else if (tab == 3) Todos = await UsuarioSvc.GetTodosAsync();
        else if (tab == 4) await CargarMaestras();
        StateHasChanged();
    }

    async Task CargarMaestras()
    {
        MaestroProcesos   = await RiesgoSvc.GetMaestroProcesosAsync();
        MaestroAreas      = await RiesgoSvc.GetMaestroAreasAsync();
        MaestroTiposRiesgo= await RiesgoSvc.GetMaestroTiposRiesgoAsync();
        MaestroParametros = await RiesgoSvc.GetMaestroParametrosAsync();
        BitacoraAreas     = await RiesgoSvc.GetBitacoraDepartamentoGerenciasAsync();
    }

    void AbrirModalBitacoraAreas()  => MostrarModalBitacoraAreas = true;
    void CerrarModalBitacoraAreas() => MostrarModalBitacoraAreas = false;

    void ResetFormProceso() => FormProceso = new();
    void EditarProceso(MaestroProceso item) => FormProceso = new MaestroProceso
    {
        Id=item.Id, Codigo=item.Codigo, Nombre=item.Nombre, Macroproceso=item.Macroproceso,
        Nivel=item.Nivel, AreaResponsableDefault=item.AreaResponsableDefault,
        PadreId=item.PadreId, AreaResponsableId=item.AreaResponsableId,
        ResponsableId=item.ResponsableId, Objetivo=item.Objetivo,
        Descripcion=item.Descripcion, Activo=item.Activo, Orden=item.Orden
    };
    async Task GuardarProceso()
    {
        if (string.IsNullOrWhiteSpace(FormProceso.Codigo) || string.IsNullOrWhiteSpace(FormProceso.Nombre)) return;
