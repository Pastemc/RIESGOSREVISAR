                        </div>

                        <!-- Barra de progreso del año -->
                        @{
                            var diaDelAnio   = DateTime.Now.DayOfYear;
                            var diasTotales  = DateTime.IsLeapYear(DateTime.Now.Year) ? 366 : 365;
                            var pctAnio      = (int)(diaDelAnio * 100.0 / diasTotales);
                            var colorBarra   = pctAnio < 33 ? "#28a745" : pctAnio < 66 ? "#ffc107" : "#fd7e14";
                        }
                        <div class="mt-4">
                            <div class="d-flex justify-content-between small text-muted mb-1">
