@page "/configuracion"
@layout MainLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@inject UsuarioService UsuarioSvc
@inject RiesgoService RiesgoSvc

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0"><i class="fas fa-cogs mr-2"></i>Panel de Administración SuperAdmin</h1>
            </div>
            <div class="col-sm-5">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active">Configuración</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 1 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(1)">
                <i class="fas fa-users-cog mr-1"></i>Usuarios Pendientes (@Pendientes.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 2 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(2)">
                <i class="fas fa-th-list mr-1"></i>Asignación de Matrices
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 3 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(3)">
                <i class="fas fa-key mr-1"></i>Historial Contraseñas
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 4 ? "active font-weight-bold text-primary" : "")"
                    @onclick="() => SeleccionarTab(4)">
                <i class="fas fa-sitemap mr-1"></i>🏛️ Tablas Maestras GRC
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 5 ? "active font-weight-bold text-warning" : "")"
                    @onclick="() => SeleccionarTab(5)">
                <i class="fas fa-calendar-alt mr-1"></i>📅 Periodo de Riesgo
            </button>
        </li>
    </ul>

    <!-- TAB 1: USUARIOS PENDIENTES Y PERSONAL -->
    @if (TabActivo == 1)
    {
        <div class="card card-warning card-outline mb-4">
            <div class="card-header">
                <h3 class="card-title text-warning">
                    <i class="fas fa-user-clock mr-2"></i>Solicitudes de Registro Pendientes
                </h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped">
                    <thead class="bg-warning">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Fecha Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Pendientes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    No hay solicitudes de registro pendientes de aprobación.
                                </td>
                            </tr>
                        }
                        @foreach (var u in Pendientes)
                        {
                            <tr>
                                <td><strong>@u.Nombre</strong></td>
                                <td>@u.Correo</td>
                                <td><span class="badge badge-info">@u.Rol</span></td>
                                <td>@u.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-success mr-1 font-weight-bold" @onclick="() => AbrirModalAprobar(u)">
                                        <i class="fas fa-user-check mr-1"></i>Aprobar...
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(u.Id)">
                                        <i class="fas fa-times mr-1"></i>Rechazar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card card-secondary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users mr-2"></i>Personal del Sistema (Admins)
                </h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped table-sm">
                    <thead class="bg-secondary">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Matrices Asignadas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Personal)
                        {
                            var countMatrices = AsignacionesGlobales.Count(a => a.UsuarioId == u.Id);
                            <tr>
                                <td><strong>@u.Nombre</strong></td>
                                <td>@u.Correo</td>
                                <td><span class="badge badge-primary">@u.Rol</span></td>
                                <td>
                                    <span class="badge badge-@(u.Activo ? "success" : "secondary")">
                                        @(u.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td><span class="badge badge-info">@countMatrices matriz(ces)</span></td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary mr-1"
                                            @onclick="() => SeleccionarPersonal(u.Id)">
                                        <i class="fas fa-th-list mr-1"></i>Gestionar Matrices
                                    </button>
                                    <button class="btn btn-xs btn-outline-warning mr-1"
                                            @onclick="() => Toggle(u.Id)">
                                        <i class="fas fa-sync-alt mr-1"></i>@(u.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 2: ASIGNACION DE MATRICES -->
    @if (TabActivo == 2)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user-tag mr-2"></i>1. Seleccionar Personal</h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="list-group">
                            @foreach (var p in Personal)
                            {
                                var sel = p.Id == PersonalSeleccionadoId;
                                var count = AsignacionesGlobales.Count(a => a.UsuarioId == p.Id);
                                <button class="list-group-item list-group-item-action p-2 @(sel ? "active" : "")"
                                        @onclick="() => SeleccionarPersonal(p.Id)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@p.Nombre</strong>
                                            <div class="small @(sel ? "text-white-50" : "text-muted")">@p.Correo — @p.Rol</div>
                                        </div>
                                        <span class="badge @(sel ? "badge-light text-primary" : "badge-primary")">@count</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                @if (PersonalSeleccionadoId == 0)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-arrow-left mr-2"></i>Selecciona un usuario a la izquierda para asignarle matrices.
                    </div>
                }
                else
                {
                    var uSel = Personal.FirstOrDefault(u => u.Id == PersonalSeleccionadoId);
                    <div class="card card-success card-outline">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title text-success mb-0">
                                <i class="fas fa-th-list mr-2"></i>Matrices de: <strong>@(uSel?.Nombre)</strong>
                            </h3>
                            <span class="badge badge-success">@MatricesAsignadas.Count / @TodasMatrices.Count asignadas</span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(MsgAsignacion))
                            {
                                <div class="alert alert-@(AsignOk ? "success" : "danger") py-2">
                                    <i class="fas fa-info-circle mr-1"></i>@MsgAsignacion
                                </div>
                            }
                            <div class="row">
                                @foreach (var m in TodasMatrices)
                                {
                                    var asignadaAEste = MatricesAsignadas.Contains(m.Id);
                                    var otrosAsignados = AsignacionesGlobales
                                        .Where(a => a.MatrizGrupoId == m.Id && a.UsuarioId != PersonalSeleccionadoId)
                                        .Select(a => Personal.FirstOrDefault(p => p.Id == a.UsuarioId)?.Nombre)
                                        .Where(n => n != null).ToList();
                                    <div class="col-md-6 mb-2">
                                        <div class="card mb-0 border @(asignadaAEste ? "border-success bg-light" : "")"
                                             style="border-left: 4px solid @(asignadaAEste ? "#28a745" : "#dc3545") !important;">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong class="@(asignadaAEste ? "text-success" : "")">
                                                            @m.CodigoProceso — @m.Nombre
                                                        </strong>
                                                        <small class="d-block text-muted" style="font-size:.75rem;">@m.NombreProceso</small>
                                                        @if (asignadaAEste)
                                                        {
                                                            <span class="badge badge-success mt-1"><i class="fas fa-check mr-1"></i>Asignada</span>
                                                        }
                                                        else if (otrosAsignados.Any())
                                                        {
                                                            <span class="badge badge-warning mt-1">En uso: @string.Join(", ", otrosAsignados)</span>
                                                        }
                                                    </div>
                                                    <div class="ml-2">
                                                        @if (asignadaAEste)
                                                        {
                                                            <button class="btn btn-sm btn-danger" @onclick="() => QuitarMatriz(m.Id)">
                                                                <i class="fas fa-times mr-1"></i>Quitar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => AsignarMatriz(m.Id)">
                                                                <i class="fas fa-plus mr-1"></i>Asignar
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <span class="text-muted"><strong>@MatricesAsignadas.Count</strong> de <strong>@TodasMatrices.Count</strong></span>
                            <div>
                                <button class="btn btn-success btn-sm mr-2" @onclick="AsignarTodas">
                                    <i class="fas fa-check-double mr-1"></i>Asignar Todas
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="QuitarTodas">
                                    <i class="fas fa-times mr-1"></i>Quitar Todas
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB 3: HISTORIAL CONTRASEÑAS -->
    @if (TabActivo == 3)
    {
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-key mr-2"></i>Historial de Cambios de Contraseña
                </h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="font-weight-bold">Seleccionar Usuario para Auditar</label>
                    <select class="form-control" @onchange="VerCambios">
                        <option value="">-- Selecciona un usuario --</option>
                        @foreach (var u in Todos)
                        {
                            <option value="@u.Id">@u.Nombre (@u.Correo) — @u.Rol</option>
                        }
                    </select>
                </div>
                @if (UsuarioSeleccionadoHistorialId > 0)
                {
                    @if (Cambios.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-striped border mb-0">
                                <thead class="bg-danger text-white">
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha y Hora</th>
                                        <th>Hash de Contraseña</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Cambios)
                                    {
                                        <tr>
                                            <td>@c.Id</td>
                                            <td>@c.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><code class="small text-muted">@c.PasswordHashNuevo</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3 py-2">
                            <i class="fas fa-info-circle mr-2"></i>El usuario no registra cambios de contraseña aún.
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted mt-2">
                        <i class="fas fa-hand-pointer mr-1"></i>Selecciona un usuario en el desplegable superior.
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB 4: TABLAS MAESTRAS -->
    @if (TabActivo == 4)
    {
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h3 class="card-title text-white mb-0">
                    <i class="fas fa-sitemap mr-2"></i>Gestión de Tablas Maestras (GRC / Pirani)
                </h3>
            </div>
            <div class="card-body p-3">
                <ul class="nav nav-pills mb-3">
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==1?"btn-primary":"btn-outline-primary") mr-2"
                                @onclick="()=>SubTabMaestra=1">
                            <i class="fas fa-layer-group mr-1"></i>Procesos (@MaestroProcesos.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==2?"btn-primary":"btn-outline-primary") mr-2"
                                @onclick="()=>SubTabMaestra=2">
                            <i class="fas fa-building mr-1"></i>Gerencias y Áreas (@MaestroAreas.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==3?"btn-primary":"btn-outline-primary") mr-2"
                                @onclick="()=>SubTabMaestra=3">
                            <i class="fas fa-exclamation-triangle mr-1"></i>Tipos de Riesgo (@MaestroTiposRiesgo.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==4?"btn-primary":"btn-outline-primary")"
                                @onclick="()=>SubTabMaestra=4">
                            <i class="fas fa-sliders-h mr-1"></i>Parámetros (@MaestroParametros.Count)
                        </button>
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(MsgMaestras))
                {
                    <div class="alert alert-success py-2 mb-3">
                        <i class="fas fa-check-circle mr-2"></i>@MsgMaestras
                    </div>
                }

                @if (SubTabMaestra == 1)
                {
                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormProceso.Id==0?"Nuevo Proceso":"Editando: "+FormProceso.Codigo)</strong>
                            @if (FormProceso.Id > 0) { <button class="btn btn-xs btn-secondary" @onclick="ResetFormProceso">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-2">
                                    <label class="small font-weight-bold">Código</label>
                                    <input @bind="FormProceso.Codigo" class="form-control form-control-sm" placeholder="Ej: E1.1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Nombre</label>
                                    <input @bind="FormProceso.Nombre" class="form-control form-control-sm" placeholder="Nombre completo" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Macroproceso</label>
                                    <select @bind="FormProceso.Macroproceso" class="form-control form-control-sm">
                                        <option value="ESTRATÉGICO">ESTRATÉGICO</option>
                                        <option value="OPERATIVO">OPERATIVO</option>
                                        <option value="SOPORTE">SOPORTE</option>
                                        <option value="EVALUACIÓN Y MEJORA CONTINUA">EVALUACIÓN Y MEJORA CONTINUA</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarProceso">
                                        <i class="fas fa-save mr-1"></i>Guardar
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormProceso">Limpiar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr><th>Cód</th><th>Nombre</th><th>Macroproceso</th><th class="text-center">Estado</th><th class="text-center">Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroProcesos)
                                {
                                    <tr>
                                        <td><strong>@item.Codigo</strong></td>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge badge-info">@item.Macroproceso</span></td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")"
                                                    @onclick="()=>ToggleEstadoProceso(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarProceso(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarProceso(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (SubTabMaestra == 2)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-sitemap mr-1"></i>Estructura Organizacional</h6>
                        <button class="btn btn-outline-info btn-sm" @onclick="AbrirModalBitacoraAreas">
                            <i class="fas fa-history mr-1"></i>📜 Bitácora (@BitacoraAreas.Count)
                        </button>
                    </div>
                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormArea.Id==0?"Nueva Unidad":"Editando: "+FormArea.Nombre)</strong>
                            @if (FormArea.Id > 0) { <button class="btn btn-xs btn-secondary" @onclick="ResetFormArea">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Categoría</label>
                                    <select @bind="FormArea.Categoria" class="form-control form-control-sm">
                                        <option value="GERENCIAS">GERENCIAS</option>
                                        <option value="OFICINAS">OFICINAS</option>
                                        <option value="DIRECTORIO">DIRECTORIO</option>
                                        <option value="DEPARTAMENTOS">DEPARTAMENTOS</option>
                                        <option value="OTROS">OTROS</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Nombre</label>
                                    <input @bind="FormArea.Nombre" class="form-control form-control-sm" placeholder="Ej: Gerencia Comercial" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Entidad Superior</label>
                                    <select @bind="FormArea.PadreId" class="form-control form-control-sm"
                                            disabled="@(FormArea.Categoria == "DIRECTORIO")">
                                        <option value="">-- Sin Superior --</option>
                                        @if (FormArea.Categoria == "DEPARTAMENTOS")
                                        {
                                            @foreach (var g in MaestroAreas.Where(a => a.Categoria == "GERENCIAS" || a.Categoria == "OFICINAS"))
                                            { <option value="@g.Id">🏢 @g.Nombre</option> }
                                        }
                                        else if (FormArea.Categoria is "GERENCIAS" or "OFICINAS" or "OTROS")
                                        {
                                            @foreach (var d in MaestroAreas.Where(a => a.Categoria == "DIRECTORIO"))
                                            { <option value="@d.Id">🏛️ @d.Nombre</option> }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarArea"><i class="fas fa-save mr-1"></i>Guardar</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormArea">Limpiar</button>
                                </div>
                                @if (FormArea.Id > 0 && FormArea.Categoria == "DEPARTAMENTOS")
                                {
                                    <div class="col-md-12 mt-2">
                                        <label class="small font-weight-bold text-info">Motivo de Reestructuración (Bitácora)</label>
                                        <input @bind="MotivoCambioArea" class="form-control form-control-sm"
                                               placeholder="Ej: Reorganización según Resolución N° 045-2026" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr><th>Categoría</th><th>Nombre</th><th>Superior</th><th class="text-center">Estado</th><th class="text-center">Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroAreas)
                                {
                                    <tr>
                                        <td><span class="badge @(item.Categoria=="DIRECTORIO"?"badge-dark":item.Categoria=="GERENCIAS"?"badge-primary":"badge-info")">@item.Categoria</span></td>
                                        <td><strong>@item.Nombre</strong></td>
                                        <td>@if(item.Padre!=null){<span class="badge badge-light border">@item.Padre.Nombre</span>}else{<small class="text-muted">Raíz</small>}</td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")" @onclick="()=>ToggleEstadoArea(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarArea(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarArea(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

