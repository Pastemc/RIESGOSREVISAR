@page "/configuracion"
@layout MainLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@inject UsuarioService UsuarioSvc
@inject RiesgoService RiesgoSvc

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0"><i class="fas fa-cogs mr-2"></i>Panel de Administración SuperAdmin</h1>
            </div>
            <div class="col-sm-5">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active">Configuración</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 1 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(1)">
                <i class="fas fa-users-cog mr-1"></i>Usuarios Pendientes (@Pendientes.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 2 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(2)">
                <i class="fas fa-th-list mr-1"></i>Asignación de Matrices
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 3 ? "active font-weight-bold" : "")"
                    @onclick="() => SeleccionarTab(3)">
                <i class="fas fa-key mr-1"></i>Historial Contraseñas
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link btn btn-link @(TabActivo == 4 ? "active font-weight-bold text-primary" : "")"
                    @onclick="() => SeleccionarTab(4)">
                <i class="fas fa-sitemap mr-1"></i>🏛️ Tablas Maestras GRC
            </button>
        </li>
    </ul>

    <!-- TAB 1: USUARIOS PENDIENTES Y PERSONAL -->
    @if (TabActivo == 1)
    {
        <div class="card card-warning card-outline mb-4">
            <div class="card-header">
                <h3 class="card-title text-warning">
                    <i class="fas fa-user-clock mr-2"></i>Solicitudes de Registro Pendientes
                </h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped">
                    <thead class="bg-warning">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Fecha Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Pendientes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    No hay solicitudes de registro pendientes de aprobación.
                                </td>
                            </tr>
                        }
                        @foreach (var u in Pendientes)
                        {
                            <tr>
                                <td><strong>@u.Nombre</strong></td>
                                <td>@u.Correo</td>
                                <td><span class="badge badge-info">@u.Rol</span></td>
                                <td>@u.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-success mr-1 font-weight-bold" @onclick="() => AbrirModalAprobar(u)">
                                        <i class="fas fa-user-check mr-1"></i>Aprobar...
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(u.Id)">
                                        <i class="fas fa-times mr-1"></i>Rechazar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card card-secondary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users mr-2"></i>Personal del Sistema (Admins)
                </h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped table-sm">
                    <thead class="bg-secondary">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Matrices Asignadas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Personal)
                        {
                            var countMatrices = AsignacionesGlobales.Count(a => a.UsuarioId == u.Id);
                            <tr>
                                <td><strong>@u.Nombre</strong></td>
                                <td>@u.Correo</td>
                                <td><span class="badge badge-primary">@u.Rol</span></td>
                                <td>
                                    <span class="badge badge-@(u.Activo ? "success" : "secondary")">
                                        @(u.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-info">@countMatrices matriz(ces)</span>
                                </td>
                                <td>
                                    <button class="btn btn-xs btn-outline-primary mr-1"
                                            @onclick="() => SeleccionarPersonal(u.Id)">
                                        <i class="fas fa-th-list mr-1"></i>Gestionar Matrices
                                    </button>
                                    <button class="btn btn-xs btn-outline-warning mr-1"
                                            @onclick="() => Toggle(u.Id)">
                                        <i class="fas fa-sync-alt mr-1"></i>@(u.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 2: ASIGNACION DE MATRICES -->
    @if (TabActivo == 2)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-tag mr-2"></i>1. Seleccionar Personal
                        </h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="list-group">
                            @foreach (var p in Personal)
                            {
                                var sel = p.Id == PersonalSeleccionadoId;
                                var count = AsignacionesGlobales.Count(a => a.UsuarioId == p.Id);
                                <button class="list-group-item list-group-item-action p-2 @(sel ? "active" : "")"
                                        @onclick="() => SeleccionarPersonal(p.Id)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@p.Nombre</strong>
                                            <div class="small @(sel ? "text-white-50" : "text-muted")">@p.Correo — @p.Rol</div>
                                        </div>
                                        <span class="badge @(sel ? "badge-light text-primary" : "badge-primary")">
                                            @count
                                        </span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                @if (PersonalSeleccionadoId == 0)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-arrow-left mr-2"></i>Selecciona un usuario a la izquierda para asignarle matrices de riesgo.
                    </div>
                }
                else
                {
                    var uSel = Personal.FirstOrDefault(u => u.Id == PersonalSeleccionadoId);
                    <div class="card card-success card-outline">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title text-success mb-0">
                                <i class="fas fa-th-list mr-2"></i>Matrices asignadas a: <strong>@(uSel?.Nombre)</strong>
                            </h3>
                            <div>
                                <span class="badge badge-success font-weight-normal px-2 py-1">
                                    @MatricesAsignadas.Count de @TodasMatrices.Count matrices asignadas
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(MsgAsignacion))
                            {
                                <div class="alert alert-@(AsignOk ? "success" : "danger") py-2">
                                    <i class="fas fa-info-circle mr-1"></i>@MsgAsignacion
                                </div>
                            }

                            <div class="row">
                                @foreach (var m in TodasMatrices)
                                {
                                    var asignadaAEste = MatricesAsignadas.Contains(m.Id);
                                    var otrosAsignados = AsignacionesGlobales
                                    .Where(a => a.MatrizGrupoId == m.Id && a.UsuarioId != PersonalSeleccionadoId)
                                    .Select(a => Personal.FirstOrDefault(p => p.Id == a.UsuarioId)?.Nombre)
                                    .Where(n => n != null)
                                    .ToList();

                                    <div class="col-md-6 mb-2">
                                        <div class="card mb-0 border @(asignadaAEste ? "border-success bg-light" : "")"
                                             style="border-left: 4px solid @(asignadaAEste ? "#28a745" : "#dc3545") !important;">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong class="@(asignadaAEste ? "text-success" : "")">
                                                            @m.CodigoProceso — @m.Nombre
                                                        </strong>
                                                        <small class="d-block text-muted" style="font-size:0.75rem;">
                                                            @m.NombreProceso
                                                        </small>
                                                        @if (asignadaAEste)
                                                        {
                                                            <span class="badge badge-success mt-1">
                                                                <i class="fas fa-check mr-1"></i>Asignada
                                                            </span>
                                                        }
                                                        else if (otrosAsignados.Any())
                                                        {
                                                            <span class="badge badge-warning mt-1" title="@string.Join(", ", otrosAsignados)">
                                                                <i class="fas fa-user mr-1"></i>En uso: @string.Join(", ", otrosAsignados)
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="ml-2">
                                                        @if (asignadaAEste)
                                                        {
                                                            <button class="btn btn-sm btn-danger" @onclick="() => QuitarMatriz(m.Id)">
                                                                <i class="fas fa-times mr-1"></i>Quitar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => AsignarMatriz(m.Id)">
                                                                <i class="fas fa-plus mr-1"></i>Asignar
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <span class="text-muted">
                                <strong>@MatricesAsignadas.Count</strong> de <strong>@TodasMatrices.Count</strong> asignadas
                            </span>
                            <div>
                                <button class="btn btn-success btn-sm mr-2" @onclick="AsignarTodas">
                                    <i class="fas fa-check-double mr-1"></i> Asignar Todas
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="QuitarTodas">
                                    <i class="fas fa-times mr-1"></i> Quitar Todas
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB 3: HISTORIAL CONTRASEÑAS -->
    @if (TabActivo == 3)
    {
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-key mr-2"></i>Historial de Cambios de Contraseña
                </h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="font-weight-bold">Seleccionar Usuario para Auditar</label>
                    <select class="form-control" @onchange="VerCambios">
                        <option value="">-- Selecciona un usuario --</option>
                        @foreach (var u in Todos)
                        {
                            <option value="@u.Id">
                                @u.Nombre (@u.Correo) — @u.Rol
                            </option>
                        }
                    </select>
                </div>
                @if (UsuarioSeleccionadoHistorialId > 0)
                {
                    @if (Cambios.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-striped border mb-0">
                                <thead class="bg-danger text-white">
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha y Hora</th>
                                        <th>Hash de Contraseña</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Cambios)
                                    {
                                        <tr>
                                            <td>@c.Id</td>
                                            <td>@c.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><code class="small text-muted">@c.PasswordHashNuevo</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3 py-2">
                            <i class="fas fa-info-circle mr-2"></i>El usuario seleccionado no registra cambios de contraseña en la bitácora todavía.
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted mt-2">
                        <i class="fas fa-hand-pointer mr-1"></i>Selecciona un usuario en el desplegable superior para auditar sus cambios de clave.
                    </div>
                }
            </div>
        </div>
    }

    <!-- TAB 4: TABLAS MAESTRAS (GRC / PIRANI ALIGNMENT) -->
    @if (TabActivo == 4)
    {
        <div class="card card-primary card-outline">
            <div class="card-header d-flex justify-content-between align-items-center" style="background:#0062B8;border-bottom:2px solid #FFDD00;">
                <h3 class="card-title text-white mb-0">
                    <i class="fas fa-sitemap mr-2"></i>Gestión de Tablas Maestras (GRC / Pirani)
                </h3>
            </div>
            <div class="card-body p-3">

                <!-- Sub-navegación de maestras -->
                <ul class="nav nav-pills mb-3">
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==1?"btn-primary":"btn-outline-primary") mr-2" @onclick="()=>SubTabMaestra=1">
                            <i class="fas fa-layer-group mr-1"></i>Procesos y Subprocesos (@MaestroProcesos.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==2?"btn-primary":"btn-outline-primary") mr-2" @onclick="()=>SubTabMaestra=2">
                            <i class="fas fa-building mr-1"></i>Gerencias y Áreas (@MaestroAreas.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==3?"btn-primary":"btn-outline-primary") mr-2" @onclick="()=>SubTabMaestra=3">
                            <i class="fas fa-exclamation-triangle mr-1"></i>Tipos de Riesgo (@MaestroTiposRiesgo.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm @(SubTabMaestra==4?"btn-primary":"btn-outline-primary")" @onclick="()=>SubTabMaestra=4">
                            <i class="fas fa-sliders-h mr-1"></i>Parámetros de Control y Estrategia (@MaestroParametros.Count)
                        </button>
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(MsgMaestras))
                {
                    <div class="alert alert-success py-2 mb-3">
                        <i class="fas fa-check-circle mr-2"></i>@MsgMaestras
                    </div>
                }

                <!-- SUB-TAB 1: PROCESOS -->
                @if (SubTabMaestra == 1)
                {
                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormProceso.Id==0?"Nuevo Proceso/Subproceso":"Editando Proceso: "+FormProceso.Codigo)</strong>
                            @if (FormProceso.Id > 0)
                            { <button class="btn btn-xs btn-secondary" @onclick="ResetFormProceso">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-2">
                                    <label class="small font-weight-bold">Código</label>
                                    <input @bind="FormProceso.Codigo" class="form-control form-control-sm" placeholder="Ej: E1.1 / O2.1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Nombre del Proceso</label>
                                    <input @bind="FormProceso.Nombre" class="form-control form-control-sm" placeholder="Nombre completo" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Macroproceso</label>
                                    <select @bind="FormProceso.Macroproceso" class="form-control form-control-sm">
                                        <option value="ESTRATÉGICO">ESTRATÉGICO</option>
                                        <option value="OPERATIVO">OPERATIVO</option>
                                        <option value="SOPORTE">SOPORTE</option>
                                        <option value="EVALUACIÓN Y MEJORA CONTINUA">EVALUACIÓN Y MEJORA CONTINUA</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarProceso">
                                        <i class="fas fa-save mr-1"></i> Guardar
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormProceso">Limpiar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>Cód</th>
                                    <th>Nombre del Proceso</th>
                                    <th>Macroproceso</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroProcesos)
                                {
                                    <tr>
                                        <td><strong>@item.Codigo</strong></td>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge badge-info">@item.Macroproceso</span></td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")" @onclick="()=>ToggleEstadoProceso(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarProceso(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarProceso(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- SUB-TAB 2: GERENCIAS Y DEPARTAMENTOS -->
                @if (SubTabMaestra == 2)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-sitemap mr-1"></i>Estructura Organizacional (Directorio -> Gerencia -> Departamento)</h6>
                        <button class="btn btn-outline-info btn-sm" @onclick="AbrirModalBitacoraAreas">
                            <i class="fas fa-history mr-1"></i>📜 Bitácora de Movimiento de Departamentos (@BitacoraAreas.Count)
                        </button>
                    </div>

                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormArea.Id==0?"Nueva Unidad Organizacional":"Editando: "+FormArea.Nombre)</strong>
                            @if (FormArea.Id > 0)
                            { <button class="btn btn-xs btn-secondary" @onclick="ResetFormArea">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Categoría</label>
                                    <select @bind="FormArea.Categoria" class="form-control form-control-sm">
                                        <option value="GERENCIAS">GERENCIAS</option>
                                        <option value="OFICINAS">OFICINAS</option>
                                        <option value="DIRECTORIO">DIRECTORIO</option>
                                        <option value="DEPARTAMENTOS">DEPARTAMENTOS</option>
                                        <option value="OTROS">OTROS</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Nombre del Área / Unidad</label>
                                    <input @bind="FormArea.Nombre" class="form-control form-control-sm" placeholder="Ej: Gerencia Comercial, Dpto. de TIC" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">
                                        @(FormArea.Categoria == "DIRECTORIO" ? "Entidad Superior (N/A)" : FormArea.Categoria == "DEPARTAMENTOS" ? "Gerencia Superior Padre" : "Directorio Superior Padre")
                                    </label>
                                    <select @bind="FormArea.PadreId" class="form-control form-control-sm" disabled="@(FormArea.Categoria == "DIRECTORIO")">
                                        <option value="">-- Sin Entidad Superior (Nivel Raíz) --</option>
                                        @if (FormArea.Categoria == "DEPARTAMENTOS")
                                        {
                                            @foreach (var g in MaestroAreas.Where(a => a.Categoria == "GERENCIAS" || a.Categoria == "OFICINAS"))
                                            {
                                                <option value="@g.Id">🏢 @g.Nombre</option>
                                            }
                                        }
                                        else if (FormArea.Categoria == "GERENCIAS" || FormArea.Categoria == "OFICINAS" || FormArea.Categoria == "OTROS")
                                        {
                                            @foreach (var d in MaestroAreas.Where(a => a.Categoria == "DIRECTORIO"))
                                            {
                                                <option value="@d.Id">🏛️ @d.Nombre</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarArea">
                                        <i class="fas fa-save mr-1"></i> Guardar
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormArea">Limpiar</button>
                                </div>
                                @if (FormArea.Id > 0 && FormArea.Categoria == "DEPARTAMENTOS")
                                {
                                    <div class="col-md-12 mt-2">
                                        <div class="form-group mb-0">
                                            <label class="small font-weight-bold text-info"><i class="fas fa-comment-alt mr-1"></i>Motivo de Reestructuración / Cambio de Gerencia (Bitácora)</label>
                                            <input @bind="MotivoCambioArea" class="form-control form-control-sm" placeholder="Ej: Reorganización según Resolución N° 045-2026-ELOR" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>Categoría</th>
                                    <th>Nombre del Área / Unidad Responsable</th>
                                    <th>Gerencia / Entidad Superior Padre</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroAreas)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(item.Categoria=="DIRECTORIO"?"badge-dark":item.Categoria=="GERENCIAS"?"badge-primary":"badge-info")">
                                                @item.Categoria
                                            </span>
                                        </td>
                                        <td><strong>@item.Nombre</strong></td>
                                        <td>
                                            @if (item.Padre != null)
                                            {
                                                <span class="badge badge-light border">
                                                    <i class="fas fa-arrow-up mr-1 text-primary"></i>@item.Padre.Nombre
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><em>Nivel Raíz Superior</em></span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")" @onclick="()=>ToggleEstadoArea(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarArea(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarArea(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- SUB-TAB 3: TIPOS DE RIESGO -->
                @if (SubTabMaestra == 3)
                {
                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormTipoRiesgo.Id==0?"Nuevo Tipo de Riesgo (GRC)":"Editando: "+FormTipoRiesgo.Nombre)</strong>
                            @if (FormTipoRiesgo.Id > 0)
                            { <button class="btn btn-xs btn-secondary" @onclick="ResetFormTipoRiesgo">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Categoría GRC</label>
                                    <select @bind="FormTipoRiesgo.Categoria" class="form-control form-control-sm">
                                        <option value="Operacional">Operacional</option>
                                        <option value="Tecnológico">Tecnológico</option>
                                        <option value="Financiero">Financiero</option>
                                        <option value="Cumplimiento">Cumplimiento / Legal</option>
                                        <option value="Estratégico">Estratégico</option>
                                        <option value="Reputacional">Reputacional</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Nombre de Clasificación</label>
                                    <input @bind="FormTipoRiesgo.Nombre" class="form-control form-control-sm" placeholder="Ej: Falla TI, Fraude Interno" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Descripción</label>
                                    <input @bind="FormTipoRiesgo.Descripcion" class="form-control form-control-sm" placeholder="Detalle metodológico" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarTipoRiesgo">
                                        <i class="fas fa-save mr-1"></i> Guardar
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormTipoRiesgo">Limpiar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>Categoría GRC</th>
                                    <th>Clasificación de Riesgo</th>
                                    <th>Descripción Metodológica</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroTiposRiesgo)
                                {
                                    <tr>
                                        <td><span class="badge badge-info">@item.Categoria</span></td>
                                        <td><strong>@item.Nombre</strong></td>
                                        <td><small class="text-muted">@item.Descripcion</small></td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")" @onclick="()=>ToggleEstadoTipoRiesgo(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarTipoRiesgo(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarTipoRiesgo(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- SUB-TAB 4: PARAMETROS -->
                @if (SubTabMaestra == 4)
                {
                    <div class="card border mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="fas fa-plus-circle text-primary mr-1"></i>@(FormParametro.Id==0?"Nuevo Parámetro de Control/Estrategia":"Editando: "+FormParametro.Valor)</strong>
                            @if (FormParametro.Id > 0)
                            { <button class="btn btn-xs btn-secondary" @onclick="ResetFormParametro">Cancelar</button> }
                        </div>
                        <div class="card-body p-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Grupo de Parámetro</label>
                                    <select @bind="FormParametro.Grupo" class="form-control form-control-sm">
                                        <option value="TipoControl">Tipo de Control (Preventivo, Detectivo, Correctivo)</option>
                                        <option value="FrecuenciaControl">Frecuencia de Control (Continuo, Diario, Mensual)</option>
                                        <option value="NaturalezaControl">Naturaleza de Control (Manual, Automático)</option>
                                        <option value="EfectividadControl">Evaluación de Efectividad (Efectivo, Parcial)</option>
                                        <option value="EstrategiaTratamiento">Estrategia de Tratamiento (Mitigar, Transferir)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="small font-weight-bold">Valor / Opción</label>
                                    <input @bind="FormParametro.Valor" class="form-control form-control-sm" placeholder="Ej: Preventivo, Automático" />
                                </div>
                                <div class="col-md-3">
                                    <label class="small font-weight-bold">Descripción</label>
                                    <input @bind="FormParametro.Descripcion" class="form-control form-control-sm" placeholder="Criterio de aplicación" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary btn-sm mr-2" @onclick="GuardarParametro">
                                        <i class="fas fa-save mr-1"></i> Guardar
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="ResetFormParametro">Limpiar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-striped border">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th>Grupo Parámetro</th>
                                    <th>Valor de Opción</th>
                                    <th>Descripción / Criterio</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in MaestroParametros)
                                {
                                    <tr>
                                        <td><span class="badge badge-secondary">@item.Grupo</span></td>
                                        <td><strong>@item.Valor</strong></td>
                                        <td><small class="text-muted">@item.Descripcion</small></td>
                                        <td class="text-center">
                                            <button class="btn btn-xs @(item.Activo?"btn-success":"btn-secondary")" @onclick="()=>ToggleEstadoParametro(item)">
                                                @(item.Activo?"Activo":"Inactivo")
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-warning mr-1" @onclick="()=>EditarParametro(item)"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-xs btn-danger" @onclick="()=>EliminarParametro(item.Id)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

        <!-- MODAL BITÁCORA DE DEPARTAMENTOS -->
        @if (MostrarModalBitacoraAreas)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header bg-info text-white">
                            <h5 class="modal-title"><i class="fas fa-history mr-2"></i>📜 Bitácora Auditada de Movimientos de Departamentos</h5>
                            <button type="button" class="close text-white" @onclick="CerrarModalBitacoraAreas"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            @if (!BitacoraAreas.Any())
                            {
                                <div class="text-center text-muted py-4">No se registran movimientos o reestructuraciones de departamentos aún.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped border">
                                        <thead class="bg-light">
                                            <tr>
                                                <th>Fecha y Periodo</th>
                                                <th>Departamento / Área</th>
                                                <th>Gerencia Origen (Anterior)</th>
                                                <th>Gerencia Destino (Nueva)</th>
                                                <th>Usuario y Justificación</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var b in BitacoraAreas)
                                            {
                                                <tr>
                                                    <td>
                                                        <div><strong class="text-primary">@b.Periodo</strong></div>
                                                        <small class="text-muted">@b.FechaCambio.ToString("dd/MM/yyyy HH:mm")</small>
                                                    </td>
                                                    <td><strong>@b.NombreDepartamento</strong></td>
                                                    <td><span class="badge badge-secondary">@b.GerenciaAnteriorNombre</span></td>
                                                    <td><span class="badge badge-success"><i class="fas fa-arrow-right mr-1"></i>@b.GerenciaNuevaNombre</span></td>
                                                    <td>
                                                        <div><i class="fas fa-user-edit mr-1 text-info"></i>@b.UsuarioNombre</div>
                                                        <small class="text-muted">@b.Motivo</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary btn-sm" @onclick="CerrarModalBitacoraAreas">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* ===== MODAL DE APROBACIÓN DE ACCESO CON ASIGNACIÓN DE ROL Y PROCESOS ===== *@
@if (MostrarModalAprobar && UsuarioAprobar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-success text-white" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
                    <h5 class="modal-title font-weight-bold text-white">
                        <i class="fas fa-user-check mr-2"></i>Aprobar Solicitud de Acceso: @UsuarioAprobar.Nombre
                    </h5>
                    <button type="button" class="close text-white" @onclick="CerrarModalAprobar">&times;</button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 shadow-sm mb-4" style="background-color: #e0f2fe; color: #0369a1;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle fa-2x mr-3 text-info"></i>
                            <div>
                                <strong>Colaborador:</strong> @(string.IsNullOrWhiteSpace(UsuarioAprobar.Nombre) ? UsuarioAprobar.Username : UsuarioAprobar.Nombre) (@UsuarioAprobar.Correo)<br/>
                                <small>
                                    <i class="fas fa-user-tag mr-1"></i>Cargo: @(string.IsNullOrWhiteSpace(UsuarioAprobar.Cargo) ? "No especificado" : UsuarioAprobar.Cargo) &nbsp;|&nbsp;
                                    <i class="fas fa-building mr-1"></i>Área: @(string.IsNullOrWhiteSpace(UsuarioAprobar.Departamento) ? (string.IsNullOrWhiteSpace(UsuarioAprobar.Gerencia) ? "No especificada" : UsuarioAprobar.Gerencia) : UsuarioAprobar.Departamento)
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label class="font-weight-bold text-dark h6"><i class="fas fa-shield-alt mr-2 text-primary"></i>Asignar Rol de Acceso en el Sistema</label>
                        <select @bind="RolAprobar" class="form-control form-control-lg font-weight-bold" style="border: 2px solid #047857;">
                            <option value="Personal">Personal (Operativo / Consultante de Procedimientos y Matrices)</option>
                            <option value="Admin">Admin (Gestor de Procesos y Riesgos)</option>
                            <option value="SuperAdmin">SuperAdmin (Acceso Total de Configuración)</option>
                        </select>
                        <small class="form-text text-muted mt-1">
                            El rol determina el nivel de permisos que tendrá el usuario una vez autorizada su cuenta.
                        </small>
                    </div>

                    <div class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between py-2">
                            <span class="font-weight-bold"><i class="fas fa-sitemap mr-2"></i>Asignación Inicial de Procedimientos / Matrices de Riesgo</span>
                            <div>
                                <button class="btn btn-xs btn-light mr-1 font-weight-bold" @onclick="SeleccionarTodasMatricesAprobar">Marcar Todas</button>
                                <button class="btn btn-xs btn-outline-light font-weight-bold" @onclick="DesmarcarTodasMatricesAprobar">Desmarcar</button>
                            </div>
                        </div>
                        <div class="card-body p-3" style="max-height: 230px; overflow-y: auto;">
                            @if (MatricesProcesosAprobar.Any())
                            {
                                <div class="row">
                                    @foreach (var m in MatricesProcesosAprobar)
                                    {
                                        bool checkedState = MatricesSeleccionadasAprobar.Contains(m.Id);
                                        <div class="col-md-6 mb-2">
                                            <div class="custom-control custom-checkbox p-2 border rounded bg-light">
                                                <input type="checkbox" class="custom-control-input" id="mat_cfg_@m.Id"
                                                       checked="@checkedState"
                                                       @onchange="e => ToggleMatrizAprobar(m.Id, (bool)(e.Value ?? false))" />
                                                <label class="custom-control-label font-weight-bold text-dark cursor-pointer" for="mat_cfg_@m.Id">
                                                    @m.Nombre
                                                    <br/><small class="text-muted font-weight-normal">@(string.IsNullOrWhiteSpace(m.NombreProceso) ? m.Codigo : m.NombreProceso)</small>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center my-2">No hay matrices de procesos registradas en el sistema aún.</p>
                            }
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-muted">Motivo / Nota de Aprobación (Opcional)</label>
                        <input @bind="MotivoAprobar" class="form-control" placeholder="Ej: Alta autorizada por Jefatura de Informática / RRHH" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" @onclick="CerrarModalAprobar">Cancelar</button>
                    <button class="btn btn-success font-weight-bold px-4" @onclick="ConfirmarAprobacionUsuario">
                        <i class="fas fa-check-circle mr-2"></i>Aprobar y Notificar por Correo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<Usuario> Todos = new();
    List<Usuario> Pendientes = new();
    List<Usuario> Personal = new();
    List<MatrizGrupo> TodasMatrices = new();
    List<int> MatricesAsignadas = new();
    List<UsuarioMatriz> AsignacionesGlobales = new();
    List<CambioPassword> Cambios = new();

    // MODAL DE APROBACIÓN CON ROL Y PROCESOS
    bool MostrarModalAprobar = false;
    Usuario? UsuarioAprobar;
    string RolAprobar = "Personal";
    string MotivoAprobar = "";
    List<MatrizGrupo> MatricesProcesosAprobar = new();
    List<int> MatricesSeleccionadasAprobar = new();

    // Tablas Maestras
    int SubTabMaestra = 1;
    string MsgMaestras = "";

    List<MaestroProceso> MaestroProcesos = new();
    List<MaestroArea> MaestroAreas = new();
    List<MaestroTipoRiesgo> MaestroTiposRiesgo = new();
    List<MaestroParametro> MaestroParametros = new();
    List<BitacoraDepartamentoGerencia> BitacoraAreas = new();

    MaestroProceso FormProceso = new();
    MaestroArea FormArea = new();
    MaestroTipoRiesgo FormTipoRiesgo = new();
    MaestroParametro FormParametro = new();

    string MotivoCambioArea = "";
    bool MostrarModalBitacoraAreas = false;

    int TabActivo = 1;
    int PersonalSeleccionadoId = 0;
    int UsuarioSeleccionadoHistorialId = 0;
    string MsgAsignacion = "";
    bool AsignOk = false;

    protected override async Task OnInitializedAsync() => await Cargar();

    async Task Cargar()
    {
        Todos = await UsuarioSvc.GetTodosAsync();
        Pendientes = Todos.Where(u => !u.Activo && u.Rol != "SuperAdmin").ToList();
        Personal = await UsuarioSvc.GetPersonalAsync();
        TodasMatrices = await RiesgoSvc.GetMatricesAsync();
        AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
        await CargarMaestras();
    }

    async Task SeleccionarTab(int tab)
    {
        TabActivo = tab;
        if (tab == 1)
        {
            await Cargar();
        }
        else if (tab == 2)
        {
            Personal = await UsuarioSvc.GetPersonalAsync();
            TodasMatrices = await RiesgoSvc.GetMatricesAsync();
            AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
            if (PersonalSeleccionadoId == 0 && Personal.Any())
            {
                await SeleccionarPersonal(Personal.First().Id);
            }
        }
        else if (tab == 3)
        {
            Todos = await UsuarioSvc.GetTodosAsync();
        }
        else if (tab == 4)
        {
            await CargarMaestras();
        }
        StateHasChanged();
    }

    async Task IrTabMaestras()
    {
        await SeleccionarTab(4);
    }

    async Task CargarMaestras()
    {
        MaestroProcesos = await RiesgoSvc.GetMaestroProcesosAsync();
        MaestroAreas = await RiesgoSvc.GetMaestroAreasAsync();
        MaestroTiposRiesgo = await RiesgoSvc.GetMaestroTiposRiesgoAsync();
        MaestroParametros = await RiesgoSvc.GetMaestroParametrosAsync();
        BitacoraAreas = await RiesgoSvc.GetBitacoraDepartamentoGerenciasAsync();
    }

    void AbrirModalBitacoraAreas()
    {
        MostrarModalBitacoraAreas = true;
    }

    void CerrarModalBitacoraAreas()
    {
        MostrarModalBitacoraAreas = false;
    }

    // Handlers Procesos
    void ResetFormProceso() => FormProceso = new();
    void EditarProceso(MaestroProceso item) => FormProceso = new MaestroProceso
    {
        Id = item.Id,
        Codigo = item.Codigo,
        Nombre = item.Nombre,
        Macroproceso = item.Macroproceso,
        Nivel = item.Nivel,
        AreaResponsableDefault = item.AreaResponsableDefault,
        PadreId = item.PadreId,
        AreaResponsableId = item.AreaResponsableId,
        ResponsableId = item.ResponsableId,
        Objetivo = item.Objetivo,
        Descripcion = item.Descripcion,
        Activo = item.Activo,
        Orden = item.Orden
    };
    async Task GuardarProceso()
    {
        if (string.IsNullOrWhiteSpace(FormProceso.Codigo) || string.IsNullOrWhiteSpace(FormProceso.Nombre)) return;
        await RiesgoSvc.SaveMaestroProcesoAsync(FormProceso);
        ResetFormProceso();
        MsgMaestras = "Proceso guardado correctamente.";
        await CargarMaestras();
    }
    async Task ToggleEstadoProceso(MaestroProceso item)
    {
        item.Activo = !item.Activo;
        await RiesgoSvc.SaveMaestroProcesoAsync(item);
        await CargarMaestras();
    }
    async Task EliminarProceso(int id)
    {
        await RiesgoSvc.DeleteMaestroProcesoAsync(id);
        MsgMaestras = "Proceso eliminado.";
        await CargarMaestras();
    }

    // Handlers Areas
    void ResetFormArea()
    {
        FormArea = new();
        MotivoCambioArea = "";
    }
    void EditarArea(MaestroArea item) => FormArea = new MaestroArea
    {
        Id = item.Id,
        Categoria = item.Categoria,
        Nombre = item.Nombre,
        Codigo = item.Codigo,
        PadreId = item.PadreId,
        Activo = item.Activo,
        Orden = item.Orden
    };
    async Task GuardarArea()
    {
        if (string.IsNullOrWhiteSpace(FormArea.Nombre)) return;
        await RiesgoSvc.SaveMaestroAreaAsync(FormArea, "SuperAdmin", MotivoCambioArea);
        ResetFormArea();
        MsgMaestras = "Unidad Organizacional guardada correctamente.";
        await CargarMaestras();
    }
    async Task ToggleEstadoArea(MaestroArea item)
    {
        item.Activo = !item.Activo;
        await RiesgoSvc.SaveMaestroAreaAsync(item, "SuperAdmin", "Cambio de estado Activo/Inactivo");
        await CargarMaestras();
    }
    async Task EliminarArea(int id)
    {
        await RiesgoSvc.DeleteMaestroAreaAsync(id);
        MsgMaestras = "Área eliminada.";
        await CargarMaestras();
    }

    // Handlers Tipos Riesgo
    void ResetFormTipoRiesgo() => FormTipoRiesgo = new();
    void EditarTipoRiesgo(MaestroTipoRiesgo item) => FormTipoRiesgo = new MaestroTipoRiesgo { Id = item.Id, Categoria = item.Categoria, Nombre = item.Nombre, Descripcion = item.Descripcion, Activo = item.Activo, Orden = item.Orden };
    async Task GuardarTipoRiesgo()
    {
        if (string.IsNullOrWhiteSpace(FormTipoRiesgo.Nombre)) return;
        await RiesgoSvc.SaveMaestroTipoRiesgoAsync(FormTipoRiesgo);
        ResetFormTipoRiesgo();
        MsgMaestras = "Tipo de riesgo guardado correctamente.";
        await CargarMaestras();
    }
    async Task ToggleEstadoTipoRiesgo(MaestroTipoRiesgo item)
    {
        item.Activo = !item.Activo;
        await RiesgoSvc.SaveMaestroTipoRiesgoAsync(item);
        await CargarMaestras();
    }
    async Task EliminarTipoRiesgo(int id)
    {
        await RiesgoSvc.DeleteMaestroTipoRiesgoAsync(id);
        MsgMaestras = "Tipo de riesgo eliminado.";
        await CargarMaestras();
    }

    // Handlers Parametros
    void ResetFormParametro() => FormParametro = new();
    void EditarParametro(MaestroParametro item) => FormParametro = new MaestroParametro { Id = item.Id, Grupo = item.Grupo, Valor = item.Valor, Descripcion = item.Descripcion, Activo = item.Activo, Orden = item.Orden };
    async Task GuardarParametro()
    {
        if (string.IsNullOrWhiteSpace(FormParametro.Valor)) return;
        await RiesgoSvc.SaveMaestroParametroAsync(FormParametro);
        ResetFormParametro();
        MsgMaestras = "Parámetro guardado correctamente.";
        await CargarMaestras();
    }
    async Task ToggleEstadoParametro(MaestroParametro item)
    {
        item.Activo = !item.Activo;
        await RiesgoSvc.SaveMaestroParametroAsync(item);
        await CargarMaestras();
    }
    async Task EliminarParametro(int id)
    {
        await RiesgoSvc.DeleteMaestroParametroAsync(id);
        MsgMaestras = "Parámetro eliminado.";
        await CargarMaestras();
    }

    async Task AbrirModalAprobar(Usuario u)
    {
        UsuarioAprobar = u;
        RolAprobar = string.IsNullOrWhiteSpace(u.Rol) ? "Personal" : u.Rol;
        MotivoAprobar = "";
        MatricesSeleccionadasAprobar.Clear();
        MatricesProcesosAprobar = await UsuarioSvc.GetMatricesProcesosActivasAsync();
        MostrarModalAprobar = true;
    }

    void CerrarModalAprobar()
    {
        MostrarModalAprobar = false;
        UsuarioAprobar = null;
        MatricesSeleccionadasAprobar.Clear();
    }

    void ToggleMatrizAprobar(int id, bool seleccionado)
    {
        if (seleccionado)
        {
            if (!MatricesSeleccionadasAprobar.Contains(id)) MatricesSeleccionadasAprobar.Add(id);
        }
        else
        {
            MatricesSeleccionadasAprobar.Remove(id);
        }
    }

    void SeleccionarTodasMatricesAprobar()
    {
        MatricesSeleccionadasAprobar = MatricesProcesosAprobar.Select(m => m.Id).ToList();
    }

    void DesmarcarTodasMatricesAprobar()
    {
        MatricesSeleccionadasAprobar.Clear();
    }

    async Task ConfirmarAprobacionUsuario()
    {
        if (UsuarioAprobar == null) return;
        await UsuarioSvc.AprobarUsuarioConRolYMatricesAsync(
            UsuarioAprobar.Id,
            RolAprobar,
            MatricesSeleccionadasAprobar,
            "SuperAdmin"
        );
        CerrarModalAprobar();
        await Cargar();
    }

    async Task Activar(int id)
    {
        await UsuarioSvc.ActivarAsync(id);
        await Cargar();
    }

    async Task Toggle(int id)
    {
        await UsuarioSvc.ToggleActivoAsync(id);
        await Cargar();
    }

    async Task Eliminar(int id)
    {
        await UsuarioSvc.EliminarAsync(id);
        await Cargar();
    }

    async Task SeleccionarPersonal(int id)
    {
        PersonalSeleccionadoId = id;
        MsgAsignacion = "";
        await CargarAsignacionesUsuario();
    }

    async Task CargarAsignacionesUsuario()
    {
        if (PersonalSeleccionadoId == 0) return;
        MatricesAsignadas = await UsuarioSvc.GetIdsMatricesAsignadasAsync(PersonalSeleccionadoId);
        AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
    }

    async Task AsignarMatriz(int matrizId)
    {
        if (PersonalSeleccionadoId == 0) return;
        await UsuarioSvc.AsignarMatrizAsync(PersonalSeleccionadoId, matrizId);
        AsignOk = true;
        MsgAsignacion = "Matriz asignada correctamente.";
        await CargarAsignacionesUsuario();
    }

    async Task QuitarMatriz(int matrizId)
    {
        if (PersonalSeleccionadoId == 0) return;
        await UsuarioSvc.QuitarMatrizAsync(PersonalSeleccionadoId, matrizId);
        AsignOk = true;
        MsgAsignacion = "Matriz desasignada.";
        await CargarAsignacionesUsuario();
    }

    async Task AsignarTodas()
    {
        if (PersonalSeleccionadoId == 0) return;
        foreach (var m in TodasMatrices)
        {
            if (!MatricesAsignadas.Contains(m.Id))
                await UsuarioSvc.AsignarMatrizAsync(PersonalSeleccionadoId, m.Id);
        }
        AsignOk = true;
        MsgAsignacion = "Se asignaron todas las matrices al usuario.";
        await CargarAsignacionesUsuario();
    }

    async Task QuitarTodas()
    {
        if (PersonalSeleccionadoId == 0) return;
        await UsuarioSvc.QuitarTodasMatricesAsync(PersonalSeleccionadoId);
        AsignOk = true;
        MsgAsignacion = "Se desasignaron todas las matrices del usuario.";
        await CargarAsignacionesUsuario();
    }

    async Task VerCambios(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var uId) && uId > 0)
        {
            UsuarioSeleccionadoHistorialId = uId;
            Cambios = await UsuarioSvc.GetCambiosAsync(uId);
        }
        else
        {
            UsuarioSeleccionadoHistorialId = 0;
            Cambios = new();
        }
    }
}
