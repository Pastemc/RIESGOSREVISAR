                            </div>
                            <div class="progress" style="height:18px;border-radius:9px;">
                                <div class="progress-bar font-weight-bold"
                                     style="width:@pctAnio%;background:@colorBarra;border-radius:9px;font-size:.78rem;">
                                    @pctAnio%
                                </div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mt-1">
                                <span>Ene @DateTime.Now.Year</span>
                                <span>Dic @DateTime.Now.Year</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light text-muted small">
