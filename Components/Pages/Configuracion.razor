    async Task AbrirModalAprobar(Usuario u)
    {
        UsuarioAprobar = u;
        RolAprobar = string.IsNullOrWhiteSpace(u.Rol) ? "Personal" : u.Rol;
        MotivoAprobar = "";
        MatricesSeleccionadasAprobar.Clear();
        MatricesProcesosAprobar = await UsuarioSvc.GetMatricesProcesosActivasAsync();
        MostrarModalAprobar = true;
    }
    void CerrarModalAprobar() { MostrarModalAprobar=false; UsuarioAprobar=null; MatricesSeleccionadasAprobar.Clear(); }
    void ToggleMatrizAprobar(int id, bool sel)
    {
        if (sel) { if (!MatricesSeleccionadasAprobar.Contains(id)) MatricesSeleccionadasAprobar.Add(id); }
        else MatricesSeleccionadasAprobar.Remove(id);
    }
    void SeleccionarTodasMatricesAprobar() => MatricesSeleccionadasAprobar = MatricesProcesosAprobar.Select(m=>m.Id).ToList();
    void DesmarcarTodasMatricesAprobar()   => MatricesSeleccionadasAprobar.Clear();
    async Task ConfirmarAprobacionUsuario()
    {
        if (UsuarioAprobar == null) return;
        await UsuarioSvc.AprobarUsuarioConRolYMatricesAsync(UsuarioAprobar.Id, RolAprobar, MatricesSeleccionadasAprobar, "SuperAdmin");
        CerrarModalAprobar();
        await Cargar();
    }

    async Task Toggle(int id) { await UsuarioSvc.ToggleActivoAsync(id); await Cargar(); }
    async Task Eliminar(int id) { await UsuarioSvc.EliminarAsync(id); await Cargar(); }

    async Task SeleccionarPersonal(int id)
    {
        PersonalSeleccionadoId = id; MsgAsignacion = "";
        await CargarAsignacionesUsuario();
    }
    async Task CargarAsignacionesUsuario()
    {
        if (PersonalSeleccionadoId == 0) return;
        MatricesAsignadas = await UsuarioSvc.GetIdsMatricesAsignadasAsync(PersonalSeleccionadoId);
        AsignacionesGlobales = await UsuarioSvc.GetTodasAsignacionesAsync();
    }
    async Task AsignarMatriz(int id) { await UsuarioSvc.AsignarMatrizAsync(PersonalSeleccionadoId,id); AsignOk=true; MsgAsignacion="Asignada."; await CargarAsignacionesUsuario(); }
    async Task QuitarMatriz(int id)  { await UsuarioSvc.QuitarMatrizAsync(PersonalSeleccionadoId,id);  AsignOk=true; MsgAsignacion="Desasignada."; await CargarAsignacionesUsuario(); }
    async Task AsignarTodas()
    {
        foreach (var m in TodasMatrices)
            if (!MatricesAsignadas.Contains(m.Id))
                await UsuarioSvc.AsignarMatrizAsync(PersonalSeleccionadoId, m.Id);
        AsignOk=true; MsgAsignacion="Todas asignadas."; await CargarAsignacionesUsuario();
    }
    async Task QuitarTodas() { await UsuarioSvc.QuitarTodasMatricesAsync(PersonalSeleccionadoId); AsignOk=true; MsgAsignacion="Todas desasignadas."; await CargarAsignacionesUsuario(); }
    async Task VerCambios(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var uId) && uId > 0)
        { UsuarioSeleccionadoHistorialId=uId; Cambios=await UsuarioSvc.GetCambiosAsync(uId); }
        else { UsuarioSeleccionadoHistorialId=0; Cambios=new(); }
    }
}
