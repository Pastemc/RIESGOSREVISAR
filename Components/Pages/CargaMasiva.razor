@page "/carga-masiva"
@layout MainLayout
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject ExcelService ExcelSvc
@inject RiesgoService RiesgoSvc
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-file-excel text-success mr-2"></i>Carga Masiva de Matrices de Riesgos (GRC)
                </h1>
                <small class="text-muted">Importación, actualización y exportación en lote en formato institucional de Electro Oriente S.A.</small>
            </div>
            <div class="col-sm-5">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active">Carga Masiva</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- SECCIÓN 1: PLANTILLA Y EXPORTACIÓN -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card card-outline card-primary h-100">
                <div class="card-header" style="background:#0062B8; color:#ffffff;">
                    <h5 class="card-title mb-0"><i class="fas fa-download mr-2"></i>1. Plantilla Oficial Carga Masiva</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="card-text text-muted mb-3">
                        Descargue el formato oficial <code>Carga_Masiva_V1.xlsm</code> de Electro Oriente para registrar o actualizar múltiples procesos, riesgos, controles y planes de acción simultáneamente.
                    </p>
                    <div>
                        <button class="btn btn-outline-primary btn-block font-weight-bold" @onclick="DescargarPlantillaOficial">
                            <i class="fas fa-file-excel text-success mr-2"></i>📥 Descargar Plantilla Oficial (XLSM)
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-outline card-info h-100">
                <div class="card-header" style="background:#004F94; color:#ffffff;">
                    <h5 class="card-title mb-0"><i class="fas fa-file-export mr-2"></i>2. Exportar Consolidado Completo</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="card-text text-muted mb-3">
                        Genere y descargue un archivo Excel con <strong>todas las matrices registradas actualmente</strong> en el sistema, estructurado en las 40 columnas institucionales del GIR.
                    </p>
                    <div>
                        <button class="btn btn-info btn-block font-weight-bold" @onclick="ExportarConsolidadoActual">
                            <i class="fas fa-file-download mr-2"></i>📊 Exportar Matriz Consolidada Vigente (XLSM / XLSX)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN 2: CARGA E INSPECCIÓN -->
    <div class="card card-outline card-success mb-4">
        <div class="card-header" style="border-bottom: 2px solid #FFDD00;">
            <h3 class="card-title text-success font-weight-bold">
                <i class="fas fa-upload mr-2"></i>3. Seleccionar e Importar Archivo Excel
            </h3>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3">
                    <label class="font-weight-bold">Seleccionar Archivo Excel (.xlsx / .xlsm / .xls):</label>
                    <div class="custom-file">
                        <InputFile OnChange="OnInputFileChange" class="form-control form-control-file" accept=".xlsx,.xlsm,.xls" />
                    </div>
                    @if (ArchivoSeleccionado != null)
                    {
                        <div class="mt-2 text-success small font-weight-bold">
                            <i class="fas fa-check-circle mr-1"></i>Archivo listo: @ArchivoSeleccionado.Name (@((ArchivoSeleccionado.Size / 1024.0).ToString("N0")) KB)
                        </div>
                    }
                </div>
                <div class="col-md-3 mb-3">
                    <div class="custom-control custom-checkbox mt-4">
                        <input type="checkbox" class="custom-control-input" id="chkActualizar" @bind="ActualizarExistentes" />
                        <label class="custom-control-label font-weight-bold text-dark" for="chkActualizar">
                            Actualizar datos si el Código de Riesgo ya existe
                        </label>
                    </div>
                </div>
                <div class="col-md-3 mb-3 text-right">
                    <button class="btn btn-primary btn-block py-2 font-weight-bold" @onclick="InspeccionarArchivo" disabled="@(ArchivoSeleccionado == null || Procesando)">
                        @if (Procesando)
                        {
                            <span class="spinner-border spinner-border-sm mr-2" role="status"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="fas fa-search mr-2"></i><span>Inspeccionar y Validar</span>
                        }
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(MensajeEstado))
            {
                <div class="alert alert-@TipoMensajeAlert py-2 mt-3 mb-0">
                    <i class="fas fa-info-circle mr-2"></i>@MensajeEstado
                </div>
            }
        </div>
    </div>

    <!-- SECCIÓN 3: VISTA PREVIA -->
    @if (FilasInspeccionadas.Any())
    {
        <div class="card card-outline card-warning mb-4">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <h4 class="card-title text-dark font-weight-bold mb-0">
                    <i class="fas fa-table mr-2 text-warning"></i>Vista Previa de Inspección (@FilasInspeccionadas.Count filas detectadas)
                </h4>
                <div>
                    <button class="btn btn-success font-weight-bold px-4" @onclick="EjecutarImportacionMasiva" disabled="@Importando">
                        @if (Importando)
                        {
                            <span class="spinner-border spinner-border-sm mr-2" role="status"></span>
                            <span>Importando BD...</span>
                        }
                        else
                        {
                            <i class="fas fa-cloud-upload-alt mr-2"></i><span>🚀 Confirmar e Importar a Base de Datos</span>
                        }
                    </button>
                </div>
            </div>

            <div class="card-body p-3">

                <!-- ── BADGES ESTADÍSTICOS ─────────────────────────────────── -->
                <div class="row mb-3">
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-info text-white"><i class="fas fa-list"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Filas Totales</span>
                                <span class="info-box-number">@FilasInspeccionadas.Count</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-warning text-white"><i class="fas fa-exclamation-triangle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Riesgos Únicos</span>
                                <span class="info-box-number">@FilasInspeccionadas.Select(f => f.CodigoRiesgo).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().Count()</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-danger text-white"><i class="fas fa-copy"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Dup. en Archivo</span>
                                <span class="info-box-number">@FilasInspeccionadas.Count(f => f.EsDuplicadoEnArchivo)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-secondary text-white"><i class="fas fa-database"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Existe en BD</span>
                                <span class="info-box-number">@FilasInspeccionadas.Count(f => f.ExisteEnBaseDatos)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-dark text-white"><i class="fas fa-shield-alt"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Controles</span>
                                <span class="info-box-number">@FilasInspeccionadas.Count(f => !string.IsNullOrWhiteSpace(f.CodigoControl) || !string.IsNullOrWhiteSpace(f.DescripcionControl))</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="info-box bg-light border p-2 mb-0">
                            <span class="info-box-icon bg-success text-white"><i class="fas fa-tasks"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Planes Acción</span>
                                <span class="info-box-number">@FilasInspeccionadas.Count(f => !string.IsNullOrWhiteSpace(f.CodigoPlanAccion) || !string.IsNullOrWhiteSpace(f.DescripcionPlanAccion))</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── RESUMEN NIVELES DE RIESGO RESIDUAL ─────────────────── -->
                @{
                    var totalConNivel = FilasInspeccionadas.Count(f =>
                        f.ProbabilidadResidual >= 1 && f.ProbabilidadResidual <= 4 &&
                        f.ImpactoResidual      >= 1 && f.ImpactoResidual      <= 4);

                    var cntBajo     = FilasInspeccionadas.Count(f => GetNivel(f.ProbabilidadResidual, f.ImpactoResidual) == "Bajo");
                    var cntModerado = FilasInspeccionadas.Count(f => GetNivel(f.ProbabilidadResidual, f.ImpactoResidual) == "Moderado");
                    var cntAlto     = FilasInspeccionadas.Count(f => GetNivel(f.ProbabilidadResidual, f.ImpactoResidual) == "Alto");
                    var cntExtremo  = FilasInspeccionadas.Count(f => GetNivel(f.ProbabilidadResidual, f.ImpactoResidual) == "Extremo");

                    double PctB = totalConNivel > 0 ? Math.Round(cntBajo     * 100.0 / totalConNivel, 1) : 0;
                    double PctM = totalConNivel > 0 ? Math.Round(cntModerado * 100.0 / totalConNivel, 1) : 0;
                    double PctA = totalConNivel > 0 ? Math.Round(cntAlto     * 100.0 / totalConNivel, 1) : 0;
                    double PctE = totalConNivel > 0 ? Math.Round(cntExtremo  * 100.0 / totalConNivel, 1) : 0;
                }

                <div class="card border mb-3" style="border-color:#dee2e6!important;">
                    <div class="card-header py-2" style="background:#004F94; color:#fff;">
                        <h6 class="mb-0 font-weight-bold">
                            <i class="fas fa-chart-bar mr-2"></i>
                            Distribución de Riesgo Residual — @totalConNivel riesgos evaluados
                        </h6>
                    </div>
                    <div class="card-body py-3">

                        <!-- Tarjetas de nivel -->
                        <div class="row mb-3">
                            <div class="col-6 col-md-3 mb-2">
                                <div class="text-center p-3 rounded text-white font-weight-bold"
                                     style="background:#28a745;">
                                    <div style="font-size:2rem;">@cntBajo</div>
                                    <div>BAJO</div>
                                    <div style="font-size:0.85rem; opacity:0.9;">@PctB%</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <div class="text-center p-3 rounded font-weight-bold"
                                     style="background:#ffc107; color:#000;">
                                    <div style="font-size:2rem;">@cntModerado</div>
                                    <div>MODERADO</div>
                                    <div style="font-size:0.85rem; opacity:0.8;">@PctM%</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <div class="text-center p-3 rounded text-white font-weight-bold"
                                     style="background:#fd7e14;">
                                    <div style="font-size:2rem;">@cntAlto</div>
                                    <div>ALTO</div>
                                    <div style="font-size:0.85rem; opacity:0.9;">@PctA%</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 mb-2">
                                <div class="text-center p-3 rounded text-white font-weight-bold"
                                     style="background:#dc3545;">
                                    <div style="font-size:2rem;">@cntExtremo</div>
                                    <div>EXTREMO</div>
                                    <div style="font-size:0.85rem; opacity:0.9;">@PctE%</div>
                                </div>
                            </div>
                        </div>

                        <!-- Barra de progreso apilada -->
                        @if (totalConNivel > 0)
                        {
                            <div class="progress mb-1" style="height:24px; border-radius:6px;">
                                @if (cntBajo > 0)
                                {
                                    <div class="progress-bar font-weight-bold"
                                         style="width:@(PctB)%; background:#28a745;"
                                         title="Bajo: @cntBajo">
                                        @cntBajo
                                    </div>
                                }
                                @if (cntModerado > 0)
                                {
                                    <div class="progress-bar font-weight-bold"
                                         style="width:@(PctM)%; background:#ffc107; color:#000;"
                                         title="Moderado: @cntModerado">
                                        @cntModerado
                                    </div>
                                }
                                @if (cntAlto > 0)
                                {
                                    <div class="progress-bar font-weight-bold"
                                         style="width:@(PctA)%; background:#fd7e14;"
                                         title="Alto: @cntAlto">
                                        @cntAlto
                                    </div>
                                }
                                @if (cntExtremo > 0)
                                {
                                    <div class="progress-bar font-weight-bold"
                                         style="width:@(PctE)%; background:#dc3545;"
                                         title="Extremo: @cntExtremo">
                                        @cntExtremo
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-between small text-muted px-1">
                                <span>■ Bajo</span>
                                <span>■ Moderado</span>
                                <span>■ Alto</span>
                                <span>■ Extremo</span>
                            </div>

                            <!-- Alerta si hay riesgos críticos -->
                            @if (cntAlto + cntExtremo > 0)
                            {
                                <div class="alert alert-danger py-2 mt-3 mb-0">
                                    <i class="fas fa-exclamation-triangle mr-2"></i>
                                    <strong>@(cntAlto + cntExtremo) riesgos de atención prioritaria</strong>
                                    (@cntExtremo extremos y @cntAlto altos) — requieren plan de acción según normativa FONAFE.
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- ── TABLA INSTITUCIONAL ────────────────────────────────── -->
                <div class="table-responsive" style="max-height: 520px; overflow: auto;">
                    <table class="table table-sm table-bordered mb-0" style="font-size: 0.72rem; white-space: nowrap; min-width: 2800px;">
                        <thead>
                            <tr>
                                <th rowspan="2" class="text-center align-middle" style="background:#1a3a5c; color:#fff; min-width:40px;">#</th>
                                <th colspan="13" class="text-center" style="background:#0062B8; color:#fff; border:2px solid #fff;">DATOS GENERALES DEL RIESGO</th>
                                <th colspan="4" class="text-center" style="background:#6c757d; color:#fff; border:2px solid #fff;">RIESGO INHERENTE</th>
                                <th colspan="8" class="text-center" style="background:#003B70; color:#fff; border:2px solid #fff;">CONTROL</th>
                                <th colspan="4" class="text-center" style="background:#004F94; color:#fff; border:2px solid #fff;">RIESGO RESIDUAL</th>
                                <th colspan="9" class="text-center" style="background:#856404; color:#fff; border:2px solid #fff;">PLAN DE ACCIÓN</th>
                                <th colspan="6" class="text-center" style="background:#0062B8; color:#fff; border:2px solid #fff;">INDICADORES</th>
                                <th rowspan="2" class="text-center align-middle" style="background:#155724; color:#fff; min-width:90px;">Estado</th>
                            </tr>
                            <tr style="background:#e9ecef; font-size:0.68rem;">
                                <th class="text-center" style="background:#cce0ff; min-width:55px;">COD</th>
                                <th class="text-center" style="background:#cce0ff; min-width:60px;">Nivel</th>
                                <th class="text-center" style="background:#cce0ff; min-width:150px;">Gerencia Resp.</th>
                                <th class="text-center" style="background:#cce0ff; min-width:160px;">Nombre Proceso</th>
                                <th class="text-center" style="background:#cce0ff; min-width:140px;">Subproceso</th>
                                <th class="text-center" style="background:#cce0ff; min-width:80px;">Cód. Riesgo</th>
                                <th class="text-center" style="background:#cce0ff; min-width:220px;">Descripción Riesgo</th>
                                <th class="text-center" style="background:#cce0ff; min-width:100px;">Proc. Impactados</th>
                                <th class="text-center" style="background:#cce0ff; min-width:70px;">FODA</th>
                                <th class="text-center" style="background:#cce0ff; min-width:100px;">Grupos Interés</th>
                                <th class="text-center" style="background:#cce0ff; min-width:70px;">Origen</th>
                                <th class="text-center" style="background:#cce0ff; min-width:80px;">Frecuencia</th>
                                <th class="text-center" style="background:#cce0ff; min-width:80px;">Tipo</th>
                                <th class="text-center" style="background:#dee2e6; min-width:50px;">Prob.</th>
                                <th class="text-center" style="background:#dee2e6; min-width:55px;">Impacto</th>
                                <th class="text-center" style="background:#dee2e6; min-width:55px;">Severidad</th>
                                <th class="text-center" style="background:#dee2e6; min-width:65px;">Nivel</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:80px;">Cód. Control</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:200px;">Desc. Control</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:140px;">Área Control</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:140px;">Resp. Control</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:80px;">Frec. Control</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:80px;">Oportunidad</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:80px;">Automatiz.</th>
                                <th class="text-center" style="background:#c8d8f0; min-width:140px;">Evidencia</th>
                                <th class="text-center" style="background:#d0e4f7; min-width:50px;">Prob.</th>
                                <th class="text-center" style="background:#d0e4f7; min-width:55px;">Impacto</th>
                                <th class="text-center" style="background:#d0e4f7; min-width:55px;">Severidad</th>
                                <th class="text-center" style="background:#d0e4f7; min-width:65px;">Nivel</th>
                                <th class="text-center" style="background:#fff3cd; min-width:90px;">Estrategia</th>
                                <th class="text-center" style="background:#fff3cd; min-width:80px;">Cód. Plan</th>
                                <th class="text-center" style="background:#fff3cd; min-width:200px;">Desc. Plan</th>
                                <th class="text-center" style="background:#fff3cd; min-width:140px;">Área Plan</th>
                                <th class="text-center" style="background:#fff3cd; min-width:140px;">Resp. Plan</th>
                                <th class="text-center" style="background:#fff3cd; min-width:80px;">Inicio</th>
                                <th class="text-center" style="background:#fff3cd; min-width:70px;">Estado</th>
                                <th class="text-center" style="background:#fff3cd; min-width:80px;">Fin</th>
                                <th class="text-center" style="background:#fff3cd; min-width:80px;">F. Prevista</th>
                                <th class="text-center" style="background:#fff3cd; min-width:70px;">¿Eficaz?</th>
                                <th class="text-center" style="background:#cce0ff; min-width:80px;">Cód. KRI</th>
                                <th class="text-center" style="background:#cce0ff; min-width:160px;">Definición KRI</th>
                                <th class="text-center" style="background:#cce0ff; min-width:70px;">Frec. KRI</th>
                                <th class="text-center" style="background:#cce0ff; min-width:70px;">Meta KRI</th>
                                <th class="text-center" style="background:#cce0ff; min-width:70px;">KRI Actual</th>
                                <th class="text-center" style="background:#cce0ff; min-width:130px;">Resp. KRI</th>
                            </tr>
                        </thead>
                        <tbody style="font-size:0.70rem;">
                            @foreach (var f in FilasInspeccionadas.Take(200))
                            {
                                var sevI   = f.ProbabilidadInherente * f.ImpactoInherente;
                                var sevR   = f.ProbabilidadResidual  * f.ImpactoResidual;
                                var nivI   = GetNivel(f.ProbabilidadInherente, f.ImpactoInherente);
                                var nivR   = GetNivel(f.ProbabilidadResidual,  f.ImpactoResidual);
                                var colorI = GetColorNivel(nivI);
                                var colorR = GetColorNivel(nivR);
                                <tr class="@(f.EsDuplicadoEnArchivo ? "table-warning" : f.ExisteEnBaseDatos ? "table-info" : f.EsValido ? "" : "table-danger")">
                                    <td class="text-center font-weight-bold">@f.FilaNumero</td>
                                    <td class="text-center"><span class="badge badge-primary" style="font-size:0.65rem;">@f.CodigoProceso</span></td>
                                    <td class="text-center">@f.NivelProceso</td>
                                    <td title="@f.GerenciaResponsable" style="max-width:150px;overflow:hidden;text-overflow:ellipsis;">@f.GerenciaResponsable</td>
                                    <td title="@f.NombreProceso" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;">@f.NombreProceso</td>
                                    <td title="@f.Subproceso" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.Subproceso</td>
                                    <td class="font-weight-bold text-primary" style="white-space:nowrap;">@f.CodigoRiesgo</td>
                                    <td title="@f.DescripcionRiesgo" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;">@f.DescripcionRiesgo</td>
                                    <td title="@f.ProcesosImpactados" style="max-width:100px;overflow:hidden;text-overflow:ellipsis;">@f.ProcesosImpactados</td>
                                    <td title="@f.Foda" style="max-width:70px;overflow:hidden;text-overflow:ellipsis;">@f.Foda</td>
                                    <td title="@f.GruposInteres" style="max-width:100px;overflow:hidden;text-overflow:ellipsis;">@f.GruposInteres</td>
                                    <td style="white-space:nowrap;">@f.OrigenRiesgo</td>
                                    <td style="white-space:nowrap;">@f.FrecuenciaRiesgo</td>
                                    <td style="white-space:nowrap;">@f.TipoRiesgo</td>
                                    <td class="text-center">@f.ProbabilidadInherente</td>
                                    <td class="text-center">@f.ImpactoInherente</td>
                                    <td class="text-center font-weight-bold" style="color:@colorI;">@sevI</td>
                                    <td class="text-center"><span class="badge" style="background:@colorI;color:#fff;font-size:0.62rem;">@nivI</span></td>
                                    <td class="font-weight-bold" style="white-space:nowrap;color:#003B70;">@f.CodigoControl</td>
                                    <td title="@f.DescripcionControl" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;">@f.DescripcionControl</td>
                                    <td title="@f.AreaResponsableControl" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.AreaResponsableControl</td>
                                    <td title="@f.ResponsableControl" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.ResponsableControl</td>
                                    <td style="white-space:nowrap;">@f.FrecuenciaControl</td>
                                    <td style="white-space:nowrap;">@f.OportunidadControl</td>
                                    <td style="white-space:nowrap;">@f.AutomatizacionControl</td>
                                    <td title="@f.EvidenciaControl" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.EvidenciaControl</td>
                                    <td class="text-center">@f.ProbabilidadResidual</td>
                                    <td class="text-center">@f.ImpactoResidual</td>
                                    <td class="text-center font-weight-bold" style="color:@colorR;">@sevR</td>
                                    <td class="text-center"><span class="badge" style="background:@colorR;color:#fff;font-size:0.62rem;">@nivR</span></td>
                                    <td style="white-space:nowrap;">@f.EstrategiaRespuesta</td>
                                    <td style="white-space:nowrap;color:#856404;font-weight:600;">@f.CodigoPlanAccion</td>
                                    <td title="@f.DescripcionPlanAccion" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;">@f.DescripcionPlanAccion</td>
                                    <td title="@f.AreaResponsablePlan" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.AreaResponsablePlan</td>
                                    <td title="@f.ResponsablePlan" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;">@f.ResponsablePlan</td>
                                    <td style="white-space:nowrap;">@(f.InicioPlanAccion?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td style="white-space:nowrap;">@f.EstadoPlanAccion</td>
                                    <td style="white-space:nowrap;">@(f.FinPlanAccion?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td style="white-space:nowrap;">@(f.FechaPrevista?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td class="text-center">@f.PlanEficaz</td>
                                    <td></td><td></td><td></td><td></td><td></td><td></td>
                                    <td class="text-center" style="white-space:nowrap;">
                                        @if (f.EsDuplicadoEnArchivo)
                                        {
                                            <span class="badge badge-warning" title="Duplicado en el archivo"><i class="fas fa-copy mr-1"></i>Dup. Arch.</span>
                                        }
                                        else if (f.ExisteEnBaseDatos)
                                        {
                                            <span class="badge badge-info" title="Ya existe en BD"><i class="fas fa-database mr-1"></i>En BD</span>
                                        }
                                        else if (f.EsValido)
                                        {
                                            <span class="badge badge-success"><i class="fas fa-plus-circle mr-1"></i>Nuevo</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger" title="@f.MensajeValidacion"><i class="fas fa-exclamation-circle mr-1"></i>Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (FilasInspeccionadas.Count > 200)
                {
                    <div class="text-center text-muted small mt-2">
                        <em>Mostrando las primeras 200 filas de @FilasInspeccionadas.Count. Al confirmar se procesarán <strong>todas</strong>.</em>
                    </div>
                }
            </div>
        </div>
    }

    <!-- RESULTADO FINAL -->
    @if (ResultadoImportacion != null)
    {
        <div class="card card-outline card-success mb-4">
            <div class="card-header bg-success text-white">
                <h4 class="card-title mb-0"><i class="fas fa-check-circle mr-2"></i>Resultado de Carga Masiva</h4>
            </div>
            <div class="card-body">
                <div class="row text-center mb-3">
                    <div class="col-md-3">
                        <div class="p-3 bg-light border rounded">
                            <h3 class="text-success font-weight-bold mb-0">@ResultadoImportacion.TotalRiesgosNuevos</h3>
                            <span class="text-muted">Riesgos Creados</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-light border rounded">
                            <h3 class="text-info font-weight-bold mb-0">@ResultadoImportacion.TotalRiesgosActualizados</h3>
                            <span class="text-muted">Riesgos Actualizados</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-light border rounded">
                            <h3 class="text-dark font-weight-bold mb-0">@ResultadoImportacion.TotalControlesCreados</h3>
                            <span class="text-muted">Controles Registrados</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-light border rounded">
                            <h3 class="text-warning font-weight-bold mb-0">@ResultadoImportacion.TotalPlanesCreados</h3>
                            <span class="text-muted">Planes de Acción Registrados</span>
                        </div>
                    </div>
                </div>
                <h6 class="font-weight-bold text-dark mt-3"><i class="fas fa-list-alt mr-1"></i>Bitácora de Procesamiento:</h6>
                <ul class="list-group list-group-flush border rounded small">
                    @foreach (var log in ResultadoImportacion.MensajesLog)
                    {
                        <li class="list-group-item py-1">@log</li>
                    }
                </ul>
            </div>
        </div>
    }

</div>

@code {
    IBrowserFile? ArchivoSeleccionado;
    bool ActualizarExistentes = true;
    bool Procesando  = false;
    bool Importando  = false;
    string MensajeEstado    = "";
    string TipoMensajeAlert = "info";

    List<FilaCargaMasiva>   FilasInspeccionadas = new();
    ResultadoCargaMasiva?   ResultadoImportacion;

    void OnInputFileChange(InputFileChangeEventArgs e)
    {
        ArchivoSeleccionado  = e.File;
        FilasInspeccionadas.Clear();
        ResultadoImportacion = null;
        MensajeEstado        = "";
    }

    async Task DescargarPlantillaOficial()
    {
        var bytes  = ExcelSvc.ObtenerPlantillaCargaMasiva();
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("saveAsFile", "Carga_Masiva_V1.xlsm",
            "application/vnd.ms-excel.sheet.macroEnabled.12", base64);
    }

    async Task ExportarConsolidadoActual()
    {
        var riesgos = await RiesgoSvc.GetTodosAsync();
        var bytes   = ExcelSvc.GenerarConsolidadoCargaMasivaExcel(riesgos);
        var base64  = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("saveAsFile",
            $"Matriz_Consolidada_GIR_{DateTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }

    async Task InspeccionarArchivo()
    {
        if (ArchivoSeleccionado == null) return;
        Procesando    = true;
        MensajeEstado = "";
        StateHasChanged();
        try
        {
            using var stream = ArchivoSeleccionado.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var ms     = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            FilasInspeccionadas = ExcelSvc.LeerCargaMasivaExcel(ms);
            await RiesgoSvc.ValidarDuplicadosAsync(FilasInspeccionadas);

            if (!FilasInspeccionadas.Any())
            {
                TipoMensajeAlert = "warning";
                MensajeEstado    = "No se encontraron filas con datos en el archivo Excel.";
            }
            else
            {
                var errores = FilasInspeccionadas.Count(f => !f.EsValido);
                TipoMensajeAlert = errores > 0 ? "warning" : "success";
                MensajeEstado    = $"Inspección completada: {FilasInspeccionadas.Count} registros detectados" +
                                   (errores > 0 ? $" ({errores} con errores)." : " — listos para importar.");
            }
        }
        catch (Exception ex)
        {
            TipoMensajeAlert = "danger";
            MensajeEstado    = $"Error al leer el archivo Excel: {ex.Message}";
        }
        finally { Procesando = false; }
    }

    async Task EjecutarImportacionMasiva()
    {
        if (!FilasInspeccionadas.Any()) return;
        Importando = true;
        StateHasChanged();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var usuario   = authState.User.Identity?.Name ?? "SuperAdmin";
            ResultadoImportacion = await RiesgoSvc.ProcesarCargaMasivaAsync(
                FilasInspeccionadas, ActualizarExistentes, usuario);
            FilasInspeccionadas.Clear();
            TipoMensajeAlert = "success";
            MensajeEstado    = "¡Importación masiva completada con éxito!";
        }
        catch (Exception ex)
        {
            TipoMensajeAlert = "danger";
            MensajeEstado    = $"Error durante la importación: {ex.Message}";
        }
        finally { Importando = false; }
    }

    // ── Tabla FONAFE ELORSA ──────────────────────────────────────────────
    static string GetNivel(int prob, int imp) => (prob, imp) switch
    {
        (1, 1) or (2, 1) or (1, 2)                       => "Bajo",
        (3, 1) or (1, 3) or (4, 1) or (1, 4) or (2, 2)  => "Moderado",
        (3, 2) or (2, 3) or (4, 2) or (2, 4) or (3, 3)  => "Alto",
        (4, 3) or (3, 4) or (4, 4)                       => "Extremo",
        _                                                  => "Bajo"
    };

    static string GetNivel(int sev) => sev switch
    {
        <= 2 => "Bajo",
        <= 4 => "Moderado",
        <= 9 => "Alto",
        _    => "Extremo"
    };

    static string GetColorNivel(string nivel) => nivel switch
    {
        "Bajo"     => "#28a745",
        "Moderado" => "#ffc107",
        "Alto"     => "#fd7e14",
        _          => "#dc3545"
    };
}
