@if (MostrarModalBitacora && PeriodoAccion != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius:12px;overflow:hidden;">
                <div class="modal-header bg-info text-white font-weight-bold">
                    <h5 class="modal-title">
                        <i class="fas fa-history mr-2"></i>Bitacora — @PeriodoAccion.NombrePeriodo
                    </h5>
                    <button type="button" class="close text-white" @onclick="CerrarModalBitacora">&times;</button>
                </div>
                <div class="modal-body p-3">
                    @if (!BitacoraPeriodo.Any())
                    {
                        <div class="text-center text-muted py-4">Sin registros en la bitacora.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                            <table class="table table-sm table-striped border mb-0">
                                <thead style="background:#17a2b8;color:#fff;position:sticky;top:0;">
                                    <tr>
                                        <th>Fecha y Hora</th><th>Accion</th><th>Campo</th>
                                        <th>Valor Anterior</th><th>Valor Nuevo</th>
                                        <th>Usuario</th><th>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in BitacoraPeriodo)
                                    {
                                        var ca = b.Accion switch
                                        {
                                            "Creado"    => "#28a745",
                                            "Editado"   => "#d4a017",
                                            "Cerrado"   => "#dc3545",
                                            "Eliminado" => "#6c757d",
                                            _           => "#0062B8"
                                        };
                                        <tr>
                                            <td><strong>@b.FechaCambio.ToString("dd/MM/yyyy HH:mm:ss")</strong></td>
                                            <td>
                                                <span class="badge"
                                                      style="background:@ca;color:@(b.Accion=="Editado"?"#000":"#fff");font-size:.75rem;">
                                                    @b.Accion
                                                </span>
                                            </td>
                                            <td><small class="text-muted">@b.CampoModificado</small></td>
                                            <td><small class="text-danger">@b.ValorAnterior</small></td>
                                            <td><small class="text-success">@b.ValorNuevo</small></td>
                                            <td><small><strong>@b.UsuarioNombre</strong></small></td>
                                            <td><small class="text-muted">@b.Motivo</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary btn-sm" @onclick="CerrarModalBitacora">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool   Cargando              = true;
    bool   Procesando            = false;
    bool   MostrarModalNuevo     = false;
    bool   MostrarModalEditar    = false;
    bool   MostrarModalCerrar    = false;
    bool   MostrarModalEliminar  = false;
    bool   MostrarModalBitacora  = false;
    bool   MostrarBitacoraGlobal = false;
    string MsgExito              = "";
    string MsgError              = "";
    string MsgModalError         = "";
    string MotivoAccion          = "";
    string UsuarioActual         = "SuperAdmin";

    List<MPeriodo>  Periodos        = new();
    List<MBitacora> BitacoraGlobal  = new();
    List<MBitacora> BitacoraPeriodo = new();

    MPeriodo? PeriodoActivo => Periodos.FirstOrDefault(p => p.Estado == "Activo");
    MPeriodo? PeriodoEditar;
    MPeriodo? PeriodoAccion;

    MPeriodo FormPeriodo = new();
    int AnioSel      = DateTime.Now.Year;
    int MesInicioSel = DateTime.Now.Month;
    int DiaInicioSel = 1;
    int MesCierreSel = DateTime.Now.Month;
    int DiaCierreSel = DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month);

    static readonly Dictionary<int, string> Meses = new()
    {
        {1,"Enero"},{2,"Febrero"},{3,"Marzo"},{4,"Abril"},
        {5,"Mayo"},{6,"Junio"},{7,"Julio"},{8,"Agosto"},
        {9,"Septiembre"},{10,"Octubre"},{11,"Noviembre"},{12,"Diciembre"}
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        UsuarioActual = auth.User.Identity?.Name ?? "SuperAdmin";
        await Cargar();
        Cargando = false;
    }

    async Task Cargar()
    {
        Periodos       = await PeriodoSvc.GetTodosAsync();
        BitacoraGlobal = await PeriodoSvc.GetBitacoraGlobalAsync();
    }

    int DiasEnMes(int mes, int anio) => DateTime.DaysInMonth(anio, mes);

    void RecalcularFechas()
    {
        DiaInicioSel = Math.Min(DiaInicioSel, DiasEnMes(MesInicioSel, AnioSel));
        FormPeriodo.FechaInicio = new DateTime(AnioSel, MesInicioSel, DiaInicioSel);

        if (FormPeriodo.Frecuencia == "Personalizado")
        {
            DiaCierreSel = Math.Min(DiaCierreSel, DiasEnMes(MesCierreSel, AnioSel));
            FormPeriodo.FechaCierre = new DateTime(AnioSel, MesCierreSel, DiaCierreSel);
        }
        else
        {
            FormPeriodo.FechaCierre = FormPeriodo.Frecuencia switch
            {
                "Mensual"    => FormPeriodo.FechaInicio.AddMonths(1).AddDays(-1),
                "Bimestral"  => FormPeriodo.FechaInicio.AddMonths(2).AddDays(-1),
                "Trimestral" => FormPeriodo.FechaInicio.AddMonths(3).AddDays(-1),
                "Semestral"  => FormPeriodo.FechaInicio.AddMonths(6).AddDays(-1),
                "Anual"      => FormPeriodo.FechaInicio.AddYears(1).AddDays(-1),
                _            => FormPeriodo.FechaInicio.AddMonths(3).AddDays(-1)
            };
        }

        FormPeriodo.NombrePeriodo = FormPeriodo.Frecuencia switch
        {
            "Mensual"    => $"Periodo Mensual {Meses[MesInicioSel]} {AnioSel}",
            "Bimestral"  => $"Periodo Bimestral {Meses[MesInicioSel]}-{Meses[Math.Min(MesInicioSel+1,12)]} {AnioSel}",
            "Trimestral" => $"Periodo Trimestral Q{((MesInicioSel-1)/3)+1} {AnioSel}",
            "Semestral"  => $"Periodo Semestral {(MesInicioSel<=6?"I":"II")} {AnioSel}",
            "Anual"      => $"Periodo Anual {AnioSel}",
            _            => $"Periodo Personalizado {AnioSel}"
        };
        if (FormPeriodo.Tipo == "Extraordinario")
            FormPeriodo.NombrePeriodo = "Ext. — " + FormPeriodo.NombrePeriodo;
    }

    void OnTipoChange(ChangeEventArgs e)      { FormPeriodo.Tipo      = e.Value?.ToString() ?? "Ordinario";  RecalcularFechas(); }
    void OnFrecuenciaChange(ChangeEventArgs e){ FormPeriodo.Frecuencia = e.Value?.ToString() ?? "Trimestral"; RecalcularFechas(); }
    void OnAnioChange(ChangeEventArgs e)      { if (int.TryParse(e.Value?.ToString(), out var y)) AnioSel=y;    RecalcularFechas(); }
    void OnMesInicioChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var m)) MesInicioSel=m; RecalcularFechas(); }
    void OnDiaInicioChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var d)) DiaInicioSel=d; RecalcularFechas(); }
    void OnMesCierreChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var m)) MesCierreSel=m; RecalcularFechas(); }
    void OnDiaCierreChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var d)) DiaCierreSel=d; RecalcularFechas(); }

    void AbrirModalNuevo()
    {
        MsgModalError = "";
        AnioSel=DateTime.Now.Year; MesInicioSel=DateTime.Now.Month; DiaInicioSel=1;
        MesCierreSel=Math.Min(DateTime.Now.Month+2,12);
        DiaCierreSel=DiasEnMes(MesCierreSel, AnioSel);
        FormPeriodo = new MPeriodo { Tipo="Ordinario", Frecuencia="Trimestral" };
        RecalcularFechas();
        MostrarModalNuevo = true;
    }
    void CerrarModalNuevo() { MostrarModalNuevo=false; MsgModalError=""; }

    async Task GuardarNuevo()
    {
        MsgModalError = "";
        if (string.IsNullOrWhiteSpace(FormPeriodo.NombrePeriodo)) { MsgModalError="El nombre es obligatorio."; return; }
        if (FormPeriodo.FechaCierre <= FormPeriodo.FechaInicio)   { MsgModalError="La fecha de cierre debe ser posterior al inicio."; return; }
        Procesando = true;
        try
        {
            await PeriodoSvc.CrearAsync(FormPeriodo, UsuarioActual);
            await Cargar();
            MostrarModalNuevo = false;
            MsgExito = $"Periodo '{FormPeriodo.NombrePeriodo}' aperturado correctamente.";
        }
        catch (Exception ex) { MsgModalError = ex.Message; }
        finally { Procesando = false; }
    }

    void AbrirModalEditar(MPeriodo p)
    {
        PeriodoEditar = p; MsgModalError = ""; MotivoAccion = "";
        AnioSel=p.FechaInicio.Year; MesInicioSel=p.FechaInicio.Month; DiaInicioSel=p.FechaInicio.Day;
        MesCierreSel=p.FechaCierre.Month; DiaCierreSel=p.FechaCierre.Day;
        FormPeriodo = new MPeriodo
        {
            Id=p.Id, NombrePeriodo=p.NombrePeriodo, Tipo=p.Tipo,
            Frecuencia=p.Frecuencia, FechaInicio=p.FechaInicio,
            FechaCierre=p.FechaCierre, Descripcion=p.Descripcion
        };
        MostrarModalEditar = true;
    }
    void CerrarModalEditar() { MostrarModalEditar=false; PeriodoEditar=null; MsgModalError=""; }

    async Task GuardarEdicion()
    {
        MsgModalError = "";
        if (string.IsNullOrWhiteSpace(FormPeriodo.NombrePeriodo)) { MsgModalError="El nombre es obligatorio."; return; }
        if (FormPeriodo.FechaCierre <= FormPeriodo.FechaInicio)   { MsgModalError="La fecha de cierre debe ser posterior al inicio."; return; }
        Procesando = true;
        try
        {
            await PeriodoSvc.EditarAsync(FormPeriodo, UsuarioActual, MotivoAccion);
            await Cargar();
            MostrarModalEditar = false;
            MsgExito = $"Periodo '{FormPeriodo.NombrePeriodo}' editado y registrado en bitacora.";
        }
        catch (Exception ex) { MsgModalError = ex.Message; }
        finally { Procesando = false; }
    }

    void AbrirModalCerrar(MPeriodo p)  { PeriodoAccion=p; MotivoAccion=""; MostrarModalCerrar=true; }
    void CerrarModalCerrar() { MostrarModalCerrar=false; PeriodoAccion=null; }

    async Task ConfirmarCierre()
    {
        if (PeriodoAccion==null) return;
        Procesando=true;
        try
        {
            await PeriodoSvc.CerrarAsync(PeriodoAccion.Id, UsuarioActual, MotivoAccion);
            await Cargar();
            MostrarModalCerrar=false;
            MsgExito=$"Periodo '{PeriodoAccion.NombrePeriodo}' cerrado y registrado en bitacora.";
            PeriodoAccion=null;
        }
        catch (Exception ex) { MsgError=ex.Message; }
        finally { Procesando=false; }
    }

    void AbrirModalEliminar(MPeriodo p) { PeriodoAccion=p; MotivoAccion=""; MostrarModalEliminar=true; }
    void CerrarModalEliminar() { MostrarModalEliminar=false; PeriodoAccion=null; }

    async Task ConfirmarEliminar()
    {
        if (PeriodoAccion==null) return;
        Procesando=true;
        try
        {
            await PeriodoSvc.EliminarAsync(PeriodoAccion.Id, UsuarioActual, MotivoAccion);
            await Cargar();
            MostrarModalEliminar=false;
            MsgExito="Periodo marcado como eliminado. Registro conservado en bitacora historica.";
            PeriodoAccion=null;
        }
        catch (Exception ex) { MsgError=ex.Message; }
        finally { Procesando=false; }
    }

    async Task AbrirModalBitacora(MPeriodo p)
    {
        PeriodoAccion        = p;
        BitacoraPeriodo      = await PeriodoSvc.GetBitacoraAsync(p.Id);
        MostrarModalBitacora = true;
    }
    void CerrarModalBitacora() { MostrarModalBitacora=false; PeriodoAccion=null; }
}
